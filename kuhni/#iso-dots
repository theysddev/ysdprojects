<style>
:root{
--g900:#24211F;--g800:#2B2826;--g700:#35312E;--g650:#3C3734;--g600:#4A4541;
--stone:#E3DFD8;--stone2:#ECE9E3;--paper:#F3F2EE;--line:#CBC5BC;
--ink:#2B2826;--ink2:#5A544E;--fog:#EEEAE4;--fog2:#B4ABA0;
--brass:#C29E64;--brass-hi:#D4B47F;--bronze:#7A5A2D;--oak:#B98B5E;
--ease:cubic-bezier(.23,1,.32,1);--ease-io:cubic-bezier(.65,0,.35,1);
--wrap:1320px;--gut:clamp(16px,4vw,48px);--hh:72px;
--ff-d:'Jost','Golos Text',system-ui,sans-serif;--ff:'Golos Text',system-ui,-apple-system,'Segoe UI',sans-serif;
--bleed:max(var(--gut),calc((100vw - var(--wrap))/2));
}
*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:calc(var(--hh) + 8px)}
body{margin:0;background:var(--stone);color:var(--ink);font:400 17px/1.6 var(--ff);overflow-x:clip;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%;height:auto}
svg{flex-shrink:0}
a{color:inherit}
button,input{font:inherit;color:inherit;letter-spacing:inherit}
button{cursor:pointer}
h1,h2,h3{font-family:var(--ff-d);font-weight:400;margin:0;letter-spacing:-.02em;line-height:1.04;text-wrap:balance}
h2{font-size:clamp(32px,4.1vw,58px)}
h3{font-size:clamp(20px,1.7vw,24px);font-weight:500;line-height:1.2;letter-spacing:-.01em}
p{margin:0}
.wrap{width:min(var(--wrap),100% - 2*var(--gut));margin-inline:auto}
.sr{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;border:0}
:focus-visible{outline:2px solid var(--brass);outline-offset:3px}
.ic{width:20px;height:20px}
use{fill:none;stroke:currentColor;stroke-width:var(--sw,1.6);stroke-linecap:round;stroke-linejoin:round}
.skip{position:absolute;left:16px;top:-60px;z-index:100;background:var(--brass);color:var(--g800);padding:10px 16px;border-radius:3px;text-decoration:none}
.skip:focus{top:12px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 26px;border:0;border-radius:3px;background:var(--brass);color:var(--g800);font:500 16px/1.1 var(--ff);text-decoration:none;text-align:center;transition:transform .16s var(--ease)}
.btn:active{transform:scale(.97)}
.btn--lg{min-height:58px;padding:0 32px;font-size:17px}
.btn--sm{min-height:44px;padding:0 18px;font-size:15px}
.btn--ghost{background:transparent;color:var(--fog);box-shadow:inset 0 0 0 1px var(--g600)}
.hdr{position:sticky;top:0;z-index:50;background:var(--g800);color:var(--fog);border-bottom:1px solid transparent}
.hdr.is-scrolled{border-bottom-color:var(--g600)}
.hdr-in{display:flex;align-items:center;gap:clamp(12px,2vw,28px);height:var(--hh)}
.logo{display:inline-flex;align-items:center;gap:12px;min-height:44px;color:var(--fog);text-decoration:none;font:500 19px/1 var(--ff-d);letter-spacing:.22em}
.logo svg{width:28px;height:30px}
.nav{display:flex;gap:2px;margin-left:auto}
.nav a{display:inline-flex;align-items:center;min-height:44px;padding:0 12px;color:var(--fog);text-decoration:none;font-size:15px}
.hdr-tel{display:inline-flex;align-items:center;gap:8px;min-height:44px;color:var(--fog);text-decoration:none;font-weight:500;font-size:16px;white-space:nowrap;font-variant-numeric:tabular-nums}
.hdr-tel .ic{color:var(--brass-hi)}
.burger{display:none;width:44px;height:44px;border:0;background:transparent;color:var(--fog);padding:0;place-items:center;border-radius:3px}
.burger i{display:block;width:22px;height:1.6px;background:currentColor;position:relative;transition:transform .25s var(--ease)}
.burger i::before,.burger i::after{content:'';position:absolute;left:0;width:22px;height:1.6px;background:currentColor;transition:transform .25s var(--ease)}
.burger i::before{transform:translateY(-7px)}.burger i::after{transform:translateY(7px)}
.menu-open .burger i{transform:rotate(45deg)}
.menu-open .burger i::before{transform:rotate(0)}
.menu-open .burger i::after{transform:rotate(-90deg)}
@media (max-width:1120px){
.burger{display:grid}
.nav{position:absolute;left:0;right:0;top:var(--hh);flex-direction:column;gap:0;padding:8px var(--gut) 20px;background:var(--g800);border-bottom:1px solid var(--g600);opacity:0;transform:translateY(-8px);pointer-events:none;visibility:hidden;transition:opacity .2s var(--ease),transform .25s var(--ease),visibility 0s .25s}
.nav a{font-size:18px;min-height:52px;border-bottom:1px solid var(--g700);padding:0}
.menu-open .nav{opacity:1;transform:none;pointer-events:auto;visibility:visible;transition:opacity .2s var(--ease),transform .25s var(--ease)}
.hdr-tel{margin-left:auto}
}
@media (max-width:640px){
:root{--hh:60px}
.hdr-cta{display:none}
.hdr-tel span{display:none}
.hdr-tel{width:44px;justify-content:center;border-radius:3px;box-shadow:inset 0 0 0 1px var(--g600)}
}
.hero{background:var(--g800);color:var(--fog);overflow:hidden}
.hero-grid{display:grid;grid-template-columns:minmax(0,1.32fr) minmax(0,1fr);grid-template-rows:1fr auto;grid-template-areas:"txt ph" "peek ph";column-gap:clamp(32px,5vw,80px);min-height:min(900px,calc(100svh - var(--hh)))}
.hero-txt{grid-area:txt;align-self:end;padding-top:clamp(32px,6vh,72px)}
.hero h1{font-size:clamp(38px,5.3vw,78px);line-height:1.02;letter-spacing:-.025em;max-width:12.5em}
.hdim{position:relative;height:22px;margin:22px 0 22px;max-width:600px;color:var(--brass-hi)}
.hdim-l{position:absolute;left:0;right:0;top:50%;height:1px;background:currentColor;transform-origin:0 50%;animation:drawX 1.1s .2s var(--ease) both}
.hdim::before,.hdim::after{content:'';position:absolute;top:4px;width:1px;height:14px;background:currentColor;transform:rotate(45deg);animation:fadeIn .4s .2s both}
.hdim::before{left:0}.hdim::after{right:0;animation-delay:1s}
.hdim-t{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:var(--g800);padding:0 12px;font:400 14px/1 var(--ff-d);letter-spacing:.02em;white-space:nowrap;animation:fadeIn .5s .7s both}
.lead{font-size:clamp(17px,1.35vw,19px);line-height:1.55;color:var(--fog2);max-width:36em}
.lead b{color:var(--fog);font-weight:500}
.hero-act{display:flex;flex-wrap:wrap;align-items:center;gap:14px 24px;margin-top:28px}
.hero-note{font-size:15px;color:var(--fog2);max-width:22em;line-height:1.45}
.peek{grid-area:peek;align-self:start;margin:clamp(24px,4vh,40px) 0 clamp(32px,6vh,64px);background:var(--stone);color:var(--ink);border-radius:6px;padding:16px;max-width:720px;animation:rise .7s .35s var(--ease) both}
.peek-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;margin:2px 4px 12px}
.peek-head p{font:500 20px/1.2 var(--ff-d);letter-spacing:-.01em}
.peek-head span{font-size:14px;color:var(--ink2)}
.peek-opts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.peek-opts button{display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;gap:10px;min-height:104px;padding:12px 12px 12px 14px;background:var(--paper);border:0;box-shadow:inset 0 0 0 1px var(--line);border-radius:4px;text-align:left;font-size:15px;font-weight:500;line-height:1.25;transition:transform .16s var(--ease)}
.peek-opts button svg{width:44px;height:44px;color:var(--ink)}
.peek-opts button:active{transform:scale(.97)}
.hero-ph{grid-area:ph;margin:0 calc(-1*var(--bleed)) 0 0;position:relative;background:#3A3532;animation:revealUp 1.2s .1s var(--ease) both}
.hero-ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
@keyframes drawX{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
@keyframes revealUp{from{clip-path:inset(100% 0 0 0)}to{clip-path:inset(0 0 0 0)}}
@media (max-width:860px){
.hero-grid{grid-template-columns:minmax(0,1fr);grid-template-rows:auto;grid-template-areas:"txt" "ph" "peek";min-height:0}
.hero-txt{padding-top:28px}
.hdim{margin:16px 0}
.hero-act{margin-top:22px}
.hero-act .btn{flex:1 1 100%}
.hero-ph{margin:28px calc(-1*var(--gut)) 0;height:min(66vw,420px)}
.peek{margin:-64px 0 36px;position:relative;z-index:1;max-width:none}
}
@media (max-width:560px){
.peek{padding:12px}
.peek-head{margin:2px 2px 10px}
.peek-head p{font-size:18px}
.hero-note{display:none}
}
@media (max-width:560px),(min-width:861px) and (max-width:1180px){
.peek-opts{grid-template-columns:repeat(2,minmax(0,1fr))}
.peek-opts button{flex-direction:row;align-items:center;justify-content:flex-start;min-height:64px;padding:8px 10px}
.peek-opts button svg{width:38px;height:38px}
}
.sec{padding:clamp(72px,9vw,136px) 0}
.sec-head{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:20px 64px;align-items:end;margin-bottom:clamp(32px,4vw,56px)}
.sec-head p{color:var(--ink2);max-width:44ch}
.dark{background:var(--g800);color:var(--fog)}
.dark .sec-head p{color:var(--fog2)}
@media (max-width:860px){.sec-head{grid-template-columns:minmax(0,1fr)}}
.quiz{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.12fr);scroll-margin-top:calc(var(--hh) + 12px);border-radius:8px;box-shadow:0 1px 0 rgba(43,40,38,.06),0 30px 60px -40px rgba(43,40,38,.45)}
.q-panel{display:flex;flex-direction:column;background:var(--g800);color:var(--fog);border-radius:8px 0 0 8px;padding:clamp(20px,2.6vw,36px);min-width:0}
.q-prog-row{display:flex;align-items:center;gap:12px;font-size:14px;color:var(--fog2)}
.q-prog-row b{color:var(--fog);font-weight:500}
.q-gift{display:inline-flex;align-items:center;gap:8px;margin-left:auto;color:var(--brass-hi)}
.q-pct{font:500 15px/1 var(--ff-d);color:var(--fog);font-variant-numeric:tabular-nums;min-width:3.2em;text-align:right}
.q-bar{height:3px;background:var(--g600);border-radius:2px;margin-top:12px;overflow:hidden}
.q-bar i{display:block;height:100%;background:var(--brass);transform-origin:0 50%;transform:scaleX(0);transition:transform .6s var(--ease-io)}
.q-resume{margin-top:16px;font-size:14px;color:var(--fog2);display:flex;flex-wrap:wrap;align-items:center;gap:0 6px}
.q-link{background:none;border:0;padding:0 2px;min-height:44px;color:var(--brass-hi);text-decoration:underline;text-underline-offset:3px;font-size:14px}
.q-form{display:flex;flex-direction:column;flex:1;margin-top:clamp(22px,3vw,34px)}
.q-step{border:0;margin:0;padding:0;min-width:0}
.q-step legend{padding:0;display:block;width:100%}
.q-h{font-size:clamp(26px,2.5vw,36px);font-weight:400;letter-spacing:-.02em;line-height:1.1;outline:none}
.q-hint{color:var(--fog2);font-size:15px;line-height:1.5;margin:10px 0 22px;max-width:40ch}
.js .q-step{display:none}
.js .q-step.is-active{display:block;animation:qIn .34s var(--ease) both}
.js .q-step.is-active.from-back{animation-name:qInB}
@keyframes qIn{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:none}}
@keyframes qInB{from{opacity:0;transform:translateX(-20px)}to{opacity:1;transform:none}}
.q-nav{display:flex;align-items:center;gap:12px;margin-top:auto;padding-top:28px}
.q-nav #qNext{margin-left:auto;min-width:160px}
.q-nav #qNext.is-wait{background:var(--g650);color:var(--fog2)}
.q-msg{font-size:14px;color:var(--brass-hi);line-height:1.35}
.q-nav .btn--ghost{padding:0 20px}
.opts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.opt{position:relative;display:block;cursor:pointer;-webkit-tap-highlight-color:transparent}
.opt input{position:absolute;opacity:0;width:1px;height:1px;margin:0;pointer-events:none}
.opt-b{position:relative;display:flex;align-items:center;gap:14px;height:100%;min-height:76px;padding:14px 40px 14px 14px;border-radius:6px;background:var(--g700);box-shadow:inset 0 0 0 1px var(--g600);transition:transform .16s var(--ease)}
.opt:active .opt-b{transform:scale(.98)}
.opt input:checked+.opt-b{background:var(--g650);box-shadow:inset 0 0 0 2px var(--brass)}
.opt input:focus-visible+.opt-b{outline:2px solid var(--brass-hi);outline-offset:3px}
.opt-chk{position:absolute;top:12px;right:12px;width:20px;height:20px;border-radius:50%;box-shadow:inset 0 0 0 1.5px var(--g600);display:grid;place-items:center}
.opt-chk::after{content:'';width:9px;height:4.5px;border:solid var(--g800);border-width:0 0 2.2px 2.2px;opacity:0;transform:translateY(-1px) rotate(-45deg) scale(.6);transition:opacity .15s ease,transform .2s var(--ease)}
.opt input[type=checkbox]~.opt-b .opt-chk{border-radius:4px}
.opt input:checked+.opt-b .opt-chk{background:var(--brass);box-shadow:none}
.opt input:checked+.opt-b .opt-chk::after{opacity:1;transform:translateY(-1px) rotate(-45deg)}
.opt-txt{display:flex;flex-direction:column;gap:3px;min-width:0}
.opt-t{font-weight:500;font-size:16px;line-height:1.25}
.opt-d{font-size:14px;color:var(--fog2);line-height:1.35}
.opt-p{font-size:14px;color:var(--brass-hi);line-height:1.3;font-variant-numeric:tabular-nums}
.opt-ic{width:30px;height:30px;color:var(--brass-hi)}
.opts--lay .opt-b{flex-direction:column;align-items:flex-start;gap:12px;min-height:132px;padding:16px}
.opts--lay .opt-ic{width:52px;height:52px;color:var(--fog)}
.opts--lay input:checked+.opt-b .opt-ic{color:var(--brass-hi)}
.chip{width:42px;height:42px;border-radius:4px;flex:none;box-shadow:inset 0 0 0 1px rgba(255,255,255,.12)}
.chip--enamel{background:linear-gradient(160deg,#B6BEA9,#9DA690)}
.chip--veneer{background:repeating-linear-gradient(92deg,rgba(80,50,20,.0) 0 3px,rgba(80,50,20,.22) 3px 4px,rgba(80,50,20,0) 4px 9px),linear-gradient(#C99D6C,#B78B5A)}
.chip--agt{background:linear-gradient(135deg,rgba(255,255,255,0) 40%,rgba(255,255,255,.35) 50%,rgba(255,255,255,0) 60%),#4A4846}
.chip--ldsp{background:repeating-linear-gradient(90deg,rgba(60,40,20,.12) 0 1px,transparent 1px 4px),#BFA684}
.chip--ct-ldsp{background:repeating-linear-gradient(0deg,rgba(0,0,0,.1) 0 1px,transparent 1px 5px),#A08A6E}
.chip--ct-quartz{background:radial-gradient(circle at 30% 30%,#9C948A 0 1px,transparent 1.5px) 0 0/9px 9px,radial-gradient(circle at 70% 60%,#B5AEA4 0 1px,transparent 1.5px) 0 0/7px 7px,#ECE8E2}
.chip--ct-ceramic{background:linear-gradient(115deg,transparent 30%,rgba(120,112,104,.5) 31%,transparent 33%),linear-gradient(60deg,transparent 60%,rgba(140,132,124,.4) 61%,transparent 62.5%),#DEDAD4}
.chip--ct-wood{background:repeating-linear-gradient(0deg,rgba(90,55,25,.25) 0 1px,transparent 1px 6px),#B07E4C}
.dims{display:grid;gap:22px}
.dim-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
.dim-top label{font-size:15px;color:var(--fog2)}
.dim-v{font:400 32px/1 var(--ff-d);font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.dim-ctl{display:flex;align-items:center;gap:10px;margin-top:6px}
.pm{flex:none;width:44px;height:44px;border-radius:50%;border:0;background:var(--g700);box-shadow:inset 0 0 0 1px var(--g600);display:grid;place-items:center;color:var(--fog);transition:transform .14s var(--ease)}
.pm:active{transform:scale(.92)}
.pm svg{width:18px;height:18px;--sw:1.8}
.rng{--p:20%;flex:1;min-width:0;-webkit-appearance:none;appearance:none;height:44px;background:transparent;margin:0;cursor:pointer}
.rng::-webkit-slider-runnable-track{height:4px;border-radius:2px;background:linear-gradient(to right,var(--brass) var(--p),var(--g600) var(--p))}
.rng::-webkit-slider-thumb{-webkit-appearance:none;width:26px;height:26px;margin-top:-11px;border-radius:50%;background:var(--fog);box-shadow:0 0 0 5px var(--brass) inset,0 2px 8px rgba(0,0,0,.35)}
.rng::-moz-range-track{height:4px;border-radius:2px;background:var(--g600)}
.rng::-moz-range-progress{height:4px;border-radius:2px;background:var(--brass)}
.rng::-moz-range-thumb{width:26px;height:26px;border:0;border-radius:50%;background:var(--fog);box-shadow:0 0 0 5px var(--brass) inset}
.rng:focus-visible{outline:none}
.rng:focus-visible::-webkit-slider-thumb{outline:2px solid var(--brass-hi);outline-offset:3px}
.rng:focus-visible::-moz-range-thumb{outline:2px solid var(--brass-hi);outline-offset:3px}
.dim-lim{display:flex;justify-content:space-between;font-size:13px;color:var(--fog2);padding:0 54px}
.dims-sum{margin-top:22px;padding-top:16px;border-top:1px solid var(--g600);font-size:15px;color:var(--fog2)}
.dims-sum b{color:var(--fog);font-weight:500}
.col-row{margin-top:22px;padding-top:18px;border-top:1px solid var(--g600)}
.col-row legend,.sub-l{font-size:15px;color:var(--fog2);padding:0;margin-bottom:10px}
.col-row legend b{color:var(--fog);font-weight:500}
.sw-set{border:0;margin:0;padding:0;min-width:0}
.sw{display:flex;flex-wrap:wrap;gap:4px}
.sw-i{position:relative;width:46px;height:46px;display:grid;place-items:center;cursor:pointer}
.sw-i input{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}
.sw-i span:first-of-type{width:36px;height:36px;border-radius:50%;background:var(--c,#ccc);box-shadow:inset 0 0 0 1px rgba(255,255,255,.22);transition:transform .16s var(--ease)}
.sw-i input:checked+span{box-shadow:0 0 0 3px var(--g800),0 0 0 5px var(--brass);transform:scale(.92)}
.sw-i input:focus-visible+span{outline:2px solid var(--brass-hi);outline-offset:6px}
.sw[data-m=veneer] .sw-i span:first-of-type{background:repeating-linear-gradient(95deg,rgba(60,35,15,.0) 0 3px,rgba(60,35,15,.22) 3px 4px,rgba(60,35,15,0) 4px 8px),var(--c)}
.sw[data-m=ldsp] .sw-i span:first-of-type{background:repeating-linear-gradient(90deg,rgba(40,25,10,.12) 0 1px,transparent 1px 4px),var(--c)}
