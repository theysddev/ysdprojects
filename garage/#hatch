/* form */
(function(){
var form=$('#leadForm'),phone=$('#fPhone'),name=$('#fName'),ok=$('#ok'),fm=$('#form');
function mask(v){
  var d=v.replace(/\D/g,'');
  if(!d)return '';
  if(d[0]==='8')d='7'+d.slice(1);else if(d[0]==='9')d='7'+d;else if(d[0]!=='7')d='7'+d;
  d=d.slice(0,11);
  var r='+7';
  if(d.length>1)r+=' ('+d.slice(1,4);
  if(d.length>=4)r+=')';
  if(d.length>4)r+=' '+d.slice(4,7);
  if(d.length>7)r+='-'+d.slice(7,9);
  if(d.length>9)r+='-'+d.slice(9,11);
  return r;
}
phone.addEventListener('input',function(){var m=mask(phone.value);phone.value=m});
var slotG=$('#slots'),slot='',WD=['вс','пн','вт','ср','чт','пт','сб'],MO=['янв','фев','мар','апр','мая','июн','июл','авг','сен','окт','ноя','дек'];
(function(){var d=new Date(),h='';for(var i=1;i<=6;i++){var x=new Date(d.getFullYear(),d.getMonth(),d.getDate()+i),full=x.toLocaleDateString('ru-RU',{weekday:'long',day:'numeric',month:'long'});h+='<button class="chm" type="button" aria-pressed="false" data-d="'+full+'" aria-label="'+full+(x.getDay()===0?', с 10:00 до 18:00':', с 8:00 до 20:00')+'"><span>'+WD[x.getDay()]+'</span><b>'+x.getDate()+'</b><span>'+MO[x.getMonth()]+'</span></button>'}slotG.innerHTML=h})();
slotG.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;var on=b.getAttribute('aria-pressed')!=='true';$$('button',slotG).forEach(function(x){x.setAttribute('aria-pressed','false')});b.setAttribute('aria-pressed',String(on));slot=on?b.dataset.d:''});
phone.addEventListener('keydown',function(e){if(e.key==='Backspace'&&/[^\d]$/.test(phone.value)){e.preventDefault();var d=phone.value.replace(/\D/g,'');phone.value=mask(d.slice(0,-1))}});
form.addEventListener('submit',function(e){
  e.preventDefault();
  var okPhone=phone.value.replace(/\D/g,'').length===11,okName=name.value.trim().length>1;
  fm.classList.toggle('invalid',!(okPhone&&okName));
  if(!okPhone){phone.focus();return}
  if(!okName){name.focus();return}
  $('#okPhone').textContent=phone.value;$('#okSlot').textContent=slot?' и подтвердим время на '+slot:'';
  ok.classList.add('show');form.setAttribute('aria-hidden','true');
  setTimeout(function(){$('#okAgain').focus()},RM?0:400);
});
$('#okAgain').addEventListener('click',function(){ok.classList.remove('show');form.removeAttribute('aria-hidden');form.reset();slot='';$$('button',slotG).forEach(function(x){x.setAttribute('aria-pressed','false')});fm.classList.remove('invalid');name.focus()});
})();
})();
</script>
