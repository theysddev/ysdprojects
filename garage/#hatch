<style>
:root{
  --ink:#101214;--ink2:#1A1D21;--ink3:#24282E;--light:#F2F3F1;--white:#FFFFFF;
  --acc:#FF6A1A;--acc2:#FF8A4C;--steel:#8A94A6;--steel-d:#56606F;--line:#DFE2DE;--line-dk:rgba(255,255,255,.1);
  --ease:cubic-bezier(.23,1,.32,1);
  --ch:10px;
  --wrap:1240px;--gut:clamp(16px,4vw,40px);
  --hdr:72px;
  --fs-h1:clamp(1.85rem,1.05rem + 3.4vw,3.7rem);
  --fs-h2:clamp(1.45rem,1rem + 2.1vw,2.5rem);
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--hdr) + 12px);-webkit-text-size-adjust:100%}
body{margin:0;background:var(--light);color:var(--ink);font:400 17px/1.6 Onest,system-ui,sans-serif;overflow-x:clip}
img{display:block;max-width:100%;height:auto}
h1,h2,h3,h4{font-family:Unbounded,Onest,sans-serif;font-weight:700;line-height:1.08;margin:0;letter-spacing:-.01em}
h1{font-size:var(--fs-h1);font-weight:900;letter-spacing:-.02em;line-height:1.02}
h2{font-size:var(--fs-h2);text-transform:uppercase}
h3{font-size:1.05rem}
p{margin:0}
ul{margin:0;padding:0;list-style:none}
a{color:inherit}
button{font:inherit;color:inherit;cursor:pointer;background:none;border:0;padding:0}
button,input,select,textarea{font-family:inherit}
:focus-visible{outline:3px solid var(--acc);outline-offset:3px}
.btn:focus-visible,.plate:focus-visible,.hot:focus-visible,.cls:focus-visible{outline:none;box-shadow:inset 0 0 0 3px var(--ink),inset 0 0 0 5px var(--acc)}
.wrap{width:100%;max-width:var(--wrap);margin:0 auto;padding-left:var(--gut);padding-right:var(--gut)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* chamfer */
.chm{clip-path:polygon(var(--ch) 0,100% 0,100% calc(100% - var(--ch)),calc(100% - var(--ch)) 100%,0 100%,0 var(--ch))}

/* buttons */
.btn{--ch:9px;display:inline-flex;align-items:center;justify-content:center;gap:.55rem;min-height:52px;padding:.8rem 1.5rem;font:600 1rem/1.15 Onest,sans-serif;text-decoration:none;border:0;clip-path:polygon(var(--ch) 0,100% 0,100% calc(100% - var(--ch)),calc(100% - var(--ch)) 100%,0 100%,0 var(--ch));transition:transform .18s var(--ease),background-color .18s ease;text-align:center}
.btn:active{transform:scale(.97)}
.btn--p{background:var(--acc);color:var(--ink)}
.btn--g{background:transparent;color:var(--light);box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.35)}
.btn--d{background:var(--ink);color:var(--light)}
.btn--w{background:var(--white);color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--line)}
.btn--sm{min-height:44px;padding:.55rem 1.1rem;font-size:.92rem}
.btn svg{width:18px;height:18px;flex:none}
@media (hover:hover) and (pointer:fine){
  .btn:hover{transform:translateY(-2px)}
  .btn--p:hover{background:var(--acc2)}
  .btn--g:hover{box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.8)}
  .btn--w:hover{box-shadow:inset 0 0 0 1.5px var(--ink)}
}

/* nameplate */
.plate{--ch:6px;position:relative;display:inline-flex;align-items:center;gap:.5rem;padding:.42rem .9rem .42rem 1rem;font:600 .78rem/1.1 Unbounded,sans-serif;letter-spacing:.04em;text-transform:uppercase;background:var(--ink2);color:var(--light);box-shadow:inset 0 0 0 1px rgba(255,255,255,.14);clip-path:polygon(var(--ch) 0,100% 0,100% calc(100% - var(--ch)),calc(100% - var(--ch)) 100%,0 100%,0 var(--ch))}
.plate::before,.plate::after{content:"";position:absolute;width:4px;height:4px;border-radius:50%;background:var(--steel);opacity:.8}
.plate::before{left:5px;bottom:5px}.plate::after{right:5px;top:5px}
.plate--acc{background:var(--acc);color:var(--ink);box-shadow:inset 0 0 0 1px rgba(16,18,20,.25)}
.plate--acc::before,.plate--acc::after{background:var(--ink);opacity:.55}
.plate--light{background:var(--white);color:var(--ink);box-shadow:inset 0 0 0 1px var(--line)}
.plate--light::before,.plate--light::after{background:var(--steel)}
.plate--steel{background:var(--steel);color:var(--ink)}
.plate--steel::before,.plate--steel::after{background:var(--ink);opacity:.5}
.plate b{font-weight:900}

/* sections */
.sec{position:relative;padding:clamp(64px,8vw,112px) 0}
.sec--dk{background:var(--ink);color:var(--light)}
.cut-b{clip-path:polygon(0 0,100% 0,100% calc(100% - 4vw),0 100%);padding-bottom:calc(clamp(64px,8vw,112px) + 4vw)}
.cut-t{clip-path:polygon(0 4vw,100% 0,100% 100%,0 100%);padding-top:calc(clamp(64px,8vw,112px) + 4vw)}
.cut-tb{clip-path:polygon(0 4vw,100% 0,100% calc(100% - 4vw),0 100%);padding-top:calc(clamp(64px,8vw,112px) + 4vw);padding-bottom:calc(clamp(64px,8vw,112px) + 4vw)}
.gridbg::before{content:"";position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(to right,rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(to bottom,rgba(255,255,255,.05) 1px,transparent 1px);background-size:96px 96px;-webkit-mask-image:radial-gradient(ellipse 80% 70% at 50% 20%,#000 20%,transparent 90%);mask-image:radial-gradient(ellipse 80% 70% at 50% 20%,#000 20%,transparent 90%)}
.gridbg--lt::before{background-image:linear-gradient(to right,rgba(16,18,20,.06) 1px,transparent 1px),linear-gradient(to bottom,rgba(16,18,20,.06) 1px,transparent 1px)}
.sec > .wrap{position:relative}
.hero__grid>*,.dz>*,.calc>*,.calc__ctl>*,.st>*,.ct>*,.why>*,.svc>*,.gal>*{min-width:0}
.head{display:grid;gap:1rem 3rem;align-items:end;margin-bottom:clamp(32px,4.5vw,56px)}
.head .plate{margin-bottom:1rem}
.head__lede{max-width:46ch;color:var(--steel-d);font-size:1.02rem}
.sec--dk .head__lede{color:var(--steel)}
@media (min-width:860px){.head{grid-template-columns:1fr auto}.head__lede{padding-bottom:.35rem}}

/* header */
.hdr{position:fixed;inset:0 0 auto 0;z-index:50;height:var(--hdr);color:var(--light)}
.hdr::before{content:"";position:absolute;inset:0;z-index:-1;background:rgba(16,18,20,.72);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:0 1px 0 rgba(255,255,255,.08);opacity:0;transition:opacity .3s ease}
.hdr.is-sc::before,.nav-open .hdr::before{opacity:1}
.hdr__in{display:flex;align-items:center;gap:1.5rem;height:100%}
.logo{display:inline-flex;text-decoration:none;flex:none}
.logo .plate{font-size:.9rem;padding:.5rem 1rem .5rem 1.1rem;gap:.45rem}
.logo .plate b{color:var(--acc);font-size:1.05rem}
.nav{display:flex;gap:1.4rem;margin-left:auto}
.nav a{text-decoration:none;font-weight:500;font-size:.93rem;color:var(--light);opacity:.85;padding:.5rem 0;transition:opacity .15s ease;white-space:nowrap}
.nav__extra{display:none}
.hdr__tel{text-decoration:none;font-weight:600;white-space:nowrap;font-size:.98rem;padding:.5rem 0}
.burger{display:none;width:48px;height:48px;position:relative;flex:none;margin-left:auto}
.burger span,.burger span::before,.burger span::after{content:"";position:absolute;left:12px;width:24px;height:2px;background:var(--light);transition:transform .25s var(--ease),opacity .2s ease}
.burger span{top:23px}
.burger span::before{left:0;top:-7px}.burger span::after{left:0;top:7px}
.nav-open .burger span{background:transparent}
.nav-open .burger span::before{transform:translateY(7px) rotate(45deg)}
.nav-open .burger span::after{transform:translateY(-7px) rotate(-45deg)}
.hdr .btn{white-space:nowrap;flex:none}
@media (hover:hover) and (pointer:fine){.nav a:hover{opacity:1}}
@media (max-width:1099px){
  .hdr__tel{display:none}
  .hdr .btn{display:none}
  .burger{display:block}
  .nav{position:fixed;top:var(--hdr);left:0;right:0;bottom:0;background:var(--ink);flex-direction:column;gap:0;padding:1rem var(--gut) 2rem;margin:0;transform:translateX(100%);opacity:0;transition:transform .35s var(--ease),opacity .3s ease;overflow:auto;visibility:hidden}
  .nav-open .nav{transform:none;opacity:1;visibility:visible}
  .nav a{font:700 1.4rem/1.2 Unbounded,sans-serif;text-transform:uppercase;padding:1rem 0;border-bottom:1px solid var(--line-dk);opacity:1}
  .nav__extra{display:flex;flex-direction:column;gap:1rem;padding-top:1.5rem}
  .nav__extra a{font:600 1.1rem/1.2 Onest,sans-serif;text-transform:none;border:0;padding:0}
  .nav__extra .btn{display:inline-flex;align-self:flex-start;font:600 1rem Onest,sans-serif}
  body.nav-open{overflow:hidden}
}
@media (min-width:1100px) and (max-width:1280px){
  .hdr__tel{display:none}
  .hdr__in{gap:1.1rem}
  .nav{gap:1.05rem}
  .nav a{font-size:.88rem}
}

/* hero */
.hero{padding-top:calc(var(--hdr) + clamp(40px,6vw,80px));overflow:hidden}
.hero__big{position:absolute;right:-2vw;bottom:-2vw;font:900 clamp(9rem,24vw,22rem)/1 Unbounded,sans-serif;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.1);pointer-events:none;user-select:none;letter-spacing:-.04em}
.hero__grid{display:grid;gap:2.5rem 3rem;position:relative}
.hero__top{grid-column:1/-1}
.hero__top .plate{margin-bottom:1.6rem}
@media (max-width:600px){.br{display:none}}
.h1s{display:inline-block;animation:h1in 1s var(--ease) both}
.h1s:nth-of-type(2){animation-delay:.2s}.h1s:nth-of-type(3){animation-delay:.4s}
@keyframes h1in{from{opacity:0;transform:translateY(.4em)}}
.hero__sub{font-size:1.1rem;max-width:52ch;color:var(--steel);margin:1.3rem 0 2rem}
.hero__sub strong{color:var(--light);font-weight:600}
.hero__cta{display:flex;flex-wrap:wrap;gap:.8rem}
.facts{display:grid;gap:1.1rem}
.fact{border-top:1px solid var(--line-dk);padding-top:1rem;display:grid;grid-template-columns:36px 1fr;gap:.9rem;align-items:start;align-content:start}
.fact svg{width:36px;height:36px;color:var(--acc)}
.fact b{display:block;font:600 1rem/1.3 Onest,sans-serif;margin-bottom:.2rem}
.fact span{font-size:.9rem;color:var(--steel);line-height:1.45}
.hero__media{position:relative;align-self:start}
.hero__media::before{content:"";position:absolute;inset:14px -14px -14px 14px;box-shadow:inset 0 0 0 1px rgba(255,106,26,.5);clip-path:polygon(0 0,calc(100% - 40px) 0,100% 40px,100% 100%,40px 100%,0 calc(100% - 40px));pointer-events:none}
.hero__img{clip-path:polygon(0 0,calc(100% - 40px) 0,100% 40px,100% 100%,40px 100%,0 calc(100% - 40px));width:100%;aspect-ratio:4/3;object-fit:cover;background:var(--ink2)}
.tag{position:absolute;display:grid;gap:.15rem;padding:.8rem 1rem;background:var(--light);color:var(--ink);box-shadow:0 20px 40px -20px rgba(0,0,0,.6);will-change:transform;--ch:8px}
.tag small{font:600 .72rem/1 Unbounded,sans-serif;text-transform:uppercase;letter-spacing:.05em;color:var(--steel-d)}
.tag b{font:900 1.05rem/1.1 Unbounded,sans-serif}
.tag--1{left:-6%;top:12%;animation:float 6s ease-in-out infinite}
.tag--2{right:-4%;bottom:14%;animation:float 7s ease-in-out -2.5s infinite;background:var(--acc)}
.tag--2 small{color:rgba(16,18,20,.7)}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
@media (min-width:900px){
  .hero__grid{grid-template-columns:1.05fr 1fr;align-items:start}
  .hero__media{grid-column:2;grid-row:2/span 2}
  .facts{grid-column:1;grid-template-columns:repeat(3,1fr);gap:1.4rem;align-self:end}
  .fact{grid-template-columns:1fr;gap:.6rem}
}
@media (max-width:899px){.hero__media{margin:0 6% 0 6%}.tag--1{left:-7%}.tag--2{right:-7%}}
@media (max-width:520px){.hero__media{margin:0 4%}.tag{padding:.6rem .8rem}.tag b{font-size:.9rem}.tag small{font-size:.62rem}}

/* marquee */
.marq{position:relative;z-index:2;margin-top:calc(-4vw - 24px);padding:12px 0;overflow:hidden}
.marq__band{background:var(--acc);color:var(--ink);transform:rotate(-1.4deg) scale(1.03);transform-origin:center;padding:.85rem 0;overflow:hidden}
.marq__track{display:flex;width:max-content;animation:marq 38s linear infinite;will-change:transform}
.marq__seq{display:flex;align-items:center;gap:1.6rem;padding-right:1.6rem;white-space:nowrap;font:700 .88rem/1 Unbounded,sans-serif;text-transform:uppercase;letter-spacing:.06em}
.marq__seq svg{width:14px;height:14px;flex:none;opacity:.75}
@keyframes marq{to{transform:translateX(-50%)}}
@media (hover:hover) and (pointer:fine){.marq__band:hover .marq__track{animation-play-state:paused}}

/* services */
.svc{display:grid;gap:1.2rem;grid-template-columns:repeat(auto-fill,minmax(260px,1fr))}
.card{background:var(--white);box-shadow:inset 0 0 0 1px var(--line);display:flex;flex-direction:column;--ch:14px}
.card__media{position:relative;overflow:hidden;aspect-ratio:4/3;background:#E4E6E3}
.card__media img{width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease)}
.card__media .plate{position:absolute;left:12px;bottom:12px}
.card__body{padding:1.2rem 1.25rem 1.4rem;display:flex;flex-direction:column;gap:.8rem;flex:1}
.card h3{font-size:1rem}
.card ul{display:grid;gap:.35rem;color:var(--steel-d);font-size:.92rem}
.card li{padding-left:1.15rem;position:relative}
.card li::before{content:"";position:absolute;left:0;top:.62em;width:8px;height:2px;background:var(--acc)}
.card__note{font-size:.8rem;color:var(--steel-d);margin-top:auto}
@media (hover:hover) and (pointer:fine){.card:hover .card__media img{transform:scale(1.05)}}

/* diagnosis (interactive) */
.dz{display:grid;gap:2rem}
.dz__scheme{position:relative}
.scan{--ch:18px;position:relative;background:linear-gradient(180deg,var(--ink2),rgba(26,29,33,.55));box-shadow:inset 0 0 0 1px var(--line-dk);padding:clamp(14px,2vw,22px)}
.scan__top{display:flex;align-items:center;gap:.7rem;font-size:.85rem;color:var(--steel);padding-bottom:.85rem;border-bottom:1px solid var(--line-dk)}
.scan__top b{font:700 .85rem/1 Unbounded,sans-serif;color:var(--light);text-transform:uppercase;letter-spacing:.03em}
.scan__led{width:8px;height:8px;border-radius:50%;background:var(--acc);flex:none;box-shadow:0 0 0 3px rgba(255,106,26,.2)}
.scan.busy .scan__led{animation:blink .5s steps(2) infinite}
@keyframes blink{50%{opacity:.25}}
.scan__st{margin-left:auto;font-variant-numeric:tabular-nums;text-align:right}
.scan__st.bad{color:var(--acc2)}
.car{position:relative;width:100%;aspect-ratio:800/250;margin:1.6rem 0 1.9rem}
.scan__beam{position:absolute;top:-8%;bottom:-8%;left:0;right:0;pointer-events:none;overflow:hidden;opacity:0}
.scan__beam::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent calc(100% - 120px),rgba(255,106,26,.24));box-shadow:inset -2px 0 0 var(--acc);transform:translateX(-100%)}
.scan__beam.go{animation:beamo 1.1s linear}
.scan__beam.go::before{animation:beam 1.1s cubic-bezier(.65,0,.35,1) forwards}
@keyframes beam{to{transform:translateX(0)}}
@keyframes beamo{0%,78%{opacity:1}100%{opacity:0}}
.car .z.on rect{animation:ants 1.2s linear infinite}
@keyframes ants{to{stroke-dashoffset:-20}}
.read__cap{display:flex;justify-content:space-between;gap:1rem;font-size:.78rem;color:var(--steel);margin-bottom:.55rem}
.read__cap i{font-style:normal;display:inline-flex;align-items:center;gap:.4rem}
.read__cap i::before,.read b.bad::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--acc);flex:none}
.read{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line-dk);box-shadow:0 0 0 1px var(--line-dk)}
.read>div{background:var(--ink);padding:.75rem .9rem .8rem;display:grid;gap:.3rem;align-content:start;min-width:0;transition:opacity .3s var(--ease),transform .3s var(--ease)}
.read.out>div{opacity:0;transform:translateY(5px)}
.read small{font-size:.76rem;color:var(--steel);line-height:1.3}
.read b{font:700 1.02rem/1.15 Unbounded,sans-serif;display:flex;align-items:center;gap:.45rem;font-variant-numeric:tabular-nums;white-space:nowrap}
.read span{font-size:.76rem;color:var(--steel);line-height:1.3}
.car svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.car .z{opacity:0;transition:opacity .3s ease}
.car .z.on{opacity:1}
.hot{position:absolute;width:48px;height:48px;transform:translate(-50%,-50%);display:grid;place-items:center;border-radius:50%;--ch:0}
.hot::before{content:"";position:absolute;inset:8px;border-radius:50%;border:2px solid var(--acc);opacity:.7;animation:pulse 2.2s var(--ease) infinite;will-change:transform,opacity}
.hot i{width:16px;height:16px;border-radius:50%;background:var(--acc);box-shadow:0 0 0 3px var(--ink);transition:transform .2s var(--ease)}
.hot[aria-pressed="true"] i{transform:scale(1.5);background:var(--light);box-shadow:0 0 0 3px var(--acc)}
.hot[aria-pressed="true"]::before{animation:none;opacity:0}
.hot:focus-visible{box-shadow:none;outline:3px solid var(--acc);outline-offset:-4px}
.hot em{position:absolute;top:calc(100% - 6px);left:50%;transform:translate(-50%,4px);padding:.34rem .5rem;background:var(--ink);box-shadow:inset 0 0 0 1px rgba(255,255,255,.18);font:700 .6rem/1 Unbounded,sans-serif;text-transform:uppercase;letter-spacing:.05em;color:var(--light);white-space:nowrap;pointer-events:none;opacity:0;transition:opacity .2s ease,transform .25s var(--ease)}
.hot[aria-pressed="true"] em{opacity:1;transform:translate(-50%,0);background:var(--acc);color:var(--ink);box-shadow:none}
.hot:focus-visible em{opacity:1;transform:translate(-50%,0)}
@media (hover:hover) and (pointer:fine){.hot:hover em{opacity:1;transform:translate(-50%,0)}}
.hot--w em{top:calc(100% + 10px)}
@keyframes pulse{0%{transform:scale(.9);opacity:.8}100%{transform:scale(2.2);opacity:0}}
.hot:nth-child(2)::before{animation-delay:-.4s}.hot:nth-child(3)::before{animation-delay:-.8s}.hot:nth-child(4)::before{animation-delay:-1.2s}.hot:nth-child(5)::before{animation-delay:-1.6s}.hot:nth-child(6)::before{animation-delay:-2s}
.chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.4rem}
.chip{min-height:44px;padding:.5rem 1rem;font:600 .9rem/1 Onest,sans-serif;color:var(--light);box-shadow:inset 0 0 0 1px var(--line-dk);--ch:7px;transition:background-color .15s ease,color .15s ease}
.chip[aria-pressed="true"]{background:var(--acc);color:var(--ink);box-shadow:none}
@media (hover:hover) and (pointer:fine){.chip:hover{background:var(--ink3)}.chip[aria-pressed="true"]:hover{background:var(--acc2)}}
.dz__hint{margin-top:1rem;font-size:.9rem;color:var(--steel)}
.dcard{background:var(--ink2);box-shadow:inset 0 0 0 1px var(--line-dk);padding:clamp(1.3rem,3vw,2rem);--ch:18px;position:relative}
.dcard__in{transition:opacity .35s var(--ease),transform .35s var(--ease)}
.dcard__in.out{opacity:0;transform:translateY(12px);transition-duration:.15s}
.dcard h3{font-size:1.3rem;text-transform:uppercase;margin-bottom:1.2rem}
