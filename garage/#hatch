function open(i){last=document.activeElement;show(i);lb.hidden=false;document.body.style.overflow='hidden';requestAnimationFrame(function(){requestAnimationFrame(function(){lb.classList.add('open')})});$('#lbX').focus()}
function close(){lb.classList.remove('open');document.body.style.overflow='';var done=function(){lb.hidden=true;if(last)last.focus()};if(RM)done();else setTimeout(done,250)}
