  $('#fComment').value='Расчёт с сайта: '+L.t.n.toLowerCase()+', '+L.area+' м² ('+L.rows.map(function(r){return r.n.toLowerCase()+' '+r.a}).join(', ')+')'+(ops.length?'. Дополнительно: '+ops.join(', '):'')+'. Цвет стен: '+paintN.toLowerCase()+'. Ориентир: '+fmt(L.total)+' ₽, ≈ '+L.wk+' нед.';
  setTimeout(function(){$('#fName').focus({preventScroll:true})},600);
});

/* gantt + stages draw */
var io2=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('vis');io2.unobserve(e.target)}})},{threshold:.25});
io2.observe($('#gantt'));io2.observe($('#stages-l'));

/* compare */
var cmp=$('#cmp'),cr=$('.cmp-r',cmp);
cr.addEventListener('input',function(){cmp.style.setProperty('--p',cr.value)});

/* lightbox */
var lb=$('#lb'),lbImg=$('#lbImg'),lbCap=$('#lbCap'),obs=$$('.ob'),cur=0,lastFocus=null;
function show(i){cur=(i+obs.length)%obs.length;var b=obs[cur];lbImg.src=b.dataset.full;lbImg.alt=$('img',b).alt;lbCap.textContent=b.dataset.cap}
function openLb(i){lastFocus=document.activeElement;show(i);lb.classList.add('open');document.body.classList.add('is-locked');$('#lbX').focus()}
function closeLb(){lb.classList.remove('open');document.body.classList.remove('is-locked');if(lastFocus)lastFocus.focus()}
obs.forEach(function(b,i){b.addEventListener('click',function(){openLb(i)})});
$('#lbX').addEventListener('click',closeLb);
$('#lbP').addEventListener('click',function(){show(cur-1)});
$('#lbN').addEventListener('click',function(){show(cur+1)});
lb.addEventListener('click',function(e){if(e.target===lb)closeLb()});
document.addEventListener('keydown',function(e){
  if(lb.classList.contains('open')){if(e.key==='Escape')closeLb();else if(e.key==='ArrowLeft')show(cur-1);else if(e.key==='ArrowRight')show(cur+1)}
  else if(e.key==='Escape'&&mnav.classList.contains('open'))closeMenu();
});

/* faq */
$$('.faq-q').forEach(function(q){q.addEventListener('click',function(){
  var open=q.getAttribute('aria-expanded')==='true',a=document.getElementById(q.getAttribute('aria-controls'));
  $$('.faq-q').forEach(function(o){if(o!==q){o.setAttribute('aria-expanded','false');document.getElementById(o.getAttribute('aria-controls')).hidden=true}});
  q.setAttribute('aria-expanded',!open);a.hidden=open;
})});

/* phone mask */
var ph=$('#fPhone');
ph.addEventListener('input',function(){
  var v=ph.value,d;
  if(v.indexOf('+7')===0)d=v.slice(2).replace(/\D/g,'');else{d=v.replace(/\D/g,'');if(d[0]==='7'||d[0]==='8')d=d.slice(1)}
  d=d.slice(0,10);
  var s='+7';if(d.length)s+=' ('+d.slice(0,3);if(d.length>=4)s+=') '+d.slice(3,6);if(d.length>=7)s+='-'+d.slice(6,8);if(d.length>=9)s+='-'+d.slice(8,10);
  ph.value=s;
});
ph.addEventListener('focus',function(){if(!ph.value){ph.value='+7 ';requestAnimationFrame(function(){try{ph.setSelectionRange(3,3)}catch(e){}})}});
ph.addEventListener('blur',function(){if(ph.value.replace(/\D/g,'').length<2)ph.value=''});

/* form */
var form=$('#leadForm'),box=$('#form');
form.addEventListener('submit',function(e){
  e.preventDefault();
  var ok=true;
  [$('#fName'),ph].forEach(function(i){var bad=i===ph?ph.value.replace(/\D/g,'').length<11:!i.value.trim();i.style.borderColor=bad?'#BE4F32':'';if(bad){ok=false}});
  if(!ok){($('#fName').value.trim()?ph:$('#fName')).focus();return}
  box.classList.add('ok-s');$('#again').focus({preventScroll:true});
});
$('#again').addEventListener('click',function(){form.reset();box.classList.remove('ok-s');$('#fName').focus()});
})();
</script>
