.mnav a{font:700 1.5rem/1.2 var(--fh);letter-spacing:-.02em;text-decoration:none;padding:14px 0;border-bottom:1px solid var(--line-2)}
.mnav .btn{margin-top:20px;justify-self:start}
}
@media (max-width:1100px){
.sv{grid-template-columns:repeat(2,1fr)}
