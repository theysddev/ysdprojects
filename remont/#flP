.bur{display:grid}
.mnav{display:grid;position:fixed;inset:var(--hh) 0 0 0;z-index:49;background:var(--paper);padding:20px var(--gut) 40px;align-content:start;gap:6px;opacity:0;transform:translateY(-10px);pointer-events:none;transition:opacity .3s ease,transform .4s var(--ease)}
