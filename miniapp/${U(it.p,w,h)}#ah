const CUP=`<svg class="cup" viewBox="0 0 120 150" width="128" height="160" aria-hidden="true"><defs><clipPath id="cupc"><path d="M30 46h60l-6 86a8 8 0 0 1-8 7H44a8 8 0 0 1-8-7z"/></clipPath></defs><g class="steam"><path d="M48 24c-4-5 4-8 0-13M60 26c-4-5 4-8 0-13M72 24c-4-5 4-8 0-13"/></g><path class="c-bg" d="M30 46h60l-6 86a8 8 0 0 1-8 7H44a8 8 0 0 1-8-7z"/><g clip-path="url(#cupc)"><g class="lvl" style="transform:translateY(93px)"><rect x="20" y="46" width="80" height="100" fill="#8B5A3C"/><path d="M20 46q7.5-5 15 0t15 0 15 0 15 0 15 0 5 0v7H20z" fill="#D7B48E"/></g></g><path class="c-out" d="M30 46h60l-6 86a8 8 0 0 1-8 7H44a8 8 0 0 1-8-7z"/><path d="M33.5 84h53l-1.6 24h-49.8z" fill="#2A1A12"/><text x="60" y="101" text-anchor="middle" font-size="12" font-weight="700" fill="#F4EADB" style="font-family:Unbounded,sans-serif;letter-spacing:-.04em">пенка</text><g class="lid"><path d="M26 38h68a3 3 0 0 1 3 3v6H23v-6a3 3 0 0 1 3-3z"/><path d="M37 38l4-8h38l4 8z"/></g></svg>`;
const SMSG={new:'Заказ принят. Передаём бариста',cooking:'Бариста готовит ваш заказ',ready:'Готово! Заберите на стойке выдачи',done:'Приятного кофе! Ждём снова'};
function cupsH(n,f,cls){return [0,1,2,3,4,5].map(i=>`<i class="${cls}${i<n?' on':''}${f&&i>=f.from&&i<f.to?' pop-in':''}"${f&&i>=f.from&&i<f.to?` style="animation-delay:${(i-f.from)*140+350}ms"`:''}>${cls==='cupc'?I.cupS:''}</i>`).join('')}
function renderStatus(){const o=S.mine;if(!o){V.status.innerHTML='<div class="scroll"></div>';return}
const add=o.stt-o.sf,txt=o.gift?'Седьмой кофе — в подарок. Карта начинается заново':o.stt>=6?'Штамп добавлен — следующий кофе в подарок':add>0?`+${add} ${plural(add,'штамп','штампа','штампов')}: ${o.stt} из 6`:`${o.stt} из 6 штампов`;
V.status.innerHTML=`<div class="scroll"><div class="st-top"><p class="st-lbl">Номер заказа</p><p class="st-no">${o.no}</p><p class="st-where">${ST[o.store].a}, ${o.when}</p></div>
<div class="cupw" id="cupw">${CUP}</div>
<div class="track"><i class="bar" id="tBar"></i>${['Принят','Готовим','Готово'].map((n,i)=>`<div class="tstep"><i>${I.check}</i><span>${n}</span><small></small></div>`).join('')}</div>
<p class="st-msg" id="stMsg" role="status" aria-live="polite"></p>
<button type="button" class="lstrip" data-go="loyalty" style="width:100%;text-align:left"><span class="mc" aria-hidden="true">${cupsH(o.stt,S.fresh,'mcup')}</span><p>${txt}<br><span style="color:#C9B6A3">+${o.earn} ${plural(o.earn,'балл','балла','баллов')} на карту</span></p>${I.chev}</button>
<h3 class="h">Состав заказа</h3><div class="list olist">${o.lines.map(l=>{const it=byId(l.id),d=desc(it,l.c);return `<div class="row"><span class="rt">${l.q}× ${esc(it.n)}${d?`<small>${esc(d)}</small>`:''}</span><span class="rp">${rub(l.u*l.q)}</span></div>`}).join('')}${o.comment?`<div class="row"><span class="rt">Комментарий<small>${esc(o.comment)}</small></span></div>`:''}<div class="row"><span class="rt"><b>Оплачено</b></span><b>${rub(o.sum)}</b></div></div>
<p class="note">Бот пришлёт сообщение, когда заказ будет готов</p></div>`;
updStatus(1)}
function updStatus(instant){const o=S.mine;if(!o||!$('#cupw',V.status))return;const idx={new:0,cooking:1,ready:2,done:2}[o.st];
$$('.tstep',V.status).forEach((e,i)=>{e.classList.toggle('on',i<=idx);e.querySelector('small').textContent=o.ts[i]||''});
const bar=$('#tBar');if(instant)bar.style.transition='none';bar.style.transform=`scaleX(${idx/2})`;if(instant){bar.getBoundingClientRect();bar.style.transition=''}
$('#stMsg').textContent=SMSG[o.st];$('#cupw').classList.toggle('ready',idx===2);cupFill(instant)}
function cupFill(instant){const o=S.mine,lv=$('#cupw .lvl',V.status);if(!o||!lv)return;const H=93,set=(f)=>lv.style.transform=`translateY(${(H*(1-f)).toFixed(1)}px)`;
if(o.st==='cooking'){const cur=Math.min(.86,.12+.74*Math.max(0,(simT-3)/9));lv.style.transition='none';set(cur);lv.getBoundingClientRect();if(rm())return;lv.style.transition=`transform ${Math.max(.6,12-Math.max(simT,3))}s linear`;set(.86);return}
lv.style.transition=instant||rm()?'none':`transform .7s ${EASE}`;set(o.st==='new'?.12:1)}
function setSt(o,st){o.st=st;const i={new:0,cooking:1,ready:2}[st];if(i!==undefined)o.ts[i]=hm();
if(o.mine){if(st==='cooking')simT=Math.max(simT,3);
if(st==='ready'){simT=Math.max(simT,12);const ph=readyPh(o),t=`☕ ${ph} — точка ${ST[o.store].loc}`;chatPush(`${t}. Назовите номер ${o.no} на выдаче.`);
if(S.mode==='guest'&&!S.closed)showBan(t);else if(S.mode==='barista')toast('Гостю ушло сообщение от бота: «'+ph+'»')}
if(st==='done')S.orders=S.orders.filter(x=>x!==o);
if(curV==='status')updStatus();updPill();syncMB()}}
function picked(){const o=S.mine;if(!o)return;setSt(o,'done');chatPush('Спасибо, что выбрали «Пенку»! Хорошего дня ☕')}
setInterval(()=>{const o=S&&S.mine;if(!o||S.mode!=='guest'||o.st==='ready'||o.st==='done')return;simT+=.25;
if(o.st==='new'&&simT>=3)setSt(o,'cooking');else if(o.st==='cooking'&&simT>=12)setSt(o,'ready')},250);
function showBan(t){$('#banT').textContent=t;ban.classList.add('on');ban.tabIndex=0;clearTimeout(banT);banT=setTimeout(hideBan,5000)}
function hideBan(){ban.classList.remove('on');ban.tabIndex=-1}

/* ---------- loyalty ---------- */
function qr(){const N=25,g=[];let sd=27182;const rnd=()=>(sd=sd*16807%2147483647)/2147483647;
const fz=(r,c)=>(r<8&&c<8)||(r<8&&c>=N-8)||(r>=N-8&&c<8);
const fp=(r,c)=>{const R=r>=N-8?r-(N-7):r,C=c>=N-8?c-(N-7):c;if(R<0||C<0||R>6||C>6)return 0;return R===0||R===6||C===0||C===6||(R>=2&&R<=4&&C>=2&&C<=4)};
let d='';for(let r=0;r<N;r++)for(let c=0;c<N;c++){const on=fz(r,c)?fp(r,c):(r===6||c===6)?(r+c)%2===0:rnd()>.5;if(on&&!(r>=10&&r<=14&&c>=10&&c<=14))d+=`M${c} ${r}h1v1h-1z`}
return `<svg viewBox="0 0 25 25" role="img" aria-label="QR-код карты гостя, демо" shape-rendering="crispEdges"><path d="${d}" fill="#2A1A12"/><rect x="10.5" y="10.5" width="4" height="4" rx="1" fill="#B8D47A"/></svg>`}
const QR=qr();
function renderLoy(){const n=S.stamps,f=S.fresh;S.fresh=null;
V.loyalty.innerHTML=`<div class="scroll"><h2 class="vh">Карта гостя</h2>
<div class="lcard"><div class="lc-top"><span class="lc-wm">пенка</span><small>карта гостя</small></div>
<div class="cups" aria-hidden="true">${cupsH(n,f,'cupc')}<i class="cupc g">${I.gift}</i></div>
<p class="lc-t">${n>=6?'Следующий кофе — в подарок':`${n} из 6. Ещё ${6-n} кофе — и седьмой в подарок`}</p><p class="lc-s">Штамп за каждый напиток, заказанный в мини-приложении или на кассе</p></div>
<div class="sect pts"><b>${S.pts}</b><p>${plural(S.pts,'балл','балла','баллов')} на карте. 1 балл = 1 ₽, списывайте до 30% заказа, начисляем 5% от оплаты</p></div>
<div class="sect qr"><span class="qrb">${QR}</span><p>Покажите код на кассе</p><small>Бариста начислит штамп и баллы. В демо код не сканируется</small></div></div>`}

/* ---------- barista ---------- */
const COLS=[['new','Новые','Взять','take'],['cooking','Готовятся','Готово','done'],['ready','Готово','Выдан','give']];
function ocH(o,a){return `<article class="oc s-${o.st}${o.mine?' mine':''}" data-no="${o.no}"><div class="oc-hd"><span class="oc-no">${o.no}</span><span class="oc-w">${o.when}</span></div>${o.mine?'<span class="me">Ваш заказ из демо</span>':''}
<ul>${o.lines.map(l=>{const it=byId(l.id),d=desc(it,l.c);return `<li>${l.q}× ${esc(it.n)}${d?`<small>${esc(d)}</small>`:''}</li>`}).join('')}</ul>${o.comment?`<p class="cm">«${esc(o.comment)}»</p>`:''}
<div class="oc-ft"><span>${esc(o.who)}, Telegram</span><button type="button" class="oc-b" data-act="${a[3]}" data-no="${o.no}" aria-label="${a[2]}: заказ ${o.no}">${a[2]}</button></div></article>`}
function renderBar(moved,fc){const b0=$('#board'),sl=b0?b0.scrollLeft:0,sc0=$('.scroll',V.barista),st=sc0?sc0.scrollTop:0;
const by=k=>S.orders.filter(o=>o.st===k).sort((a,b)=>a.no.localeCompare(b.no));
V.barista.innerHTML=`<div class="scroll"><div class="bnote"><p>Так заказы видит бариста на точке ${ST[S.store].a}. Нажмите «Взять», потом «Готово»&nbsp;— статус изменится у гостя.</p><button type="button" data-mode="guest">К гостю</button></div>
<div class="btabs">${COLS.map(a=>{const n=by(a[0]).length;return `<button type="button" class="btab${a[0]==='new'&&n?' hot':''}" data-col="${a[0]}">${a[1]} <i>${n}</i></button>`}).join('')}</div>
<div class="board" id="board">${COLS.map(a=>{const L=by(a[0]);return `<section class="col" data-c="${a[0]}" aria-label="${a[1]}"><h3 class="col-h">${a[1]}<span>${L.length} ${plural(L.length,'заказ','заказа','заказов')}</span></h3>${L.length?L.map(o=>ocH(o,a)).join(''):'<p class="col-e">Пока пусто</p>'}</section>`}).join('')}</div></div>`;
const b=$('#board');b.scrollLeft=sl;$('.scroll',V.barista).scrollTop=st;
if(moved){const el=$(`.oc[data-no="${moved}"]`,V.barista);if(el){const col=el.closest('.col');b.scrollTo({left:col.offsetLeft-16,behavior:rm()?'auto':'smooth'});
if(!rm())el.animate([{opacity:0,transform:'translateY(12px) scale(.97)'},{opacity:1,transform:'none'}],{duration:340,delay:140,easing:EASE,fill:'backwards'});
const btn=el.querySelector('.oc-b');if(fc&&btn)btn.focus({preventScroll:true})}}}
function bAct(no,act){const o=S.orders.find(x=>x.no===no);if(!o)return;const el=$(`.oc[data-no="${no}"]`,V.barista);
const run=()=>{if(o.mine)step('barista');if(act==='take'){setSt(o,'cooking');if(o.mine)toast('Гость видит статус «Готовим»')}
else if(act==='done')setSt(o,'ready');
else{if(o.mine){setSt(o,'done');toast('Заказ выдан гостю')}else S.orders=S.orders.filter(x=>x!==o)}
renderBar(act==='give'?null:no,1)};
if(el&&!rm())el.animate([{opacity:1},{opacity:0,transform:'scale(.96)'}],{duration:160,easing:EASE,fill:'forwards'}).onfinish=run;else run()}
function setMode(m){if(S.mode===m)return;S.mode=m;closeSheet(1);closePop();if(pay.classList.contains('on')&&!payBusy)closePay();if(S.closed)openApp();hideBan();
if(m==='barista'){show('barista',2);renderBar(S.mine&&S.mine.st!=='done'?S.mine.no:null)}else{const t=top();render(t);show(t,2)}
syncHead();syncMB();syncCtl()}

/* ---------- chat / close ---------- */
function chatPush(h){S.msgs.push({t:hm(),h,n:1});renderChat()}
function renderChat(){const m=$('#chatM');m.innerHTML=S.msgs.map((x,i)=>`<div class="msg${x.n?' new':''}"><p>${esc(x.h)}<time>${x.t}</time></p></div>${x.kb?'<div class="kb"><button type="button" data-openapp>☕ Открыть меню</button></div>':''}`).join('');S.msgs.forEach(x=>x.n=0);m.scrollTop=m.scrollHeight}
function closeApp(){closeSheet(1);closePop();hideBan();S.closed=true;tma.classList.add('closed');layer.inert=true;chat.inert=false;renderChat();syncMB();setTimeout(()=>$('#chatMenu').focus({preventScroll:true}),rm()?0:340)}
function openApp(){S.closed=false;tma.classList.remove('closed');layer.inert=false;chat.inert=true;syncMB();setTimeout(()=>tgL.focus({preventScroll:true}),rm()?0:340)}

/* ---------- menu (⋯) ---------- */
function openPop(){pop.classList.add('on');tgR.setAttribute('aria-expanded','true');setTimeout(()=>pop.querySelector('button').focus({preventScroll:true}),30)}
function closePop(f){if(!pop.classList.contains('on'))return;pop.classList.remove('on');tgR.setAttribute('aria-expanded','false');if(f)tgR.focus({preventScroll:true})}
function setTheme(t){S.theme=t;scr.dataset.theme=t;syncCtl()}
function syncCtl(){$$('.sw2').forEach(g=>{const v=g.dataset.k==='mode'?S.mode:S.theme;$$('button',g).forEach((b,i)=>{const on=b.dataset.v===v;b.setAttribute('aria-pressed',on?'true':'false');if(on)g.dataset.i=i})});
$('[data-m="theme"]',pop).setAttribute('aria-checked',S.theme==='dark'?'true':'false');$('#popMode').textContent=S.mode==='barista'?'Экран гостя':'Экран бариста'}
function step(k){if(S.done[k])return;S.done[k]=1;const li=$(`.try li[data-step="${k}"]`);if(!li)return;li.classList.add('ok');li.querySelector('.tk').innerHTML=I.check;li.querySelector('.st-done').textContent=' — выполнено'}
function resetDemo(){const th=S.theme;closeSheet(1);closePop();payBusy=false;pay.classList.remove('on');pay.innerHTML='';hideBan();fresh(th);
tma.classList.remove('closed');layer.inert=false;chat.inert=true;Object.values(V).forEach(v=>v.hidden=true);V.home.hidden=false;curV='home';renderHome();renderChat();
$$('.try li').forEach(li=>{li.classList.remove('ok');li.querySelector('.tk').innerHTML='';li.querySelector('.st-done').textContent=''});syncHead();syncMB();syncCtl();toast('Демо начато заново')}

/* ---------- events ---------- */
scr.addEventListener('click',e=>{const t=e.target.closest('button,[data-close],[data-payx]');if(!t||!scr.contains(t))return;const d=t.dataset;
if(pop.classList.contains('on')&&!pop.contains(t)&&t!==tgR){closePop()}
if(t===tgL){if(S.mode==='guest'&&S.stack.length>1)back();else closeApp();return}
if(t===tgR){pop.classList.contains('on')?closePop(1):openPop();return}
if(t===mb){if(mbFn&&!mb.disabled)mbFn();return}
if(t===ban){hideBan();if(S.mode==='guest'&&top()!=='status')go('status');return}
if(d.m){closePop(1);if(d.m==='theme')setTheme(S.theme==='dark'?'light':'dark');else if(d.m==='mode')setMode(S.mode==='barista'?'guest':'barista');else resetDemo();return}
if('openapp' in d){openApp();return}
if(d.open){openProduct(d.open);return}
if(d.add){quickAdd(d.add,t);return}
if(d.go){go(d.go);return}
if('home' in d){toHome();return}
if('store' in d){openSheet(storeH(),'store','Выбор точки');return}
if('close' in d){closeSheet();return}
if('payx' in d){closePay();return}
if('pay' in d){doPay();return}
if(d.q){cfg.q=Math.max(1,Math.min(9,cfg.q+(+d.q)));$('#pdQ').textContent=cfg.q;syncMB();return}
if(d.cq){cq(t.closest('.cl').dataset.k,+d.cq);return}
if(d.when){S.when=d.when;$$('[data-when]',V.cart).forEach(b=>b.setAttribute('aria-pressed',b===t?'true':'false'));const p=$('#pick');p.hidden=S.when!=='pick';if(S.when==='pick'){S.at=$('#atT').value.replace(/^0(?=\d:)/,'');$('#atT').focus({preventScroll:true})}return}
if(d.tab){jumpTab(d.tab);return}
if(d.act){bAct(d.no,d.act);return}
if(d.col){const c=$(`.col[data-c="${d.col}"]`,V.barista);$('#board').scrollTo({left:c.offsetLeft-16,behavior:rm()?'auto':'smooth'});return}
if(d.mode){setMode(d.mode);return}
});
scr.addEventListener('change',e=>{const t=e.target;
if(t.closest('#pd')){readPd(e);return}
if(t.name==='st'){S.store=+t.value;updHome();const a=$('#cStA');if(a)renderCart();if(S.mode==='barista')renderBar();setTimeout(()=>closeSheet(),rm()?0:220);return}
if(t.id==='usePts'){S.usePts=t.checked;updSum();syncMB();return}
if(t.id==='atT'){S.at=t.value.replace(/^0(?=\d:)/,'');return}});
scr.addEventListener('input',e=>{if(e.target.id==='cmt')S.comment=e.target.value});
document.addEventListener('click',e=>{if(pop.classList.contains('on')&&!pop.contains(e.target)&&!tgR.contains(e.target))closePop()});
document.addEventListener('keydown',e=>{
if(e.key==='Escape'){if(pop.classList.contains('on')){closePop(1);e.preventDefault()}else if(pay.classList.contains('on')){closePay();e.preventDefault()}else if(sheetKind){closeSheet();e.preventDefault()}return}
if(e.key==='Tab'){const root=pay.classList.contains('on')?pay:sheetKind?sh:pop.classList.contains('on')?pop:null;if(!root)return;
const f=$$('button:not([disabled]),input,textarea,[tabindex="0"]',root).filter(x=>x.offsetParent!==null||x.type==='radio'||x.type==='checkbox');
const extra=sheetKind==='product'&&!mbbar.inert?[mb]:[];const all=[...f,...extra];if(!all.length)return;const i=all.indexOf(document.activeElement);
if(e.shiftKey&&(i<=0)){all[all.length-1].focus();e.preventDefault()}else if(!e.shiftKey&&(i===all.length-1||i===-1)){all[0].focus();e.preventDefault()}}
if(pop.classList.contains('on')&&(e.key==='ArrowDown'||e.key==='ArrowUp')){const b=$$('button',pop),i=b.indexOf(document.activeElement);b[(i+(e.key==='ArrowDown'?1:-1)+b.length)%b.length].focus();e.preventDefault()}});

/* pitch controls */
$$('.sw2').forEach(g=>g.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(g.dataset.k==='mode')setMode(b.dataset.v);else setTheme(b.dataset.v)}));
$('#openBar').addEventListener('click',()=>{setMode('barista');scrollTo({top:0,behavior:rm()?'auto':'smooth'});setTimeout(()=>{const b=$('.oc.mine .oc-b',V.barista)||$('.oc-b',V.barista);if(b)b.focus({preventScroll:true})},rm()?0:500)});

/* status bar clock */
const tick=()=>{$('#sbT').textContent=hm()};tick();setInterval(tick,15000);

/* reveal on scroll */
if('IntersectionObserver' in window&&!rm()){const io=new IntersectionObserver(es=>es.forEach(en=>{if(en.isIntersecting){en.target.classList.remove('pre');io.unobserve(en.target)}}),{rootMargin:'0px 0px -6% 0px'});
$$('.rv').forEach(el=>{if(el.getBoundingClientRect().top>innerHeight){el.classList.add('pre');io.observe(el)}})}
if(!rm())$$('svg.sch').forEach(s=>$$('.lns path',s).forEach((p,i)=>{const b=i*.8+'s',e=i===3?.42:.16;s.insertAdjacentHTML('beforeend',`<circle class="dot" r="5" opacity="0"><animateMotion dur="5s" begin="${b}" repeatCount="indefinite" path="${p.getAttribute('d')}" calcMode="linear" keyTimes="0;${e};1" keyPoints="0;1;1"/><animate attributeName="opacity" dur="5s" begin="${b}" repeatCount="indefinite" values="0;1;1;0;0" keyTimes="0;.02;${(e-.02).toFixed(2)};${e};1"/></circle>`)}));

/* init */
fresh(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');
scr.dataset.theme=S.theme;renderHome();renderChat();syncHead();syncMB();syncCtl();
})();
