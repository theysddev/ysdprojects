function lbShow(i){gi=(i+G.length)%G.length;lbI.src='https://images.unsplash.com/photo-'+G[gi][0]+'?auto=format&fit=crop&w=1600&h=1200&q=72';lbI.alt=G[gi][1];lbC.innerHTML='<i>Фото-пример.</i> '+G[gi][1]+' — '+(gi+1)+' из '+G.length}
function lbOpen(i){lbFrom=D.activeElement;lbShow(i);lb.classList.add('open');R.classList.add('lock');requestAnimationFrame(()=>{lb.classList.add('vis')});$('.lb-x',lb).focus()}
function lbClose(){if(!lb.classList.contains('open'))return;lb.classList.remove('vis');setTimeout(()=>{lb.classList.remove('open');if(!menu.classList.contains('open'))R.classList.remove('lock')},RM?0:220);if(lbFrom&&lbFrom.focus)lbFrom.focus({preventScroll:true})}
$$('#gal button').forEach(b=>{b.addEventListener('click',()=>{lbOpen(+b.dataset.i)})});
$('.lb-x',lb).addEventListener('click',lbClose);$('.lb-p',lb).addEventListener('click',()=>{lbShow(gi-1)});$('.lb-n',lb).addEventListener('click',()=>{lbShow(gi+1)});
lb.addEventListener('click',e=>{if(e.target===lb)lbClose()});
D.addEventListener('keydown',e=>{if(e.key==='Escape'){if(lb.classList.contains('open'))lbClose();else if(menu.classList.contains('open')){setMenu(false);bg.focus()}}else if(lb.classList.contains('open')){if(e.key==='ArrowLeft')lbShow(gi-1);else if(e.key==='ArrowRight')lbShow(gi+1);else if(e.key==='Tab'){var f=$$('button',lb),i=f.indexOf(D.activeElement);if(e.shiftKey&&i<=0){e.preventDefault();f[f.length-1].focus()}else if(!e.shiftKey&&i===f.length-1){e.preventDefault();f[0].focus()}}}});

