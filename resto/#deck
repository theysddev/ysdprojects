/* ===== BOOKING ===== */
const TABLES=[
 [1,'vip',12,170,150],[2,'vip',6,105,265],[3,'vip',4,245,265],
 [4,'hall',2,110,440],[5,'hall',4,260,440],[6,'hall',4,410,440],[7,'hall',2,550,440],
 [8,'hall',4,110,590],[9,'hall',6,300,590],[10,'hall',4,480,590],[11,'hall',8,380,715],
