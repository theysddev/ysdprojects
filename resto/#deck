<style>
:root{
  --g:#12302A;--g2:#0E2622;--g3:#193A33;--g4:#21473E;
  --cr:#F3EBDD;--cr2:#EBE1CF;--cr3:#DED1B8;
  --au:#D1A054;--au2:#E2B86E;--au-dk:#8A6118;--on-au:#1B1A17;
  --ink:#1B1A17;--ink-m:rgba(27,26,23,.68);--ink-l:rgba(27,26,23,.16);--ink-l2:rgba(27,26,23,.3);
  --t:#F3EBDD;--t-m:rgba(243,235,221,.68);--t-d:rgba(243,235,221,.42);
  --l:rgba(243,235,221,.14);--l2:rgba(243,235,221,.3);
  --ease:cubic-bezier(.23,1,.32,1);
  --serif:"Cormorant Garamond",Georgia,"Times New Roman",serif;
  --sans:"Onest",system-ui,-apple-system,"Segoe UI",sans-serif;
  --gut:clamp(16px,5vw,84px);--max:1320px;--r:3px;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--g);color:var(--t);font-family:var(--sans);font-size:17px;line-height:1.6;overflow-x:hidden;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%;height:auto}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
button,a,input,select,textarea{touch-action:manipulation}
ul{list-style:none;margin:0;padding:0}
p{margin:0}
h1,h2,h3{margin:0;font-family:var(--serif);font-weight:500;line-height:1.02;letter-spacing:-.01em}
em{font-style:italic;font-weight:400;color:var(--au)}
.lt em{color:var(--au-dk)}
:focus-visible{outline:2px solid var(--au);outline-offset:3px}
.lt :focus-visible{outline-color:var(--au-dk)}
.wrap{max-width:var(--max);margin:0 auto;padding:0 var(--gut)}
section{position:relative;padding:clamp(72px,9vw,128px) 0;scroll-margin-top:72px}
.lt{background:var(--cr);color:var(--ink)}
.dk{background:var(--g);color:var(--t)}
.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* section head */
.sh{display:grid;grid-template-columns:auto 1fr;gap:12px clamp(16px,3vw,40px);align-items:end;padding-top:22px;border-top:1px solid var(--l);margin-bottom:clamp(36px,5vw,64px)}
.lt .sh{border-top-color:var(--ink-l)}
.sh .idx{font-family:var(--serif);font-style:italic;font-size:22px;color:var(--au);line-height:1;padding-bottom:6px}
.lt .sh .idx{color:var(--au-dk)}
.sh h2{font-size:clamp(38px,5.4vw,72px)}
.sh .lead{grid-column:2;max-width:540px;font-size:17px;color:var(--t-m)}
.lt .sh .lead{color:var(--ink-m)}
@media(max-width:600px){.sh{grid-template-columns:1fr;gap:8px}.sh .idx{padding-bottom:0}.sh .lead{grid-column:1}}
@media(min-width:900px){.sh{grid-template-columns:auto 1fr minmax(260px,420px)}.sh .lead{grid-column:3;justify-self:end;text-align:right;padding-bottom:10px}}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 26px;border-radius:var(--r);font-weight:500;font-size:16px;border:1px solid transparent;transition:transform .2s var(--ease),background-color .25s,border-color .25s,color .25s;white-space:nowrap}
.btn:active{transform:scale(.97)}
.btn .ar{width:16px;height:16px;transition:transform .35s var(--ease)}
.btn-au{background:var(--au);color:var(--on-au)}
.btn-ol{border-color:var(--l2);color:var(--t)}
.lt .btn-ol{border-color:var(--ink-l2);color:var(--ink)}
.btn-dk{background:var(--g);color:var(--t)}
.btn[disabled]{opacity:.45;cursor:not-allowed}
@media(hover:hover) and (pointer:fine){
  .btn-au:hover{background:var(--au2)}
  .btn-ol:hover{border-color:var(--au);color:var(--au)}
  .lt .btn-ol:hover{border-color:var(--au-dk);color:var(--au-dk)}
  .btn:hover .ar{transform:translate(3px,-3px)}
}

/* header */
.hdr{position:fixed;inset:0 0 auto;z-index:50;height:72px;background:var(--g);transition:background-color .35s,border-color .35s;border-bottom:1px solid transparent}
.hdr.sc{background:rgba(18,48,42,.78);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-color:var(--l)}
.hdr .wrap{height:100%;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;flex-direction:column;line-height:1;min-height:44px;justify-content:center}
.brand b{font-family:var(--serif);font-weight:600;font-size:26px;letter-spacing:.14em}
.brand span{font-size:11px;letter-spacing:.06em;color:var(--t-m);margin-top:5px}
.nav{display:flex;gap:4px}
.nav a{padding:12px 14px;font-size:15px;color:var(--t-m);border-radius:var(--r);transition:color .2s}
.hdr-r{display:flex;align-items:center;gap:18px}
.hdr-r .ph{font-weight:500;font-size:15px;padding:10px 0;white-space:nowrap}
@media(max-width:1280px){.hdr-r .ph{display:none}.nav a{padding:12px 11px}}
.hdr .btn{min-height:44px;padding:0 20px;font-size:15px}
.burger{display:none;width:44px;height:44px;position:relative}
.burger i{position:absolute;left:11px;width:22px;height:2px;background:var(--t);transition:transform .3s var(--ease),opacity .2s;top:15px}
.burger i:nth-child(2){top:21px}.burger i:nth-child(3){top:27px}
.burger[aria-expanded=true] i:nth-child(1){transform:translateY(6px) rotate(45deg)}
.burger[aria-expanded=true] i:nth-child(2){opacity:0}
.burger[aria-expanded=true] i:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
.mob{position:fixed;inset:72px 0 0;z-index:49;background:var(--g2);padding:28px var(--gut);display:flex;flex-direction:column;gap:6px;transform:translateY(-8px);opacity:0;visibility:hidden;transition:transform .3s var(--ease),opacity .3s,visibility 0s .3s}
.mob.on{transform:none;opacity:1;visibility:visible;transition:transform .3s var(--ease),opacity .3s}
.mob a{font-family:var(--serif);font-size:34px;padding:10px 0;border-bottom:1px solid var(--l)}
.mob .ph{font-family:var(--sans);font-size:18px;border:0;margin-top:14px;color:var(--t-m)}
.mob .btn{margin-top:10px;font-family:var(--sans);font-size:16px;border:0}
@media(hover:hover) and (pointer:fine){.nav a:hover{color:var(--au)}}
@media(max-width:1060px){.nav{display:none}.hdr-r .ph{display:none}}
@media(max-width:720px){.hdr-r .btn{display:none}.burger{display:block}}
.call{display:none;position:fixed;right:16px;bottom:16px;z-index:40;width:56px;height:56px;border-radius:50%;background:var(--au);color:var(--on-au);align-items:center;justify-content:center;box-shadow:0 10px 30px rgba(0,0,0,.35)}
.call svg{width:24px;height:24px}
@media(max-width:720px){.call{display:flex}}

/* hero */
.hero{padding:140px 0 72px;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(32px,5vw,80px);align-items:center}
.hero h1{font-size:clamp(46px,6.4vw,100px);max-width:12ch}
.hero .sub{margin-top:26px;max-width:480px;font-size:18px;color:var(--t-m)}
.hero .cta{display:flex;gap:12px;margin-top:36px;flex-wrap:wrap}
.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:52px;padding-top:28px;border-top:1px solid var(--l)}
.facts li{display:flex;flex-direction:column;gap:10px;font-size:14px;color:var(--t-m);line-height:1.45}
.facts b{display:block;font-family:var(--serif);font-weight:600;font-size:21px;color:var(--t);line-height:1.1}
.facts svg{width:28px;height:28px;color:var(--au)}
.hero-ph{position:relative}
.hero-ph .frame{position:relative;border-radius:var(--r);overflow:hidden;aspect-ratio:5/6;border:1px solid var(--l2)}
.hero-ph .frame::after{content:"";position:absolute;inset:14px;border:1px solid rgba(243,235,221,.35);pointer-events:none}
.hero-ph img{width:100%;height:100%;object-fit:cover;will-change:transform}
.plq{position:absolute;display:flex;align-items:center;gap:12px;padding:14px 18px;background:var(--cr);color:var(--ink);border-radius:var(--r);box-shadow:0 20px 50px rgba(0,0,0,.3);font-size:14px;line-height:1.3;animation:float 7s ease-in-out infinite;will-change:transform}
.plq b{display:block;font-family:var(--serif);font-size:19px;font-weight:600;line-height:1.1}
.plq small{color:var(--ink-m);font-size:13px}
.plq-1{left:-28px;top:12%}
.plq-2{right:-24px;bottom:14%;animation-delay:-3.2s}
.dot{position:relative;width:10px;height:10px;border-radius:50%;background:#3E9F6E;flex:none}
.dot::after{content:"";position:absolute;inset:-5px;border-radius:50%;border:2px solid #3E9F6E;animation:pulse 2.2s ease-out infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes pulse{0%{transform:scale(.5);opacity:.9}100%{transform:scale(1.3);opacity:0}}
.hero-ph .cap{position:absolute;right:14px;bottom:14px;font-size:11px;color:var(--t-m);background:rgba(14,38,34,.7);padding:4px 8px;border-radius:2px}
@media(max-width:960px){.hero .wrap{grid-template-columns:1fr}.hero{padding-top:112px}.hero-ph{margin:0 12px}.plq-1{left:-12px}.plq-2{right:-12px}.facts{grid-template-columns:1fr;gap:18px}.facts li{flex-direction:row;align-items:flex-start;gap:16px}.facts svg{flex:none;margin-top:4px}}

/* marquee */
.mq{background:var(--au);color:var(--on-au);overflow:hidden;padding:16px 0;border-top:1px solid rgba(27,26,23,.15)}
.mq .track{display:flex;width:max-content;animation:mq 46s linear infinite;will-change:transform}
.mq ul{display:flex;gap:0;padding-right:0}
.mq li{display:flex;align-items:center;gap:26px;padding:0 13px;font-family:var(--serif);font-size:24px;font-weight:500;white-space:nowrap}
.mq li::after{content:"";width:6px;height:6px;background:var(--on-au);transform:rotate(45deg)}
@keyframes mq{to{transform:translateX(-50%)}}
@media(hover:hover) and (pointer:fine){.mq:hover .track{animation-play-state:paused}}

/* services */
.srv{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.card{display:flex;flex-direction:column;border:1px solid var(--ink-l);border-radius:var(--r);overflow:hidden;background:var(--cr)}
.card .ph{position:relative;aspect-ratio:4/3;overflow:hidden}
.card .ph img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease)}
.card .cap{position:absolute;left:10px;bottom:10px;font-size:11px;color:var(--t);background:rgba(14,38,34,.72);padding:3px 7px;border-radius:2px}
.card .bd{padding:22px 22px 24px;display:flex;flex-direction:column;flex:1}
.card h3{font-size:28px;font-weight:600}
.card ul{margin:14px 0 20px;display:flex;flex-direction:column;gap:7px;font-size:15px;color:var(--ink-m)}
.card li{padding-left:16px;position:relative}
.card li::before{content:"";position:absolute;left:0;top:10px;width:6px;height:1px;background:var(--au-dk)}
.card .pr{margin-top:auto;display:flex;align-items:baseline;gap:8px;font-size:14px;color:var(--ink-m)}
.card .pr .ld{flex:1;border-bottom:1px dotted var(--ink-l2);transform:translateY(-4px)}
.card .pr b{font-family:var(--serif);font-size:24px;font-weight:600;color:var(--ink)}
@media(hover:hover) and (pointer:fine){.card:hover .ph img{transform:scale(1.04)}}
@media(max-width:1060px){.srv{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.srv{grid-template-columns:1fr}}

/* menu */
.tabs{display:flex;gap:6px;overflow-x:auto;scroll-snap-type:x proximity;padding-bottom:6px;margin-bottom:34px;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{flex:none;scroll-snap-align:start;min-height:46px;padding:0 20px;border:1px solid var(--l2);border-radius:var(--r);font-family:var(--serif);font-size:21px;font-weight:500;color:var(--t-m);transition:color .25s,border-color .25s,background-color .25s,transform .2s var(--ease)}
.tab:active{transform:scale(.97)}
.tab[aria-selected=true]{background:var(--au);border-color:var(--au);color:var(--on-au)}
@media(hover:hover) and (pointer:fine){.tab:not([aria-selected=true]):hover{border-color:var(--au);color:var(--au)}}
.panels{display:grid}
.panel{grid-area:1/1;display:grid;grid-template-columns:minmax(260px,.9fr) 1.1fr;gap:clamp(24px,4vw,64px);align-items:start;opacity:0;visibility:hidden;transform:translateY(8px);transition:opacity .4s var(--ease),transform .4s var(--ease),visibility 0s .4s}
.panel.on{opacity:1;visibility:visible;transform:none;transition:opacity .45s var(--ease) .1s,transform .45s var(--ease) .1s}
.panel .ph{position:relative;border-radius:var(--r);overflow:hidden;aspect-ratio:4/5;border:1px solid var(--l2);padding:12px}
.panel .ph img{width:100%;height:100%;object-fit:cover}
.panel .ph .cap{position:absolute;left:22px;bottom:22px;font-size:11px;color:var(--t);background:rgba(14,38,34,.72);padding:3px 7px;border-radius:2px}
.dishes{display:flex;flex-direction:column}
.dish{padding:18px 0;border-bottom:1px solid var(--l)}
.dish:first-child{padding-top:0}
.dish .row{display:flex;align-items:baseline;gap:12px}
.dish .nm{font-family:var(--serif);font-size:25px;font-weight:500;line-height:1.1}
.dish .ld{flex:1;border-bottom:2px dotted var(--t-d);transform:translateY(-6px);min-width:24px}
.dish .pr{font-family:var(--serif);font-size:23px;font-weight:600;white-space:nowrap;color:var(--au)}
.dish .ds{margin-top:6px;font-size:15px;color:var(--t-m);max-width:52ch}
.dish .chef{display:inline-block;margin-left:10px;font-family:var(--sans);font-size:11px;letter-spacing:.04em;color:var(--au);border:1px solid rgba(209,160,84,.5);padding:2px 7px;border-radius:2px;vertical-align:middle}
.menu-ft{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:44px;padding-top:28px;border-top:1px solid var(--l);color:var(--t-m);font-size:15px}
.menu-ft .btn small{font-size:12px;color:rgba(243,235,221,.6)}
@media(max-width:820px){.panel{grid-template-columns:1fr}.panel .ph{aspect-ratio:4/3;max-height:380px}.dish .nm{font-size:22px}.dish .pr{font-size:20px}}

/* booking */
.book{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(320px,.9fr);gap:clamp(24px,4vw,56px);align-items:start}
.plan-wr,.ctrl{min-width:0}
.plan-wr{position:relative}
.plan{position:relative;aspect-ratio:5/4;background:var(--g2);border:1px solid var(--ink-l2);border-radius:var(--r);overflow:hidden;color:var(--t)}
.plan>svg{position:absolute;inset:0;width:100%;height:100%}
.plan>svg text{font-family:var(--serif);font-style:italic;font-size:26px;fill:rgba(243,235,221,.6)}
.tb{position:absolute;z-index:1;transform:translate(-50%,-50%);width:56px;height:56px;border:1px solid var(--l2);border-radius:var(--r);display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(25,58,51,.96);color:var(--t);line-height:1;transition:background-color .3s,border-color .3s,color .3s,opacity .35s,transform .2s var(--ease)}
.tb .tn{font-family:var(--serif);font-size:23px;font-weight:600}
.tb .ts{display:flex;align-items:center;gap:3px;margin-top:3px;font-size:11px;color:var(--t-m)}
.tb .ts svg{width:9px;height:9px}
.tb.s2{border-radius:50%}
.tb.s6{width:80px}.tb.s8{width:92px}.tb.s12{width:108px}
.tb[aria-pressed=true]{background:var(--au);border-color:var(--au);color:var(--on-au);transform:translate(-50%,-50%) scale(1.06)}
.tb[aria-pressed=true] .ts{color:rgba(27,26,23,.72)}
.tb.booked{opacity:.42;cursor:not-allowed;background:repeating-linear-gradient(45deg,rgba(243,235,221,.14) 0 2px,transparent 2px 7px) var(--g2)}
.tb.small{opacity:.2;cursor:not-allowed}
@media(hover:hover) and (pointer:fine){.tb:not([aria-disabled=true]):not([aria-pressed=true]):hover{border-color:var(--au);color:var(--au)}}
.legend{display:flex;gap:18px;flex-wrap:wrap;margin-top:14px;font-size:13px;color:var(--ink-m)}
.legend li{display:flex;align-items:center;gap:8px}
.legend i{width:14px;height:14px;border:1px solid var(--ink-l2);border-radius:2px;background:var(--g3)}
.legend i.sel{background:var(--au);border-color:var(--au)}
.legend i.bk{background:repeating-linear-gradient(45deg,rgba(27,26,23,.35) 0 2px,transparent 2px 5px) var(--cr2)}
.legend i.sm{opacity:.3}
.legend .free{margin-left:auto;color:var(--ink)}
.ctrl{display:flex;flex-direction:column;gap:26px}
.ctrl h3{font-size:15px;font-family:var(--sans);font-weight:500;color:var(--ink-m);margin-bottom:12px;display:flex;justify-content:space-between;align-items:baseline}
.ctrl h3 span{font-family:var(--serif);font-size:20px;color:var(--ink);font-style:italic}
.dates{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
.dt{min-width:0;height:66px;border:1px solid var(--ink-l2);border-radius:var(--r);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;line-height:1;transition:background-color .2s,border-color .2s,color .2s,transform .2s var(--ease)}
.dt:active{transform:scale(.97)}
.dt small{font-size:11px;color:var(--ink-m);text-transform:lowercase}
.dt b{font-family:var(--serif);font-size:24px;font-weight:600}
.dt[aria-pressed=true]{background:var(--g);border-color:var(--g);color:var(--t)}
.dt[aria-pressed=true] small{color:var(--t-m)}
.dt.we small{color:var(--au-dk)}
.slots{display:grid;grid-template-columns:repeat(auto-fill,minmax(66px,1fr));gap:6px}
.sl{min-height:44px;border:1px solid var(--ink-l2);border-radius:var(--r);font-size:15px;font-weight:500;transition:background-color .2s,border-color .2s,color .2s,transform .2s var(--ease)}
.sl:active{transform:scale(.97)}
.sl[aria-pressed=true]{background:var(--g);border-color:var(--g);color:var(--t)}
.sl[disabled]{opacity:.3;cursor:not-allowed}
@media(hover:hover) and (pointer:fine){.dt:not([aria-pressed=true]):hover,.sl:not([disabled]):not([aria-pressed=true]):hover{border-color:var(--au-dk)}}
.step{display:inline-flex;align-items:center;border:1px solid var(--ink-l2);border-radius:var(--r)}
.step button{width:52px;height:52px;font-size:24px;line-height:1;transition:background-color .2s,transform .2s var(--ease)}
.step button:active{transform:scale(.92)}
.step output{min-width:72px;text-align:center;font-family:var(--serif);font-size:28px;font-weight:600}
.step button[disabled]{opacity:.3;cursor:not-allowed}
.sum{position:relative;padding:26px 26px 26px;border:1px solid var(--ink-l2);border-radius:var(--r);background:var(--cr2)}
.sum::after{content:"";position:absolute;inset:7px;border:1px solid var(--ink-l);pointer-events:none;border-radius:2px}
.sum .lbl{font-size:13px;color:var(--ink-m)}
