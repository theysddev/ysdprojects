/* mobile booking bar */
const mbook=$('#mbook'),mbBtn=$('#mbBtn');let bronVis=false,sumVis=false;
function syncMb(){const on=!!st.tbl&&bronVis&&!sumVis;mbook.classList.toggle('on',on);mbook.setAttribute('aria-hidden',String(!on));mbBtn.tabIndex=on?0:-1;document.body.classList.toggle('mb-on',on)}
new IntersectionObserver(es=>{bronVis=es[0].isIntersecting;syncMb()},{rootMargin:'0px 0px -15% 0px'}).observe($('#bron'));
new IntersectionObserver(es=>{sumVis=es[0].isIntersecting;syncMb()},{threshold:.5}).observe($('.sum'));

function renderPlan(){
  let free=0;
  tbs.forEach(b=>{
    const n=+b.dataset.n,s=+b.dataset.s,t=TABLES[n-1];
    const bk=isBooked(n,st.d,st.t),sm=s<st.g,off=bk||sm;
    b.classList.toggle('booked',bk);b.classList.toggle('small',sm&&!bk);
    b.setAttribute('aria-disabled',String(off));
    if(off&&st.tbl===n)st.tbl=null;
    if(!off)free++;
    b.setAttribute('aria-pressed',String(st.tbl===n));
    b.setAttribute('aria-label',`Стол ${n}, ${ZONE[t[1]]}, ${s} ${seatsWord(s)}, ${bk?'занят':sm?'мало мест':st.tbl===n?'выбран':'свободен'}`);
  });
  $('#freeCnt').textContent=`свободно: ${free} из ${TABLES.length}`;
  const d=DAYS[st.d],ss=sunset(d),tm=slotMin(st.t);
  const sky=tm<ss-75?'day':tm<=ss+20?'gold':'night';
  plan.dataset.sky=sky;
  $('#skyTxt').textContent=sky==='gold'
    ?`Золотой час: солнце садится в ${hm(ss)} прямо напротив террасы. Ближе всего к воде — столики 13, 15 и 18.`
    :sky==='day'
    ?`В этот день закат в ${hm(ss)}. Чтобы встретить его на террасе, выберите слот с золотой точкой.`
    :`Солнце сядет в ${hm(ss)}, к ${SLOTS[st.t]} над морем уже огни набережной, а на террасе — пледы и обогреватели.`;
  $('#dateLbl').textContent=`${WD[d.getDay()]}, ${d.getDate()} ${MON[d.getMonth()]}`;
  $('#timeLbl').textContent=SLOTS[st.t];
  $('#gOut').textContent=st.g;
  $('#gMinus').disabled=st.g<=1;$('#gPlus').disabled=st.g>=12;
  const tx=$('#sumTxt'),dte=$('#sumDte'),btn=$('#bookBtn');
  if(st.tbl){
    const t=TABLES[st.tbl-1];
    tx.textContent=`Стол ${t[0]} · ${ZONE[t[1]]} · ${st.g} ${guestsWord(st.g)} · ${WD[d.getDay()]} ${SLOTS[st.t]}`;
    tx.classList.remove('empty');
    dte.textContent=`${d.getDate()} ${MON[d.getMonth()]} · столик на ${t[2]} ${seatsWord(t[2])} · ${VIEW(t)}`;
    btn.disabled=false;
    $('#mbTxt').textContent=`Стол ${t[0]} · ${SLOTS[st.t]}`;
    $('#mbSub').textContent=`${WD[d.getDay()]}, ${d.getDate()} ${MON[d.getMonth()]} · ${st.g} ${guestsWord(st.g)} · ${ZONE[t[1]]}`;
  }else{tx.textContent=free?'Выберите столик на схеме':'На это время свободных столиков нет — попробуйте другое';tx.classList.add('empty');dte.textContent='';btn.disabled=true}
  syncMb();
}
tWrap.addEventListener('click',e=>{
  const b=e.target.closest('.tb');if(!b||b.getAttribute('aria-disabled')==='true')return;
  const n=+b.dataset.n;st.tbl=st.tbl===n?null:n;renderPlan();
  if(st.tbl&&!RM){b.classList.remove('pop');void b.offsetWidth;b.classList.add('pop')}
  if(FINE.matches||b.matches(':focus-visible'))showTip(b);
});
dates.addEventListener('click',e=>{const b=e.target.closest('.dt');if(!b)return;st.d=+b.dataset.i;dts.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));
  sls.forEach((x,i)=>{x.disabled=slotPast(i)});if(sls[st.t].disabled){const f=sls.findIndex(x=>!x.disabled);if(f>-1){st.t=f;sls.forEach((x,i)=>x.setAttribute('aria-pressed',String(i===f)))}}renderSlots();ripple();renderPlan()});
slots.addEventListener('click',e=>{const b=e.target.closest('.sl');if(!b||b.disabled)return;st.t=+b.dataset.i;sls.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));ripple();renderPlan()});
$('#gMinus').addEventListener('click',()=>{if(st.g>1){st.g--;renderPlan()}});
$('#gPlus').addEventListener('click',()=>{if(st.g<12){st.g++;renderPlan()}});
sls.forEach((x,i)=>{x.disabled=slotPast(i)});
if(sls[st.t].disabled){const f=sls.findIndex(x=>!x.disabled);if(f>-1){st.t=f}else{st.d=1;dts.forEach((x,i)=>x.setAttribute('aria-pressed',String(i===1)));sls.forEach(x=>x.disabled=false)}sls.forEach((x,i)=>x.setAttribute('aria-pressed',String(i===st.t)))}
layout();renderSlots();renderPlan();
/* booking → form */
const chip=$('#chip'),chipTxt=$('#chipTxt'),srvSel=$('#srv'),msg=$('#msg');
let bookStr='';
function doBook(){
  if(!st.tbl)return;
  const t=TABLES[st.tbl-1],d=DAYS[st.d];
  bookStr=`Стол ${t[0]} (${ZONE[t[1]]}), ${st.g} ${guestsWord(st.g)}, ${WD[d.getDay()]} ${d.getDate()} ${MON[d.getMonth()]} в ${SLOTS[st.t]}`;
  chipTxt.textContent=bookStr;chip.classList.add('on');
  srvSel.value='Бронь столика';
  if(!msg.value.trim()||msg.dataset.auto==='1'){msg.value='Хочу забронировать: '+bookStr+'.';msg.dataset.auto='1'}
  $('#zayavka').scrollIntoView({behavior:RM?'auto':'smooth'});
  setTimeout(()=>$('#name').focus({preventScroll:true}),RM?0:600);
}
$('#bookBtn').addEventListener('click',doBook);
mbBtn.addEventListener('click',doBook);
$('#chipX').addEventListener('click',()=>{chip.classList.remove('on');bookStr='';if(msg.dataset.auto==='1'){msg.value='';msg.dataset.auto=''}});
msg.addEventListener('input',()=>{msg.dataset.auto=''});
$$('[data-srv]').forEach(a=>a.addEventListener('click',()=>{srvSel.value=a.dataset.srv;if(a.dataset.msg&&(!msg.value.trim()||msg.dataset.auto==='1')){msg.value=a.dataset.msg;msg.dataset.auto='1'}}));

/* ===== BANQUET CALC ===== */
const RATE={fur:3500,ban:4500,wed:5500};
let fmtK='ban';
const gRange=$('#gRange');
const cur={menu:180000,venue:30000,serv:18000,total:228000};
function countUp(el,from,to){
  if(RM||from===to){el.textContent=fmt(to);return}
  const t0=performance.now(),dur=650;
  const step=now=>{const p=Math.min(1,(now-t0)/dur),e=1-Math.pow(1-p,4);el.textContent=fmt(from+(to-from)*e);if(p<1)requestAnimationFrame(step)};
  requestAnimationFrame(step);
}
function calc(){
  const g=+gRange.value,rate=RATE[fmtK];
  const venue=g<=20?0:g<=60?30000:80000;
  const vl=g<=20?'Площадка: VIP-комната — включена':g<=60?'Площадка: терраса или зал':'Площадка: весь ресторан';
  const menu=g*rate,serv=menu*.1,total=menu+venue+serv;
  $('#gVal').innerHTML=g+'<small>'+guestsWord(g)+'</small>';
  $('#bGuests').textContent=g;$('#bRate').textContent=rate.toLocaleString('ru-RU').replace(/ /g,' ');
  $('#bVenueLbl').textContent=vl;
  countUp($('#bMenu'),cur.menu,menu);countUp($('#bVenue'),cur.venue,venue);countUp($('#bServ'),cur.serv,serv);countUp($('#bTotal'),cur.total,total);
  Object.assign(cur,{menu,venue,serv,total});
}
gRange.addEventListener('input',calc);
$$('.seg button').forEach(b=>b.addEventListener('click',()=>{fmtK=b.dataset.f;$$('.seg button').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));calc()}));
calc();

/* ===== GALLERY LIGHTBOX ===== */
const lb=$('#lb'),lbImg=$('#lbImg'),lbX=$('#lbX');let lastFocus=null;
function openLb(btn){lastFocus=btn;lbImg.src=btn.dataset.full;lbImg.alt=$('img',btn).alt;lb.hidden=false;document.body.style.overflow='hidden';requestAnimationFrame(()=>{lb.classList.add('on');requestAnimationFrame(()=>lbX.focus())})}
function closeLb(){lb.classList.remove('on');document.body.style.overflow='';setTimeout(()=>{lb.hidden=true;lbImg.src=''},RM?0:300);if(lastFocus)lastFocus.focus()}
$$('.gi').forEach(b=>b.addEventListener('click',()=>openLb(b)));
lbX.addEventListener('click',closeLb);
lb.addEventListener('click',e=>{if(e.target===lb)closeLb()});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(!lb.hidden)closeLb();if(mob.classList.contains('on'))closeMob()}});

/* ===== FAQ ===== */
$$('.qa button').forEach(b=>b.addEventListener('click',()=>{const on=b.getAttribute('aria-expanded')!=='true';b.setAttribute('aria-expanded',String(on));$('#'+b.getAttribute('aria-controls')).classList.toggle('on',on)}));

/* ===== FORM ===== */
const phone=$('#phone');
phone.addEventListener('input',()=>{
  let d=phone.value.replace(/\+7/,'').replace(/\D/g,'');
  if(d.length>10&&/^[78]/.test(d))d=d.slice(1);
  d=d.slice(0,10);
  let o='+7 ('+d.slice(0,3);if(d.length>3)o+=') '+d.slice(3,6);if(d.length>6)o+='-'+d.slice(6,8);if(d.length>8)o+='-'+d.slice(8,10);
  phone.value=o;
});
phone.addEventListener('focus',()=>{if(!phone.value)phone.value='+7 (';const n=phone.value.length;phone.setSelectionRange(n,n)});
phone.addEventListener('blur',()=>{if(phone.value.replace(/\D/g,'').length<=1)phone.value=''});
const form=$('#form'),ok=$('#ok');
form.addEventListener('submit',e=>{
  e.preventDefault();
  const n=$('#name'),fn=$('#fName'),fp=$('#fPhone');
  const okN=n.value.trim().length>=2,okP=phone.value.replace(/\D/g,'').length===11;
  fn.classList.toggle('bad',!okN);n.classList.toggle('err',!okN);
  fp.classList.toggle('bad',!okP);phone.classList.toggle('err',!okP);
  if(!okN){n.focus();return}if(!okP){phone.focus();return}
  $('#okSum').textContent=bookStr?bookStr:srvSel.value+(msg.value.trim()?' · '+msg.value.trim().slice(0,80):'');
  form.style.display='none';ok.classList.add('on');ok.focus();
});
$('#again').addEventListener('click',()=>{form.reset();msg.dataset.auto='';chip.classList.remove('on');bookStr='';ok.classList.remove('on');form.style.display='';$('#name').focus()});
})();
