/* sunset over the sea in Sochi (NOAA approximation), minutes after local midnight, UTC+3 */
function sunset(d){
  const N=Math.round((Date.UTC(d.getFullYear(),d.getMonth(),d.getDate())-Date.UTC(d.getFullYear(),0,0))/864e5);
  const g=2*Math.PI/365*(N-1),R=Math.PI/180,lat=43.585*R,lon=39.723;
  const eq=229.18*(.000075+.001868*Math.cos(g)-.032077*Math.sin(g)-.014615*Math.cos(2*g)-.040849*Math.sin(2*g));
  const dc=.006918-.399912*Math.cos(g)+.070257*Math.sin(g)-.006758*Math.cos(2*g)+.000907*Math.sin(2*g)-.002697*Math.cos(3*g)+.00148*Math.sin(3*g);
  const ha=Math.acos(Math.cos(90.833*R)/(Math.cos(lat)*Math.cos(dc))-Math.tan(lat)*Math.tan(dc))/R;
  return Math.round(720-4*(lon-ha)-eq+180);
}
const hm=m=>Math.floor(m/60)+':'+String(m%60).padStart(2,'0');
const slotMin=i=>{const [h,m]=SLOTS[i].split(':').map(Number);return h*60+m};
