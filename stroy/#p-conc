.obj-grid figcaption{position:absolute;left:0;right:0;bottom:0;padding:12px 14px;display:flex;justify-content:space-between;gap:12px;align-items:end;font-size:.8rem;line-height:1.3;color:var(--concrete);background:linear-gradient(transparent,rgba(20,33,43,.75));pointer-events:none}
.obj-grid figcaption b{display:block;font:500 .85rem/1.2 var(--fh);margin-bottom:3px}
.obj-grid figcaption .idx{color:var(--concrete);background:rgba(20,33,43,.6);padding:6px 8px}
/* lightbox */
.lb{position:fixed;inset:0;z-index:70;background:rgba(20,33,43,.94);display:flex;align-items:center;justify-content:center;padding:clamp(16px,4vw,48px);opacity:0;transition:opacity .25s var(--ease)}
.lb.is-open{opacity:1}
.lb[hidden]{display:none}
