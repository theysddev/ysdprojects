function calc(){
  var base=PRICE[C.tech]*C.area*FLK[C.fl];
  var box=base*.55,roof=base*.17,eng=base*.16,fin=base*.12;
  if(C.o.terrace)box+=420000;
  if(C.o.garage)box+=1100000;
  if(C.o.warm)eng+=2800*C.area;
  if(C.o.pano)box*=1.07;
  if(C.o.turnkey)fin+=15000*C.area;
  var m=MON[C.tech]+(C.area>200?Math.ceil((C.area-200)/100):0)+(C.o.turnkey?2:0)+(C.o.garage?1:0);
  return {box:box,roof:roof,eng:eng,fin:fin,total:box+roof+eng+fin,m:m};
}
function render(){
  var r=calc();
  tween(cTotal,r.total);tween(rBox,r.box,' ₽');tween(rRoof,r.roof,' ₽');tween(rEng,r.eng,' ₽');tween(rFin,r.fin,' ₽');
  rFinLab.textContent=C.o.turnkey?'Отделка под ключ':'Отделка черновая';
  cMonths.textContent='≈ '+r.m+'–'+(r.m+1)+' мес.';
  cArea.style.setProperty('--p',((C.area-60)/240*100)+'%');
}
function setArea(v,fromRange){
  v=Math.max(60,Math.min(300,Math.round(+v||60)));C.area=v;
  if(!fromRange)cArea.value=v;cAreaIn.value=v;render();
}
cArea.addEventListener('input',function(){setArea(cArea.value,true)});
cAreaIn.addEventListener('input',function(){if(cAreaIn.value!=='')setArea(cAreaIn.value)});
cAreaIn.addEventListener('blur',function(){setArea(cAreaIn.value)});
$('#cMinus').addEventListener('click',function(){setArea(C.area-10)});
$('#cPlus').addEventListener('click',function(){setArea(C.area+10)});
function segBind(id,key,attr){
  var btns=$$('#'+id+' button');
  btns.forEach(function(b){b.addEventListener('click',function(){C[key]=b.dataset[attr];btns.forEach(function(x){x.setAttribute('aria-pressed',x===b)});render()})});
  return function(v){btns.forEach(function(x){x.setAttribute('aria-pressed',x.dataset[attr]===v)});C[key]=v;render()};
}
var setTech=segBind('cTech','tech','tech');segBind('cFloors','fl','fl');
$$('#cOpts input').forEach(function(i){i.addEventListener('change',function(){C.o[i.value]=i.checked;render()})});
$$('.lnk[data-tech]').forEach(function(a){a.addEventListener('click',function(){setTech(a.dataset.tech);setHsTech(a.dataset.tech)})});
$$('#cTech button').forEach(function(b){b.addEventListener('click',function(){setHsTech(b.dataset.tech)})});
render();

/* form prefill */
var fService=$('#fService'),fMsg=$('#fMsg'),fName=$('#fName'),fPhone=$('#fPhone');
var OPT={terrace:'терраса',garage:'гараж',warm:'тёплый пол',pano:'панорамные окна',turnkey:'отделка под ключ'};
$('#cGo').addEventListener('click',function(){
  var r=calc(),ops=Object.keys(C.o).filter(function(k){return C.o[k]}).map(function(k){return OPT[k]});
  fService.value=C.tech;
  fMsg.value='Расчёт с сайта: '+TECH[C.tech].toLowerCase()+', '+C.area+' м², '+(C.fl==='1'?'1 этаж':C.fl==='2'?'2 этажа':'мансарда')+(ops.length?', опции: '+ops.join(', '):'')+'. Ориентир ≈ '+fmt(r.total)+' ₽, срок ≈ '+r.m+'–'+(r.m+1)+' мес. Прошу подготовить смету.';
  $('#contacts').scrollIntoView({behavior:RM?'auto':'smooth'});
  setTimeout(function(){fName.focus({preventScroll:true})},RM?0:600);
});
$$('.lnk[data-service]').forEach(function(a){a.addEventListener('click',function(){fService.value=a.dataset.service})});

/* phone mask */
fPhone.addEventListener('input',function(){
  var d=fPhone.value.replace(/\D/g,'');
  if(!d){fPhone.value='';return}
  if(d[0]==='8')d='7'+d.slice(1);if(d[0]!=='7')d='7'+d;d=d.slice(0,11);
  var s='+7';if(d.length>1)s+=' ('+d.slice(1,4);if(d.length>=4)s+=')';if(d.length>4)s+=' '+d.slice(4,7);if(d.length>7)s+='-'+d.slice(7,9);if(d.length>9)s+='-'+d.slice(9,11);
  fPhone.value=s;
});
/* submit */
$('#leadForm').addEventListener('submit',function(e){
  e.preventDefault();var ok=true;
  var nf=fName.closest('.f'),pf=fPhone.closest('.f');
  nf.classList.toggle('is-err',!fName.value.trim());if(!fName.value.trim())ok=false;
  var bad=fPhone.value.replace(/\D/g,'').length<11;pf.classList.toggle('is-err',bad);if(bad)ok=false;
  if(!ok){(nf.classList.contains('is-err')?fName:fPhone).focus();return}
  $('#doneName').textContent=fName.value.trim();$('#donePhone').textContent=fPhone.value;
  e.target.hidden=true;var dn=$('#formDone');dn.hidden=false;dn.focus();
});

/* faq */
var fq=$$('.faq-q');
fq.forEach(function(b){b.addEventListener('click',function(){
  var open=b.getAttribute('aria-expanded')==='true';
  fq.forEach(function(x){x.setAttribute('aria-expanded','false');$('#'+x.getAttribute('aria-controls')).hidden=true});
  if(!open){b.setAttribute('aria-expanded','true');$('#'+b.getAttribute('aria-controls')).hidden=false}
})});

/* lightbox */
var lb=$('#lb'),lbImg=$('#lbImg'),lbCap=$('#lbCap'),objs=$$('.obj'),gi=0,lastFocus=null,lbT;
function lbSet(i){gi=(i+objs.length)%objs.length;var b=objs[gi];lbImg.src=b.dataset.full;lbImg.alt=$('img',b).alt;lbCap.textContent=b.dataset.cap}
function lbOpen(i){lastFocus=document.activeElement;lbSet(i);clearTimeout(lbT);lb.hidden=false;document.body.classList.add('is-locked');requestAnimationFrame(function(){requestAnimationFrame(function(){lb.classList.add('is-open')})});$('#lbX').focus()}
function lbClose(){lb.classList.remove('is-open');document.body.classList.remove('is-locked');lbT=setTimeout(function(){lb.hidden=true;lbImg.src=''},RM?0:260);if(lastFocus)lastFocus.focus()}
objs.forEach(function(b,i){b.addEventListener('click',function(){lbOpen(i)})});
$('#lbX').addEventListener('click',lbClose);
$('#lbPrev').addEventListener('click',function(){lbSet(gi-1)});
$('#lbNext').addEventListener('click',function(){lbSet(gi+1)});
lb.addEventListener('click',function(e){if(e.target===lb)lbClose()});
addEventListener('keydown',function(e){if(lb.hidden)return;if(e.key==='Escape')lbClose();else if(e.key==='ArrowLeft')lbSet(gi-1);else if(e.key==='ArrowRight')lbSet(gi+1)});
})();
</script>
