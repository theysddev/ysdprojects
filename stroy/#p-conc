<link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600&family=Unbounded:wght@300;500;600&display=swap" rel="stylesheet">
<style>
:root{
--graphite:#14212B;--concrete:#F1F0EC;--ochre:#E8A04E;--moss:#5D7A5A;--moss-ink:#3F5A3C;--moss-lt:#8FB08A;
--ink:#14212B;--ink-2:#5B646C;--line:rgba(20,33,43,.16);--line-2:rgba(20,33,43,.08);--paper-2:#E6E4DD;
--d-ink:#F1F0EC;--d-ink-2:rgba(241,240,236,.68);--d-line:rgba(241,240,236,.16);--d-2:#1C2B37;--d-3:#243440;
--ease:cubic-bezier(.23,1,.32,1);--fh:'Unbounded',sans-serif;--fb:'Onest',sans-serif;
--wrap:1360px;--gut:clamp(16px,4vw,56px);--hh:72px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font:400 17px/1.55 var(--fb);color:var(--ink);background:var(--concrete);overflow-x:clip}
body.is-locked{overflow:hidden}
img{display:block;max-width:100%;height:auto}
a{color:inherit}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
ul,ol{list-style:none}
:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
.dark :focus-visible,.hd.is-menu :focus-visible{outline-color:var(--ochre)}
.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.wrap{max-width:var(--wrap);margin:0 auto;padding:0 var(--gut)}
section{scroll-margin-top:calc(var(--hh) + 8px)}
.sec{padding:clamp(72px,9vw,132px) 0}
.dark{background:var(--graphite);color:var(--d-ink)}
h1,h2,h3,.num{font-family:var(--fh);font-weight:500;letter-spacing:-.01em}
h1{font-size:clamp(1.75rem,1rem + 3.3vw,3.9rem);line-height:1.04;letter-spacing:-.02em}
h2{font-size:clamp(1.5rem,1rem + 2vw,2.5rem);line-height:1.1;letter-spacing:-.02em}
h3{font-size:1.1rem;line-height:1.25}
p{max-width:62ch}
.lead{color:var(--ink-2);font-size:1.02rem}
.dark .lead{color:var(--d-ink-2)}
.idx{font:600 .78rem/1 var(--fh);letter-spacing:.04em;color:var(--ink-2)}
.dark .idx{color:var(--ochre)}
/* title block */
.tb{display:grid;grid-template-columns:1fr 1fr;gap:24px 48px;align-items:end;padding-top:22px;border-top:1px solid var(--line);margin-bottom:clamp(36px,5vw,64px)}
.dark .tb{border-color:var(--d-line)}
.tb .idx{display:block;margin-bottom:14px}
.tb .lead{justify-self:end;max-width:46ch}
/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:54px;padding:0 28px;font:500 15px/1.2 var(--fb);border:1px solid transparent;text-decoration:none;white-space:nowrap;transition:transform .15s var(--ease),background-color .2s ease,color .2s ease,border-color .2s ease}
.btn:active{transform:scale(.97)}
.btn-p{background:var(--ochre);color:var(--graphite)}
.btn-o{border-color:var(--ink);color:var(--ink)}
.dark .btn-o{border-color:rgba(241,240,236,.42);color:var(--d-ink)}
.btn-s{min-height:44px;padding:0 18px;font-size:14px}
@media(hover:hover) and (pointer:fine){
.btn-p:hover{background:#F0B268}
.btn-o:hover{background:var(--ink);color:var(--concrete)}
.dark .btn-o:hover{background:var(--concrete);color:var(--ink)}
}
/* reveal */
.rv{opacity:0;transform:translateY(18px);transition:opacity .8s var(--ease),transform .8s var(--ease);transition-delay:var(--d,0ms)}
.rv.is-in{opacity:1;transform:none}
/* header */
.hd{position:fixed;inset:0 0 auto;height:var(--hh);z-index:50;transition:background-color .3s ease,box-shadow .3s ease}
.hd.is-scrolled{background:rgba(241,240,236,.82);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:0 1px 0 var(--line)}
.hd .wrap{height:100%;display:flex;align-items:center;gap:32px}
.logo{display:flex;align-items:center;gap:12px;text-decoration:none;font:600 1.05rem/1 var(--fh);letter-spacing:.06em}
.logo svg{width:30px;height:30px;flex:none}
.logo small{display:block;font:400 .68rem/1.2 var(--fb);letter-spacing:0;color:var(--ink-2);margin-top:4px}
.nav{display:flex;gap:4px;margin-left:auto}
.nav a{display:inline-flex;align-items:center;min-height:44px;padding:0 12px;font-size:.92rem;font-weight:500;text-decoration:none;color:var(--ink);position:relative}
.nav a::after{content:'';position:absolute;left:12px;right:12px;bottom:8px;height:1px;background:var(--ink);transform:scaleX(0);transform-origin:left;transition:transform .35s var(--ease)}
@media(hover:hover) and (pointer:fine){.nav a:hover::after{transform:scaleX(1)}}
.hd-tel{font-weight:500;text-decoration:none;white-space:nowrap;display:inline-flex;align-items:center;min-height:44px}
.burger{display:none;width:48px;height:48px;margin-left:auto;align-items:center;justify-content:center;flex-direction:column;gap:6px}
.burger span{display:block;width:24px;height:2px;background:var(--ink);transition:transform .35s var(--ease),opacity .2s ease}
.burger[aria-expanded="true"] span:nth-child(1){transform:translateY(8px) rotate(45deg)}
.burger[aria-expanded="true"] span:nth-child(2){opacity:0}
.burger[aria-expanded="true"] span:nth-child(3){transform:translateY(-8px) rotate(-45deg)}
.mnav{position:fixed;inset:0;z-index:40;background:var(--graphite);color:var(--d-ink);padding:calc(var(--hh) + 24px) var(--gut) 40px;display:flex;flex-direction:column;visibility:hidden;opacity:0;transform:translateY(-12px);transition:opacity .3s var(--ease),transform .3s var(--ease),visibility 0s .3s}
.mnav.is-open{visibility:visible;opacity:1;transform:none;transition-delay:0s}
.mnav a{text-decoration:none}
.mnav nav a{display:block;font:500 1.55rem/1.2 var(--fh);padding:14px 0;border-bottom:1px solid var(--d-line)}
.mnav-foot{margin-top:auto;display:grid;gap:14px;color:var(--d-ink-2)}
.mnav-foot .btn{align-self:start}
.hd.is-menu{background:var(--graphite);box-shadow:none}
.hd.is-menu .logo,.hd.is-menu .hd-tel{color:var(--d-ink)}
.hd.is-menu .logo small{color:var(--d-ink-2)}
.hd.is-menu .burger span{background:var(--d-ink)}
/* hero */
.hero{padding:calc(var(--hh) + clamp(32px,6vw,80px)) 0 clamp(56px,7vw,96px)}
.hero-g{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:clamp(32px,5vw,80px);align-items:center}
.hero-k{font-size:.95rem;color:var(--ink-2);display:flex;align-items:center;gap:12px;margin-bottom:28px}
.hero-k::before{content:'';width:34px;height:1px;background:var(--ink)}
.hero h1{margin-bottom:24px;max-width:14ch;font-size:clamp(1.7rem,.9rem + 2.9vw,3.3rem);overflow-wrap:anywhere;hyphens:manual}
.hero .lead{font-size:1.08rem;margin-bottom:34px;max-width:50ch}
.hero-cta{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:44px}
.facts3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;padding-top:26px;border-top:1px solid var(--line)}
.facts3 li{display:grid;gap:10px;font-size:.9rem;line-height:1.35;color:var(--ink-2)}
.facts3 svg{width:26px;height:26px;color:var(--ink)}
.facts3 b{display:block;font-weight:500;color:var(--ink)}
.hero-fig{position:relative;margin:14px 14px 14px 0}
.hero-fig::before{content:'';position:absolute;inset:-14px;border:1px solid var(--line);pointer-events:none}
.hero-fig img{width:100%;aspect-ratio:5/6;object-fit:cover;background:var(--paper-2)}
.mark{position:absolute;width:12px;height:12px;pointer-events:none}
.mark::before,.mark::after{content:'';position:absolute;background:var(--ink)}
.mark::before{width:12px;height:1px;top:0}.mark::after{width:1px;height:12px;left:0}
.mk-tl{top:-14px;left:-14px}.mk-tr{top:-14px;right:-14px;transform:scaleX(-1)}
.mk-bl{bottom:-14px;left:-14px;transform:scaleY(-1)}.mk-br{bottom:-14px;right:-14px;transform:scale(-1)}
.plate{position:absolute;background:var(--concrete);padding:14px 18px;display:grid;gap:6px;font-size:.84rem;line-height:1.3;box-shadow:0 1px 0 var(--line),0 24px 48px -24px rgba(20,33,43,.45);will-change:transform;animation:float 7s ease-in-out infinite}
.plate b{font:500 .95rem/1.2 var(--fh)}
.plate-1{top:8%;left:-10%;min-width:200px}
.plate-2{bottom:9%;right:-8%;min-width:210px;animation-duration:8.5s;animation-delay:-4s}
.plate .st{display:flex;align-items:center;gap:8px;color:var(--moss-ink);font-weight:500}
.plate .st::before{content:'';width:8px;height:8px;border-radius:50%;background:var(--moss)}
.bar{height:3px;background:var(--line-2);position:relative;overflow:hidden}
.bar::after{content:'';position:absolute;inset:0;background:var(--moss);transform:scaleX(.55);transform-origin:left}
.plate .mut{color:var(--ink-2)}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
/* marquee */
.mq{background:var(--ochre);color:var(--graphite);overflow:hidden;padding:16px 0;border-top:1px solid rgba(20,33,43,.15)}
.mq-track{display:flex;width:max-content;will-change:transform;animation:mq 46s linear infinite}
.mq:hover .mq-track{animation-play-state:paused}
.mq-track span{display:inline-flex;align-items:center;gap:26px;padding-right:26px;font:500 .98rem/1 var(--fh);white-space:nowrap}
.mq-track span::after{content:'';width:8px;height:8px;background:var(--graphite)}
@keyframes mq{to{transform:translateX(-50%)}}
/* facts big */
.facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}
.facts li{background:var(--concrete);padding:clamp(24px,3vw,40px) clamp(18px,2.5vw,32px)}
.facts .num{display:block;font-size:clamp(2.5rem,1.6rem + 3.8vw,5.4rem);font-weight:300;line-height:1;letter-spacing:-.03em;margin-bottom:14px}
.facts .num i{font:inherit;font-size:.42em;letter-spacing:0;margin-left:.1em}
.facts b{display:block;font-weight:500;margin-bottom:4px}
.facts small{color:var(--ink-2);font-size:.88rem;line-height:1.4;display:block}
/* services */
.sv-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}
.sv-grid.four{grid-template-columns:repeat(4,minmax(0,1fr));margin-top:1px;border-top:0}
.sv h3{overflow-wrap:anywhere}
.sv{background:var(--concrete);display:flex;flex-direction:column;position:relative}
.sv-ph{position:relative;overflow:hidden;aspect-ratio:4/3;background:var(--paper-2)}
.sv-ph img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s var(--ease)}
@media(hover:hover) and (pointer:fine){.sv:hover .sv-ph img{transform:scale(1.045)}}
.sv-ph .idx{position:absolute;top:12px;left:12px;background:var(--concrete);color:var(--ink);padding:8px 10px}
.sv-b{padding:22px 22px 24px;display:flex;flex-direction:column;flex:1}
.sv h3{margin-bottom:12px}
.sv ul{color:var(--ink-2);font-size:.93rem;display:grid;gap:5px;margin-bottom:22px}
.sv ul li{padding-left:16px;position:relative}
.sv ul li::before{content:'';position:absolute;left:0;top:.66em;width:7px;height:1px;background:var(--ink)}
.sv-f{margin-top:auto;display:flex;align-items:end;justify-content:space-between;gap:12px;padding-top:16px;border-top:1px solid var(--line-2)}
.price{font:500 1rem/1.2 var(--fh)}
.price small{display:block;font:400 .78rem/1.2 var(--fb);color:var(--ink-2);margin-bottom:4px}
.lnk{font-size:.9rem;font-weight:500;text-decoration:underline;text-underline-offset:4px;text-decoration-color:var(--line);min-height:44px;display:inline-flex;align-items:center;transition:text-decoration-color .2s ease}
@media(hover:hover) and (pointer:fine){.lnk:hover{text-decoration-color:var(--ink)}}
.dark .lnk{text-decoration-color:var(--d-line)}
/* house section */
.hs{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.85fr);gap:clamp(28px,4vw,64px);align-items:start}
.hs-stage{position:relative;background:var(--d-2);border:1px solid var(--d-line);padding:clamp(12px,2vw,28px)}
.hs-svgw{position:relative}
.hs-svg{width:100%;height:auto;display:block;overflow:visible}
.hs-layer{cursor:pointer;transition:opacity .5s var(--ease)}
.hs-svg.is-focus .hs-layer:not(.is-on){opacity:.42}
.hs-svg .hs-layer.is-ghost,.hs-svg.is-focus .hs-layer.is-ghost:not(.is-on){opacity:.12}
.hs-svg .hs-layer.is-ghost.is-on{opacity:.55}
.hs-layer.is-ghost .hs-edge{stroke-dasharray:4 5}
.hs-layer.is-build .hs-edge{stroke:var(--ochre);stroke-width:1.6;stroke-dasharray:7 5;animation:ants 1.1s linear infinite}
@keyframes ants{to{stroke-dashoffset:-24}}
.hs-stamp{opacity:0;transform:translate(8px,72px) rotate(-6deg) scale(1.25);transform-box:view-box;transition:opacity .35s ease,transform .5s var(--ease)}
.hs-stamp.is-on{opacity:1;transform:translate(8px,72px) rotate(-6deg)}
.hs-stamp rect{fill:none;stroke:var(--ochre);stroke-width:1.5}
.hs-stamp text{font:600 12px var(--fh);fill:var(--ochre)}
.hs-stamp .s2{font:400 11px var(--fb);fill:var(--d-ink-2)}
.hs-layer .hs-edge{stroke:rgba(241,240,236,.5);stroke-width:1.2;vector-effect:non-scaling-stroke}
.hs-layer.is-on .hs-edge{stroke:var(--ochre);stroke-width:1.6}
.hs-layer.is-on .hs-glow{opacity:1}
.hs-glow{opacity:0;transition:opacity .4s var(--ease);pointer-events:none}
.hs-ax{font:500 11px var(--fh);fill:var(--d-ink)}
.hs-dim{font:400 11px var(--fb);fill:var(--d-ink-2)}
.dot{position:absolute;width:44px;height:44px;margin:-22px 0 0 -22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font:600 .72rem/1 var(--fh);color:var(--d-ink);background:rgba(20,33,43,.6);border:1px solid rgba(241,240,236,.6);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);transition:transform .2s var(--ease),background-color .2s ease,color .2s ease,border-color .2s ease}
.dot::after{content:'';position:absolute;inset:-1px;border-radius:50%;border:1px solid var(--ochre);opacity:0}
.dot[aria-pressed="true"]{background:var(--ochre);color:var(--graphite);border-color:var(--ochre)}
.dot[aria-pressed="true"]::after{animation:pulse 2.4s var(--ease) infinite}
@keyframes pulse{0%{transform:scale(1);opacity:.9}100%{transform:scale(1.9);opacity:0}}
@media(hover:hover) and (pointer:fine){.dot:hover{transform:scale(1.08)}}
.dot:active{transform:scale(.94)}
.dot.is-ghost:not([aria-pressed="true"]){border-style:dashed;color:var(--d-ink-2)}
/* build scrubber */
.hs-build{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 18px;align-items:center;margin-top:clamp(12px,2vw,24px);padding:14px 18px 10px 14px;border:1px solid var(--d-line);background:rgba(20,33,43,.4)}
.hs-play{grid-row:span 2;width:52px;height:52px;border-radius:50%;border:1px solid var(--ochre);color:var(--ochre);display:grid;place-items:center;transition:background-color .2s ease,color .2s ease,transform .15s var(--ease)}
.hs-play svg{width:18px;height:18px}
.hs-play .i-pause,.hs-play[aria-pressed="true"] .i-play{display:none}
.hs-play[aria-pressed="true"] .i-pause{display:block}
.hs-play[aria-pressed="true"]{background:var(--ochre);color:var(--graphite)}
.hs-play:active{transform:scale(.94)}
@media(hover:hover) and (pointer:fine){.hs-play:not([aria-pressed="true"]):hover{background:rgba(232,160,78,.14)}}
.hs-now{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 12px;min-height:1.4em}
.hs-now b{font:500 1rem/1.25 var(--fh);color:var(--d-ink)}
.hs-now span{font-size:.86rem;color:var(--d-ink-2)}
.hs-trk{min-width:0}
.hs-build .rng{height:34px}
.dark .rng::-webkit-slider-runnable-track{background:linear-gradient(var(--ochre),var(--ochre)) 0/var(--p,100%) 100% no-repeat,var(--d-line)}
.dark .rng::-moz-range-track{background:var(--d-line)}
.dark .rng::-moz-range-progress{background:var(--ochre)}
.dark .rng:focus-visible{outline-color:var(--ochre)}
.hs-ticks{display:flex;justify-content:space-between;gap:4px;font-size:.72rem;line-height:1.2;color:var(--d-ink-2);margin:-2px -6px 0}
.hs-ticks span{flex:1;text-align:center;transition:color .3s ease}
.hs-ticks span:first-child{text-align:left}.hs-ticks span:last-child{text-align:right}
.hs-ticks span.is-on{color:var(--ochre)}
.hs-leg{display:grid;grid-template-columns:repeat(6,1fr);gap:1px;background:var(--d-line);border:1px solid var(--d-line);margin-top:clamp(12px,2vw,24px)}
.hs-leg button{min-width:0;overflow-wrap:anywhere;background:var(--d-2);min-height:48px;padding:8px 6px;display:grid;gap:4px;justify-items:center;font-size:.8rem;line-height:1.2;color:var(--d-ink-2);transition:background-color .2s ease,color .2s ease}
.hs-leg button .idx{color:var(--ochre)}
.hs-leg button[aria-pressed="true"]{background:var(--d-3);color:var(--d-ink)}
.hs-card{background:var(--d-2);border:1px solid var(--d-line);padding:clamp(22px,3vw,34px);position:sticky;top:calc(var(--hh) + 16px)}
.hs-card-in{animation:cardin .4s var(--ease)}
@keyframes cardin{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.hs-card .idx{display:block;margin-bottom:12px}
.hs-card h3{font-size:1.45rem;margin-bottom:22px}
.hs-row{padding:16px 0;border-top:1px solid var(--d-line);display:grid;grid-template-columns:96px 1fr;gap:12px;font-size:.95rem}
.hs-row dt{color:var(--d-ink-2)}
.hs-row dd ul{display:grid;gap:6px}
.hs-row dd li{padding-left:14px;position:relative}
.hs-row dd li::before{content:'';position:absolute;left:0;top:.7em;width:6px;height:1px;background:var(--ochre)}
.hs-dur{display:inline-flex;align-items:center;gap:8px;color:var(--moss-lt);font-weight:500}
.hs-dur::before{content:'';width:8px;height:8px;border-radius:50%;background:var(--moss)}
.seg{display:flex;border:1px solid var(--line)}
.seg button{flex:1;min-width:0;min-height:50px;padding:0 10px;font-size:.92rem;font-weight:500;transition:background-color .2s ease,color .2s ease}
.seg button+button{border-left:1px solid var(--line)}
.seg button[aria-pressed="true"]{background:var(--graphite);color:var(--concrete)}
.dark .seg{border-color:var(--d-line)}
.dark .seg button+button{border-color:var(--d-line)}
.dark .seg button[aria-pressed="true"]{background:var(--ochre);color:var(--graphite)}
.hs-tech{margin-top:24px}
.hs-tech .lab{display:block;font-size:.85rem;color:var(--d-ink-2);margin-bottom:10px}
/* calculator */
.calc{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:clamp(28px,4vw,64px);align-items:start}
.fld{padding:26px 0;border-top:1px solid var(--line)}
.fld:first-child{border-top:0;padding-top:0}
.fld>.lab{display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-weight:500;margin-bottom:16px}
.fld>.lab small{font-weight:400;color:var(--ink-2);font-size:.85rem}
.area{display:grid;grid-template-columns:48px 1fr 48px;gap:10px;align-items:center;margin-bottom:18px}
.area button{height:48px;border:1px solid var(--ink);font:400 1.4rem/1 var(--fb);transition:background-color .2s ease,color .2s ease,transform .15s var(--ease)}
.area button:active{transform:scale(.95)}
@media(hover:hover) and (pointer:fine){.area button:hover{background:var(--ink);color:var(--concrete)}}
.area-in{display:flex;align-items:baseline;justify-content:center;gap:6px;border-bottom:1px solid var(--ink);height:48px}
.area-in input{width:5ch;text-align:center;font:300 1.9rem/1 var(--fh);border:0;background:none;color:var(--ink);letter-spacing:-.02em;-moz-appearance:textfield}
.area-in input::-webkit-outer-spin-button,.area-in input::-webkit-inner-spin-button{-webkit-appearance:none}
.area-in span{color:var(--ink-2)}
.rng{-webkit-appearance:none;appearance:none;width:100%;height:44px;background:none;cursor:pointer;display:block}
.rng::-webkit-slider-runnable-track{height:2px;background:linear-gradient(var(--ink),var(--ink)) 0/var(--p,50%) 100% no-repeat,var(--line)}
.rng::-moz-range-track{height:2px;background:var(--line)}
.rng::-moz-range-progress{height:2px;background:var(--ink)}
.rng::-webkit-slider-thumb{-webkit-appearance:none;width:24px;height:24px;margin-top:-11px;border-radius:50%;background:var(--ochre);border:2px solid var(--graphite);transition:transform .15s var(--ease)}
.rng::-moz-range-thumb{width:20px;height:20px;border-radius:50%;background:var(--ochre);border:2px solid var(--graphite)}
.rng:active::-webkit-slider-thumb{transform:scale(1.15)}
.rng-scale{display:flex;justify-content:space-between;font-size:.8rem;color:var(--ink-2);margin-top:2px}
.opts{display:grid;grid-template-columns:repeat(2,1fr);gap:8px 20px}
.opt{display:flex;align-items:center;gap:12px;min-height:48px;cursor:pointer;position:relative;font-size:.95rem}
.opt input{position:absolute;opacity:0;width:1px;height:1px}
.opt i{flex:none;width:22px;height:22px;border:1px solid var(--ink);display:grid;place-items:center;transition:background-color .2s ease}
.opt i::after{content:'';width:10px;height:5px;border:2px solid var(--graphite);border-top:0;border-right:0;transform:rotate(-45deg) scale(0);transition:transform .2s var(--ease)}
.opt input:checked+i{background:var(--ochre);border-color:var(--ochre)}
.opt input:checked+i::after{transform:rotate(-45deg) translateY(-1px) scale(1)}
.opt input:focus-visible+i{outline:2px solid var(--ink);outline-offset:3px}
.opt small{color:var(--ink-2);display:block;font-size:.8rem}
.res{background:var(--graphite);color:var(--d-ink);padding:clamp(24px,3vw,36px);position:sticky;top:calc(var(--hh) + 16px)}
.res .lab{color:var(--d-ink-2);font-size:.9rem;margin-bottom:10px;display:block}
.res .tot{font:300 clamp(2rem,1.4rem + 2.4vw,3.2rem)/1 var(--fh);letter-spacing:-.03em;margin-bottom:26px;white-space:nowrap}
.res .tot i{font-style:normal;font-size:.55em}
.rows{border-top:1px solid var(--d-line);margin-bottom:22px}
.rows div{display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid var(--d-line);font-size:.95rem}
.rows div span:last-child{font-family:var(--fh);font-weight:500;font-size:.88rem;white-space:nowrap}
.rows .mu{color:var(--d-ink-2)}
.res-m{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:20px}
.res-m b{font:500 1.3rem/1 var(--fh)}
.res .note{font-size:.84rem;color:var(--d-ink-2);margin-bottom:22px;max-width:none}
.res .btn{width:100%}
/* stages */
.stg{position:relative;display:grid;grid-template-columns:repeat(5,1fr);gap:0 28px;padding-top:34px}
.stg::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:var(--line)}
.stg-line{position:absolute;top:0;left:0;right:0;height:1px;background:var(--ink);transform:scaleX(0);transform-origin:left;transition:transform 1.8s var(--ease)}
.is-in>.stg-line{transform:scaleX(1)}
.stg li{position:relative;opacity:0;transform:translateY(14px);transition:opacity .6s var(--ease),transform .6s var(--ease);transition-delay:calc(var(--i)*.28s + .2s)}
.is-in li{opacity:1;transform:none}
.stg li::before{content:'';position:absolute;top:-39px;left:0;width:9px;height:9px;background:var(--ink);border-radius:50%}
.stg .idx{display:block;margin-bottom:14px}
.stg h3{margin-bottom:10px;font-size:1.02rem}
.stg p{font-size:.92rem;color:var(--ink-2)}
/* timeline */
.tl-wrap{overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x proximity;padding-bottom:12px;scrollbar-width:thin;scrollbar-color:var(--d-line) transparent}
.tl{display:grid;grid-template-columns:repeat(8,1fr);width:max(100%,1248px);position:relative;padding-top:46px}
.tl::before{content:'';position:absolute;top:28px;left:0;right:0;height:1px;background:var(--d-line)}
.tl-line{position:absolute;top:28px;left:0;right:0;height:1px;background:var(--ochre);transform:scaleX(0);transform-origin:left;transition:transform 2.4s var(--ease)}
.is-in>.tl-line{transform:scaleX(1)}
.tl li{scroll-snap-align:start;position:relative;padding:0 20px 0 0;opacity:0;transform:translateY(12px);transition:opacity .6s var(--ease),transform .6s var(--ease);transition-delay:calc(var(--i)*.26s + .15s)}
.is-in li{opacity:1;transform:none}
.tl li::before{content:'';position:absolute;top:-22px;left:0;width:9px;height:9px;background:var(--ochre);border-radius:50%}
.tl li::after{content:'';position:absolute;top:-18px;left:4px;width:1px;height:18px;background:var(--d-line)}
.tl .num{display:block;font-size:2rem;font-weight:300;line-height:1;margin-bottom:12px}
.tl .num i{font-style:normal;font-size:.42em;color:var(--d-ink-2);margin-left:4px}
.tl h3{font-size:.98rem;margin-bottom:8px}
.tl p{font-size:.88rem;color:var(--d-ink-2)}
.tl-note{margin-top:28px;font-size:.88rem;color:var(--d-ink-2);display:flex;gap:10px;align-items:baseline}
.tl-note::before{content:'';flex:none;width:8px;height:8px;background:var(--ochre);transform:translateY(-1px)}
/* objects */
.obj-grid{display:grid;grid-template-columns:3fr 2fr 2fr;grid-auto-rows:clamp(180px,22vw,300px);gap:1px;background:var(--line);border:1px solid var(--line)}
.obj-grid figure{position:relative;overflow:hidden;background:var(--paper-2);margin:0}
.obj-grid figure:nth-child(1){grid-row:span 2}
.obj-grid figure:nth-child(4){grid-column:2/4}
.obj-grid figure:nth-child(5){grid-column:1/3}
.obj{display:block;width:100%;height:100%;padding:0;overflow:hidden;position:relative}
.obj img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s var(--ease)}
