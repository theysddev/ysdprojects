.ct .big{font:500 1.25rem/1.2 var(--fh)}
.map{position:relative;margin-top:28px;aspect-ratio:16/10;overflow:hidden;border:1px solid var(--d-line);background-color:var(--d-2);background-image:linear-gradient(var(--d-line) 1px,transparent 1px),linear-gradient(90deg,var(--d-line) 1px,transparent 1px);background-size:40px 40px}
.map svg{position:absolute;inset:0;width:100%;height:100%}
.map-pin{position:absolute;left:50%;top:50%;transform:translate(-50%,-100%);display:grid;justify-items:center;gap:4px}
.map-pin span{background:var(--ochre);color:var(--graphite);font-size:.8rem;font-weight:500;padding:8px 12px;white-space:nowrap}
.map-pin i{width:14px;height:14px;border-radius:50%;background:var(--ochre);border:3px solid var(--graphite);box-shadow:0 0 0 1px var(--ochre)}
.map-lab{position:absolute;left:14px;bottom:12px;font-size:.78rem;color:var(--d-ink-2)}
