<style>
:root{--bg:#0C0D14;--bg2:#13141E;--ink:#EDECF7;--mut:#A6A5BA;--acc:#A78BFA;--v:#5B4BFF;--v2:#9B5CFF;--v3:#7B3FE6;--lt:#F4F3FA;--lt2:#FFFFFF;--inkL:#15131F;--mutL:#5B5970;--line:rgba(255,255,255,.09);--glass:rgba(255,255,255,.04);--e:cubic-bezier(.23,1,.32,1);--r:20px;--w:1200px;--hd:76px}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--hd) + 12px);-webkit-text-size-adjust:100%;overflow-x:clip}
body{font-family:Onest,system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.55;font-size:16px;overflow-x:hidden;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%;height:auto}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
ul{list-style:none}
svg{display:block}
.wrap{width:min(var(--w),100% - 40px);margin-inline:auto}
.mono{font-family:"JetBrains Mono",ui-monospace,monospace}
.h1,.h2,.h3{font-family:Unbounded,sans-serif;font-weight:600;letter-spacing:-.015em;line-height:1.1;text-wrap:balance}
.h1{font-size:clamp(1.75rem,1rem + 3.3vw,4rem);font-weight:600}
.h2{font-size:clamp(1.5rem,1rem + 1.9vw,2.6rem);margin-bottom:14px}
.h3{font-size:1.1rem;font-weight:500;line-height:1.3}
.h1 em,.h2 em{font-style:normal;background:linear-gradient(92deg,#B9A4FF 0%,#A78BFA 45%,#7C8CFF 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.lt .h2 em{background:linear-gradient(92deg,#5B4BFF,#8B3FE6);-webkit-background-clip:text;background-clip:text}
.idx{display:block;font-family:"JetBrains Mono",monospace;font-size:.8rem;color:var(--acc);margin-bottom:14px;letter-spacing:.01em}
.lt .idx{color:var(--v)}
.mut{color:var(--mut)}
.lt .mut{color:var(--mutL)}
.lead{font-size:1.1rem;max-width:58ch}
section{position:relative;padding:clamp(72px,9vw,120px) 0}
.lt{background:var(--lt);color:var(--inkL)}
.sh{display:grid;grid-template-columns:1fr;gap:12px;margin-bottom:clamp(36px,5vw,56px)}
@media(min-width:900px){.sh{grid-template-columns:1.1fr .9fr;gap:40px;align-items:end}.sh p{padding-bottom:6px}}

/* glows */
.glow{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:0}
.glow i{position:absolute;border-radius:50%;filter:blur(70px);opacity:.55}
.glow .a{width:60vw;height:60vw;max-width:800px;max-height:800px;left:-18vw;top:-20vw;background:radial-gradient(circle,rgba(91,75,255,.65),rgba(91,75,255,0) 70%)}
.glow .b{width:50vw;height:50vw;max-width:700px;max-height:700px;right:-14vw;top:10%;background:radial-gradient(circle,rgba(155,92,255,.5),rgba(155,92,255,0) 70%)}
section>.wrap{position:relative;z-index:1}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 24px;border-radius:14px;font-weight:600;font-size:.98rem;transition:transform .2s var(--e),background-color .2s ease,border-color .2s ease;position:relative;white-space:nowrap}
.btn:active{transform:scale(.97)}
.btn .ar{width:18px;height:18px;transition:transform .3s var(--e)}
.btn-p{background:linear-gradient(135deg,var(--v),var(--v3));color:#fff;box-shadow:0 10px 30px -10px rgba(91,75,255,.6)}
.btn-s{background:var(--glass);border:1px solid var(--line);color:var(--ink)}
.lt .btn-s{background:#fff;border-color:rgba(21,19,31,.12);color:var(--inkL)}
@media(hover:hover) and (pointer:fine){.btn-p:hover{background:linear-gradient(135deg,#6C5CFF,#8A4FF2)}.btn-s:hover{border-color:rgba(167,139,250,.5)}.lt .btn-s:hover{border-color:var(--v)}.btn:hover .ar{transform:translate(3px,-3px)}}
:focus-visible{outline:2px solid var(--acc);outline-offset:3px;border-radius:6px}
.lt :focus-visible{outline-color:var(--v)}

/* header */
.hd{position:fixed;inset:0 0 auto 0;height:var(--hd);z-index:50;transition:background-color .3s ease,border-color .3s ease}
.hd.sc{background:rgba(12,13,20,.72);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.hd .wrap{display:flex;align-items:center;gap:clamp(10px,2vw,28px);height:100%;min-width:0}.hd .wrap>*{flex-shrink:0}.hd .logo{white-space:nowrap}
.logo{display:flex;align-items:center;gap:10px;font-family:Unbounded,sans-serif;font-weight:600;font-size:1.05rem;letter-spacing:-.01em}
.logo svg{width:34px;height:34px}
.logo small{display:none;font-family:Onest,system-ui,sans-serif;font-weight:500;font-size:.72rem;color:var(--mut);letter-spacing:0}
.nav{display:none;gap:4px;margin-left:auto}
.nav a{padding:10px 12px;border-radius:10px;font-size:.92rem;color:var(--mut);transition:color .2s ease,background-color .2s ease}
@media(hover:hover) and (pointer:fine){.nav a:hover{color:var(--ink);background:var(--glass)}}
.hd .tel{display:none;font-weight:600;font-size:.95rem;padding:10px 4px}
.hd .btn{min-height:44px;padding:0 clamp(10px,2.5vw,18px);font-size:.9rem;margin-left:auto;white-space:nowrap}
.burger{width:44px;height:44px;display:grid;place-items:center;border-radius:12px;border:1px solid var(--line);background:var(--glass)}
.burger span{display:block;width:20px;height:2px;background:var(--ink);position:relative;transition:transform .3s var(--e)}
.burger span::before,.burger span::after{content:"";position:absolute;left:0;width:20px;height:2px;background:var(--ink);transition:transform .3s var(--e)}
.burger span::before{top:-6px}.burger span::after{top:6px}
.burger[aria-expanded=true] span{background:transparent}
.burger[aria-expanded=true] span::before{transform:translateY(6px) rotate(45deg)}
.burger[aria-expanded=true] span::after{transform:translateY(-6px) rotate(-45deg)}
@media(max-width:479px){.hd .btn{display:none}.burger{margin-left:auto}}
@media(min-width:1100px){.nav{display:flex}.hd .btn{margin-left:0}.burger{display:none}}
@media(min-width:1100px) and (max-width:1359px){.hd .wrap{gap:14px}.nav{gap:0}.nav a{padding:10px 8px;font-size:.9rem}}
@media(min-width:1360px){.hd .wrap{gap:22px}.nav{gap:0}.nav a{padding:10px 10px}.hd .tel{display:block;white-space:nowrap}}
.mnav{position:fixed;inset:var(--hd) 0 0 0;background:rgba(12,13,20,.96);z-index:49;display:flex;flex-direction:column;padding:24px 20px;gap:4px;transform:translateY(-12px);opacity:0;visibility:hidden;transition:opacity .3s var(--e),transform .3s var(--e),visibility .3s}
.mnav.on{opacity:1;transform:none;visibility:visible}
.mnav a{padding:14px 12px;font-family:Unbounded,sans-serif;font-weight:500;font-size:1.25rem;border-bottom:1px solid var(--line)}
.mnav .tel{font-family:Onest,system-ui,sans-serif;font-size:1.1rem;border:0;color:var(--acc);margin-top:8px}
.mnav .btn{margin-top:12px}

/* hero */
.hero{padding:calc(var(--hd) + 40px) 0 60px;overflow:hidden}
.hero .wrap{display:grid;gap:48px}
@media(min-width:960px){.hero{padding:calc(var(--hd) + 64px) 0 90px;min-height:100svh;display:flex;align-items:center}.hero .wrap{grid-template-columns:1.05fr .95fr;align-items:center;gap:56px}}
.hero .lead{margin:22px 0 32px}
.cta{display:flex;flex-wrap:wrap;gap:12px}
.facts{display:grid;gap:14px;margin-top:44px;padding-top:28px;border-top:1px solid var(--line)}
@media(min-width:560px){.facts{grid-template-columns:repeat(3,1fr);gap:20px}}
.facts li{display:flex;gap:12px;align-items:flex-start;font-size:.92rem;color:var(--mut)}
.facts b{display:block;color:var(--ink);font-weight:600;margin-bottom:2px}
.facts svg{width:22px;height:22px;flex:none;color:var(--acc);margin-top:2px}
.hv{position:relative;padding:0 0 110px 0}
@media(min-width:960px){.hv{padding:0 0 70px 30px}}
.hv .ph{position:relative;border-radius:28px;overflow:hidden;aspect-ratio:4/5;max-height:620px;border:1px solid var(--line);background:var(--bg2);will-change:transform}
.hv .ph img{width:100%;height:100%;object-fit:cover}
.hv .ph::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(12,13,20,0) 50%,rgba(12,13,20,.55))}
.plate{position:absolute;display:flex;align-items:center;gap:10px;padding:12px 16px;border-radius:14px;background:rgba(19,20,30,.78);border:1px solid rgba(255,255,255,.12);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);font-size:.85rem;font-weight:500;box-shadow:0 20px 40px -20px rgba(0,0,0,.6);animation:float 6s var(--e) infinite alternate;z-index:2}
.plate small{display:block;font-weight:400;color:var(--mut);font-size:.76rem}
.p1{top:22px;right:-8px}
.p2{top:46%;left:-12px;animation-delay:-3s}
@media(min-width:960px){.p1{right:-28px;top:38px}.p2{left:-40px}}
.dot{width:9px;height:9px;border-radius:50%;background:#34D399;position:relative;flex:none}
.dot::after{content:"";position:absolute;inset:-4px;border-radius:50%;border:2px solid #34D399;animation:pulse 1.8s ease-out infinite}
.ok-i{width:22px;height:22px;color:var(--acc);flex:none}
@keyframes float{to{transform:translateY(-12px)}}
@keyframes pulse{to{transform:scale(1.9);opacity:0}}
.term{position:absolute;left:0;right:0;bottom:0;border-radius:18px;background:rgba(13,14,22,.92);border:1px solid rgba(255,255,255,.12);box-shadow:0 30px 60px -30px rgba(0,0,0,.8),0 0 0 1px rgba(91,75,255,.15);font-family:"JetBrains Mono",monospace;font-size:.78rem;line-height:1.7;overflow:hidden;z-index:3}
@media(min-width:960px){.term{left:-24px;right:36px;bottom:-10px;font-size:.82rem}}
@media(min-width:1200px){.term{left:-40px}}
.tb{display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--line);color:var(--mut);font-size:.72rem}
.tb i{width:10px;height:10px;border-radius:50%;background:#3A3B4A}
.tb i:nth-child(1){background:#FF5F57}.tb i:nth-child(2){background:#FEBC2E}.tb i:nth-child(3){background:#28C840}
.tb span{margin-left:8px}
.tc{padding:14px 16px 16px;min-height:118px;white-space:pre-wrap;word-break:break-word}
.ln{display:block;min-height:1.7em}
.k{color:#C4B5FD}.f{color:#8FB4FF}.s{color:#9AE6B4}.p{color:#B7B6C9}.c{color:#7A7990;font-style:italic}.v{color:#EDECF7}
.cur{display:inline-block;width:8px;height:1.1em;background:var(--acc);vertical-align:-3px;margin-left:2px;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
.hero .hi{opacity:0;transform:translateY(18px);animation:up .9s var(--e) forwards}
.hero .hi:nth-child(2){animation-delay:.1s}.hero .hi:nth-child(3){animation-delay:.2s}.hero .hi:nth-child(4){animation-delay:.3s}.hero .hi:nth-child(5){animation-delay:.4s}
.hero .hv{opacity:0;animation:up 1s var(--e) .25s forwards}
@keyframes up{to{opacity:1;transform:none}}

/* marquee */
.mq-w{position:relative;z-index:2;overflow:hidden;padding:24px 0;margin:-14px 0 -34px}
.mq{position:relative;overflow:hidden;background:linear-gradient(90deg,var(--v),var(--v3));color:#fff;padding:16px 0;transform:rotate(-1deg) scale(1.02)}
.mq .tr{display:flex;width:max-content;animation:mq 42s linear infinite}
.mq:hover .tr{animation-play-state:paused}
.mq span{display:inline-flex;align-items:center;gap:22px;padding-right:22px;font-family:Unbounded,sans-serif;font-weight:500;font-size:.9rem;white-space:nowrap}
.mq span i{font-family:"JetBrains Mono",monospace;font-style:normal;opacity:.6;font-size:.85rem}
@keyframes mq{to{transform:translateX(-50%)}}

/* reveal */
.rv{opacity:0;transform:translateY(24px);transition:opacity .75s var(--e),transform .75s var(--e);transition-delay:calc(var(--i,0)*90ms)}
.rv.in{opacity:1;transform:none}

/* formats */
.fmt{display:grid;gap:18px}
@media(min-width:640px){.fmt{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1100px){.fmt{grid-template-columns:repeat(4,1fr)}}
.card{background:var(--glass);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;position:relative;transition:transform .35s var(--e),border-color .3s ease}
.card::before{content:"";position:absolute;inset:0 0 auto 0;height:1px;background:linear-gradient(90deg,transparent,rgba(167,139,250,.6),transparent);opacity:0;transition:opacity .3s ease}
@media(hover:hover) and (pointer:fine){.card:hover{transform:translateY(-4px);border-color:rgba(167,139,250,.35)}.card:hover::before{opacity:1}}
.card figure{aspect-ratio:3/2;overflow:hidden;position:relative;background:var(--bg2)}
.card figure img{width:100%;height:100%;object-fit:cover}
.card figure figcaption{position:absolute;left:12px;bottom:10px;font-size:.7rem;padding:4px 8px;border-radius:6px;background:rgba(12,13,20,.6);color:var(--mut)}
.card .tag{position:absolute;top:12px;left:12px;font-family:"JetBrains Mono",monospace;font-size:.72rem;padding:5px 9px;border-radius:8px;background:rgba(12,13,20,.7);color:var(--acc);border:1px solid rgba(167,139,250,.25)}
.cb{padding:20px 20px 22px}
.cb .h3{margin-bottom:10px}
.cb ul{margin:12px 0 16px;display:grid;gap:7px;color:var(--mut);font-size:.9rem}
.cb li{padding-left:18px;position:relative}
.cb li::before{content:"";position:absolute;left:0;top:9px;width:7px;height:7px;border-radius:2px;background:var(--acc);transform:rotate(45deg)}
.price{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 6px;font-weight:600;padding-top:14px;border-top:1px solid var(--line)}
.price small{font-weight:400;color:var(--mut);font-size:.82rem}

/* roadmap */
.road{display:grid;gap:40px}
@media(min-width:1000px){.road{grid-template-columns:380px 1fr;gap:64px;align-items:start}.side{position:sticky;top:calc(var(--hd) + 20px)}}
.seg{display:inline-flex;padding:4px;border-radius:14px;background:var(--glass);border:1px solid var(--line);gap:2px}
.seg button{min-height:44px;padding:0 16px;border-radius:10px;font-weight:600;font-size:.9rem;color:var(--mut);transition:color .2s ease,background-color .25s ease,transform .2s var(--e)}
.seg button[aria-pressed=true]{background:linear-gradient(135deg,var(--v),var(--v3));color:#fff}
.seg button:active{transform:scale(.97)}
.sk{margin-top:22px;padding:24px;border-radius:var(--r);background:var(--glass);border:1px solid var(--line);display:grid}
.sk>div{grid-area:1/1;opacity:0;transform:translateY(8px);transition:opacity .4s var(--e),transform .4s var(--e);pointer-events:none}
.sk>div.on{opacity:1;transform:none;pointer-events:auto;transition-delay:.1s}
.sk .meta{font-family:"JetBrains Mono",monospace;font-size:.76rem;color:var(--acc);margin-bottom:10px}
.sk .h3{font-size:1.25rem;margin-bottom:14px}
.sk ul{display:grid;gap:9px;color:var(--mut);font-size:.92rem}
.sk li{display:flex;gap:10px}
.sk li svg{width:18px;height:18px;flex:none;color:#34D399;margin-top:3px}
.sk .role{margin-top:16px;padding-top:14px;border-top:1px solid var(--line);font-size:.86rem;color:var(--mut)}
.sk .role b{color:var(--ink);font-weight:600}
.mods{position:relative;padding-left:68px;padding-bottom:110px}
@media(min-width:640px){.mods{padding-left:104px}}
.rail{position:absolute;left:0;top:0;width:56px;overflow:visible;pointer-events:none}
@media(min-width:640px){.rail{width:84px}}
.cmt{opacity:0;transition:opacity .3s ease}
.cmt.on{opacity:1}
.cmt .cg{fill:rgba(155,92,255,.28)}
.cmt .cc{fill:#fff}
.cmt{filter:drop-shadow(0 0 8px rgba(167,139,250,.9))}
.side.rv{transform:none}
.hud{margin-top:16px;padding:14px 16px 16px;border-radius:16px;background:rgba(91,75,255,.1);border:1px solid rgba(167,139,250,.28);display:grid;gap:8px}
.hud .hl{display:flex;justify-content:space-between;gap:12px;font-family:"JetBrains Mono",monospace;font-size:.74rem;color:var(--acc)}
.hud .hm{font-family:Unbounded,sans-serif;font-weight:500;font-size:.98rem;line-height:1.3;min-height:1.3em}
.hud .hb{height:4px;border-radius:2px;background:rgba(255,255,255,.08);overflow:hidden}
.hud .hb i{display:block;height:100%;background:linear-gradient(90deg,var(--v),var(--v2));transform-origin:left;transform:scaleX(0)}
@media(max-width:999px){.hud{position:fixed;left:12px;right:12px;top:calc(var(--hd) + 8px);z-index:40;margin:0;padding:10px 14px 12px;gap:6px;background:rgba(19,20,30,.94);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);box-shadow:0 18px 40px -18px rgba(0,0,0,.8);opacity:0;transform:translateY(-10px);visibility:hidden;transition:opacity .3s var(--e),transform .3s var(--e),visibility .3s}.hud.on{opacity:1;transform:none;visibility:visible}.hud .hm{font-size:.88rem}}
.rail .tk{stroke:rgba(255,255,255,.1);stroke-width:2;stroke-dasharray:4 7;fill:none}
.rail .pg{stroke:url(#rg);stroke-width:3;fill:none;stroke-linecap:round}
.mod{position:relative;border-top:1px solid var(--line)}
.mod:last-child{border-bottom:1px solid var(--line)}
.mh{display:grid;grid-template-columns:1fr auto;gap:10px 16px;align-items:center;width:100%;padding:22px 0;text-align:left;position:relative}
@media(min-width:640px){.mh{grid-template-columns:1fr auto auto}}
.mh .t{font-family:Unbounded,sans-serif;font-weight:500;font-size:1.05rem;letter-spacing:-.01em;transition:color .2s ease}
.mh .wk{font-family:"JetBrains Mono",monospace;font-size:.76rem;color:var(--mut);grid-column:1;grid-row:2}
@media(min-width:640px){.mh .wk{grid-column:auto;grid-row:auto}}
.mh .ch{width:36px;height:36px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;transition:transform .35s var(--e),background-color .2s ease;grid-row:1/3;grid-column:2}
@media(min-width:640px){.mh .ch{grid-row:auto;grid-column:auto}}
.mh .ch svg{width:16px;height:16px}
.mh[aria-expanded=true] .ch{transform:rotate(180deg);background:var(--glass)}
@media(hover:hover) and (pointer:fine){.mh:hover .t{color:var(--acc)}}
.node{position:absolute;left:-50px;top:26px;width:36px;height:36px;border-radius:50%;background:var(--bg);border:2px solid rgba(255,255,255,.22);display:grid;place-items:center;font-family:"JetBrains Mono",monospace;font-size:.72rem;color:var(--mut);transform:scale(.6);opacity:0;transition:transform .5s var(--e),opacity .4s ease,border-color .3s ease,background-color .3s ease,color .3s ease}
.node.rc{transform:scale(1);opacity:1}
.mod.hz .node{background:linear-gradient(135deg,var(--v),var(--v2));border-color:transparent;color:#fff;box-shadow:0 0 0 6px rgba(91,75,255,.18),0 0 24px rgba(155,92,255,.45)}
