@media(max-width:720px){
.prep thead{display:none}
.prep tr{display:block;padding:18px 20px;border-top:1px solid var(--line)}
.prep td{display:block;border:0;padding:4px 0;width:auto!important}
.prep td:first-child{margin-bottom:8px}
.prep td[data-l]::before{content:attr(data-l);display:block;font-size:12px;color:var(--gold-ink);letter-spacing:.03em;margin:8px 0 2px}
.days{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:6px;scrollbar-width:thin;margin:0 -28px;padding-left:28px;padding-right:28px}
.day{flex:0 0 72px;scroll-snap-align:start}
.tms{grid-template-columns:repeat(3,1fr)}
.docs{grid-template-columns:1fr}
.doc{display:grid;grid-template-columns:64px 1fr;column-gap:14px;row-gap:8px;align-items:start}
.doc-ph{width:64px;height:80px;grid-row:1/3}
.doc .ph-tag{position:static;grid-column:2;justify-self:start}
.ct-i{grid-template-columns:1fr}
}
@media(max-width:640px){
.hero h1{font-size:clamp(40px,11.5vw,60px)}
.hero-sub{font-size:16.5px}
.facts{grid-template-columns:1fr;gap:12px;margin-top:36px;padding-top:22px}
.fl{padding:11px 14px;font-size:12px}
.fl b{font-size:13px}
.fl-n{font-size:24px}
.fl1{top:6%}.fl2{bottom:8%}
.hero-v>.ph-tag{left:12px;right:auto;bottom:22px}
.seg button{padding:0 10px;font-size:14px;white-space:nowrap}
.g2 .cap,.g3 .cap{bottom:auto;top:12px;font-size:12px;white-space:nowrap}
.mq-t span{font-size:22px}
.svs{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:14px;margin:0 -20px;padding:4px 20px 10px;scrollbar-width:thin}
.sv{flex:0 0 min(84%,320px);scroll-snap-align:start}
.opts,.qres{grid-template-columns:1fr}
.opt{min-height:54px}
.qp h3{font-size:28px}
.qz-main,.qz-side{padding:24px 20px}
.crs-card{padding:24px 20px}
.crs-rows .tot b{font-size:34px}
.seg{display:flex}
.seg button{flex:1;min-width:0}
.bs{padding:22px 20px}
.days{margin:0 -20px;padding-left:20px;padding-right:20px}
.bk-side{padding:22px 20px}
.ct-f{padding:26px 20px}
.ct-i{padding:24px 20px}
.qb{font-size:21px;padding:20px 0}
.qa p{padding-right:16px}
.ft-g{grid-template-columns:1fr}
.ft-g>div:first-child{grid-column:auto}
.gal{grid-template-rows:260px 150px 170px;gap:10px}
.why-ph::after{display:none}
}
@media(max-width:400px){.hero-v{padding-right:10px}.fl2{right:0}.crs{padding:24px 16px}.seg button{padding:0 6px;font-size:13px}}

@media(prefers-reduced-motion:reduce){
html{scroll-behavior:auto}
*,*::before,*::after{animation:none!important;transition:none!important}
.rv{opacity:1;transform:none}
.steps .st-line::after{transform:none}
.st i{transform:none}
.hero-ph img{transform:none}
.a1,.a2,.a3,.a4{opacity:1}
}
