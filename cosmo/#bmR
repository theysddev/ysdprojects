 musc:{n:'Мимические мышцы',r:'глубже 6 мм',t:'Мышцы, которые формируют мимику и заломы на лбу и вокруг глаз. Ботулинотерапия расслабляет их точечно: точки и дозу врач определяет на консультации.',p:['botox'],m:7.5}
};
const PD={care:[.015,'Очищение, массаж и маска на поверхности кожи'],clean:[.045,'Очищение пор и рогового слоя'],peel:[.08,'Кислота мягко обновляет верхний слой'],bio:[1,'Гиалуроновая кислота вводится в дерму'],meso:[1.5,'Микроинъекции коктейля — состав по показаниям'],laser:[3,'Свет нагревает луковицу волоса'],filler:[4.2,'Глубина зависит от зоны, решает врач'],botox:[7.5,'Препарат вводится точечно в мышцу']};
const DXA=[[0,70],[.1,140],[2,340],[6,500],[10,612]];
const m2y=m=>{for(let i=1;i<DXA.length;i++){if(m<=DXA[i][0]){const a=DXA[i-1],b=DXA[i];return a[1]+(m-a[0])/(b[0]-a[0])*(b[1]-a[1])}}return 612};
const y2m=y=>{for(let i=1;i<DXA.length;i++){if(y<=DXA[i][1]){const a=DXA[i-1],b=DXA[i];return a[0]+(y-a[1])/(b[1]-a[1])*(b[0]-a[0])}}return 10};
const layerOf=m=>m<.1?'epi':m<2?'derm':m<6?'hypo':'musc';
const fmm=m=>(m<.1?m.toFixed(2):m.toFixed(1)).replace(/\.0$/,'').replace('.',',');
const dxFig=$('#dxFig'),dxSvg=$('#dxSvg'),dxH=$('#dxH'),dxHv=$('#dxHv'),bmCol=$('#bmCol'),bmGlow=$('#bmGlow'),bmLine=$('#bmLine'),dxCardEl=$('#dxCard'),mks=$$('#mks .mk');
let dxM=1.2,dxL=null,dxAnim=0;
function dxCard(L,instant){
 const D=DX[L];
 const paint=()=>{
  $('#dxName').textContent=D.n;$('#dxRange').textContent=D.r;$('#dxText').textContent=D.t;
  $('#dxPs').innerHTML=D.p.map(id=>'<li class="dx-p" data-p="'+id+'"><b>'+P[id].n+'</b><em>'+priceTxt(id).replace('при записи на процедуру','')+'</em><span>'+PD[id][1]+'</span><button type="button" class="lnk" data-proc="'+id+'">Записаться</button></li>').join('');
  dxNear();
 };
 $$('#dxTabs button').forEach(b=>b.setAttribute('aria-pressed',b.dataset.l===L));
 if(instant||RM){paint();return}
 dxCardEl.classList.add('sw');clearTimeout(dxCard.t);dxCard.t=setTimeout(()=>{paint();dxCardEl.classList.remove('sw')},180);
}
function dxNear(){
 const items=$$('#dxPs .dx-p');let best=null,bd=1e9;
 items.forEach(li=>{const d=Math.abs(m2y(PD[li.dataset.p][0])-m2y(dxM));if(d<bd){bd=d;best=li}});
 items.forEach(li=>li.classList.toggle('near',li===best&&bd<60));
}
function dxRender(m){
 dxM=Math.max(0,Math.min(10,m));const y=m2y(dxM);
 bmCol.setAttribute('height',y.toFixed(1));bmGlow.setAttribute('cy',y.toFixed(1));bmLine.setAttribute('d','M92 '+y.toFixed(1)+'H560');
 dxH.style.top=(y/620*100).toFixed(2)+'%';
 const L=layerOf(dxM),txt='около '+fmm(dxM)+' мм, '+DX[L].n.toLowerCase();
 dxHv.textContent='≈ '+fmm(dxM)+' мм';
 dxH.setAttribute('aria-valuenow',dxM.toFixed(2));dxH.setAttribute('aria-valuetext',txt);
 mks.forEach(g=>g.classList.toggle('on',Math.abs(+g.dataset.y-y)<14));
 if(L!==dxL){const first=dxL===null;dxL=L;dxCard(L,first)}else dxNear();
}
function dxTo(m,dur){
 cancelAnimationFrame(dxAnim);
 if(RM){dxRender(m);return}
 const y0=m2y(dxM),y1=m2y(m),t0=performance.now(),D=dur||650;
 const st=t=>{const k=Math.min(1,(t-t0)/D),e=1-Math.pow(1-k,3);dxRender(y2m(y0+(y1-y0)*e));if(k<1)dxAnim=requestAnimationFrame(st)};
 dxAnim=requestAnimationFrame(st);
}
const yFrom=e=>{const r=dxSvg.getBoundingClientRect();return Math.max(70,Math.min(612,(e.clientY-r.top)/r.height*620))};
let dragging=false;
function dxStart(e){dragging=true;cancelAnimationFrame(dxAnim);dxFig.classList.add('drag');try{e.currentTarget.setPointerCapture(e.pointerId)}catch(_){}dxRender(y2m(yFrom(e)))}
function dxMove(e){if(dragging)dxRender(y2m(yFrom(e)))}
function dxEnd(){dragging=false;dxFig.classList.remove('drag')}
dxH.addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();dxStart(e)});
dxH.addEventListener('pointermove',dxMove);dxH.addEventListener('pointerup',dxEnd);dxH.addEventListener('pointercancel',dxEnd);
dxFig.addEventListener('pointerdown',e=>{if(e.pointerType==='mouse'&&e.button===0){e.preventDefault();dxStart(e)}});
dxFig.addEventListener('pointermove',dxMove);dxFig.addEventListener('pointerup',dxEnd);dxFig.addEventListener('pointercancel',dxEnd);
dxFig.addEventListener('click',e=>{if(e.pointerType==='mouse'||e.target.closest('#dxH'))return;if(e.clientY)dxTo(y2m(yFrom(e)),500)});
dxH.addEventListener('keydown',e=>{
 const y=m2y(dxM),order=['epi','derm','hypo','musc'],i=order.indexOf(layerOf(dxM));let to=null;
 if(e.key==='ArrowDown'||e.key==='ArrowRight')to=y2m(Math.min(612,y+6));
 else if(e.key==='ArrowUp'||e.key==='ArrowLeft')to=y2m(Math.max(70,y-6));
 else if(e.key==='PageDown')to=DX[order[Math.min(3,i+1)]].m;
 else if(e.key==='PageUp')to=DX[order[Math.max(0,i-1)]].m;
 else if(e.key==='Home')to=0;else if(e.key==='End')to=10;
 if(to!==null){e.preventDefault();e.key.startsWith('Page')?dxTo(to):dxRender(to)}
});
$$('#dxTabs button').forEach(b=>b.addEventListener('click',()=>dxTo(DX[b.dataset.l].m)));
dxRender(1.2);
if('IntersectionObserver' in window&&!RM){
 dxRender(0);
 const dio=new IntersectionObserver(es=>{if(es.some(e=>e.isIntersecting)){dio.disconnect();setTimeout(()=>dxTo(1.2,1700),250)}},{threshold:.35});
 dio.observe(dxFig);
}

/* booking */
const bk={proc:null,doc:null,day:null,time:null};
const WD=['вс','пн','вт','ср','чт','пт','сб'],MN=['янв','фев','мар','апр','май','июн','июл','авг','сен','окт','ноя','дек'],MF=['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
const procsEl=$('#bProcs');
Object.keys(P).forEach(id=>{const b=document.createElement('button');b.type='button';b.className='chip';b.dataset.id=id;b.setAttribute('aria-pressed','false');b.innerHTML=P[id].n+' <small>'+(id==='consult'?'0 ₽':'от '+fmt(P[id].p)+' ₽'+(P[id].u||''))+'</small>';b.addEventListener('click',()=>selectProc(id));procsEl.appendChild(b)});
function lock(n,on,hint){$('#bs'+n).classList.toggle('lk',on);const h=$('#bs'+n+' .bs-h span');if(h&&hint!==undefined)h.textContent=hint}
function selectProc(id){
 bk.proc=id;$$('#bProcs .chip').forEach(b=>b.setAttribute('aria-pressed',b.dataset.id===id));
 $$('.doc').forEach((d,i)=>{const ok=DOCS[i].ok.includes(id);d.disabled=!ok;$('.doc-no',d).hidden=ok;if(!ok&&bk.doc===i)bk.doc=null;d.setAttribute('aria-pressed',bk.doc===i)});
 lock(2,false,'кто выполняет эту процедуру');
 const sel=$('#fProc');if(sel)sel.value=id;
 sum();
}
$$('.doc').forEach(d=>d.addEventListener('click',()=>{bk.doc=+d.dataset.doc;$$('.doc').forEach(x=>x.setAttribute('aria-pressed',x===d));sum()}));
const today=new Date();today.setHours(0,0,0,0);
const daysEl=$('#bDays');
for(let i=0;i<14;i++){const d=new Date(today);d.setDate(today.getDate()+i);const b=document.createElement('button');b.type='button';b.className='day'+(d.getDay()===0?' sun':'');b.dataset.i=i;b.setAttribute('aria-pressed','false');b.innerHTML='<span>'+(i===0?'сегодня':WD[d.getDay()])+'</span><b>'+d.getDate()+'</b><span>'+MN[d.getMonth()]+'</span>';b.addEventListener('click',()=>pickDay(i,d));daysEl.appendChild(b)}
function pickDay(i,d){bk.day=d;bk.time=null;$$('.day').forEach(x=>x.setAttribute('aria-pressed',+x.dataset.i===i));renderTimes(i,d);lock(4,false,d.getDay()===0?'воскресенье — короткий день':'свободные окна');sum()}
function renderTimes(i,d){
 const el=$('#bTimes');el.innerHTML='';const last=d.getDay()===0?16:19,now=new Date();let free=0;
 for(let h=10;h<=last;h++){const b=document.createElement('button');b.type='button';b.className='chip tm';b.textContent=h+':00';const past=i===0&&h<=now.getHours(),busy=(i*7+h*3)%5===0;if(past||busy){b.disabled=true;b.title=past?'Время прошло':'Занято'}else free++;b.setAttribute('aria-pressed','false');b.addEventListener('click',()=>{bk.time=b.textContent;$$('.tm').forEach(x=>x.setAttribute('aria-pressed',x===b));sum()});el.appendChild(b)}
 if(!free){const p=document.createElement('p');p.className='empty';p.textContent='На этот день свободных окон нет — выберите другую дату или оставьте заявку, администратор подберёт время.';el.appendChild(p)}
}
function dateTxt(d){return d.getDate()+' '+MF[d.getMonth()]+', '+WD[d.getDay()]}
function sum(){
 const p=bk.proc&&P[bk.proc];
 $('#sProc').textContent=p?p.n:'—';
 $('#sDoc').textContent=bk.doc!=null?DOCS[bk.doc].n+', '+DOCS[bk.doc].r:'—';
 $('#sDate').textContent=bk.day?dateTxt(bk.day):'—';
 $('#sTime').textContent=bk.time||'—';
 $('#sPrice').textContent=p?priceTxt(bk.proc):'—';
 const left=[!bk.proc&&'процедуру',bk.doc==null&&'врача',!bk.day&&'дату',!bk.time&&'время'].filter(Boolean);
 $('#sLeft').textContent=left.length?'Осталось выбрать: '+left.join(', '):'Всё выбрано — оставьте контакты, администратор подтвердит запись.';
 return left;
}
sum();

/* data-proc buttons → booking */
document.addEventListener('click',e=>{const t=e.target.closest('[data-proc]');if(!t||!t.dataset.proc)return;e.preventDefault();selectProc(t.dataset.proc);scrollTo($('#booking'))});

/* phone mask */
function digits(v){const p=v.indexOf('+7');if(p>=0)v=v.slice(0,p)+v.slice(p+2);let d=v.replace(/\D/g,'');if(d.length===11&&(d[0]==='7'||d[0]==='8'))d=d.slice(1);return d.slice(0,10)}
function mask(i){const d=digits(i.value);let r='+7 ('+d.slice(0,3);if(d.length>3)r+=') '+d.slice(3,6);if(d.length>6)r+='-'+d.slice(6,8);if(d.length>8)r+='-'+d.slice(8,10);i.value=r}
$$('input[type=tel]').forEach(i=>{i.addEventListener('input',()=>mask(i));i.addEventListener('focus',()=>{if(!i.value)i.value='+7 (';setTimeout(()=>{const n=i.value.length;try{i.setSelectionRange(n,n)}catch(e){}},0)});i.addEventListener('blur',()=>{if(i.value==='+7 (')i.value=''})});
const phoneOk=i=>i.value.replace(/\D/g,'').length===11;
function validate(form){
 let ok=true;
 const name=$('input[name=name]',form),tel=$('input[type=tel]',form),ck=$('.ck',form);
 const f=(inp,bad)=>{inp.closest('.fld').classList.toggle('err',bad);inp.setAttribute('aria-invalid',bad);if(bad)ok=false};
 f(name,!name.value.trim());f(tel,!phoneOk(tel));
 const agreed=$('input',ck).checked;ck.classList.toggle('err',!agreed);if(!agreed)ok=false;
 return ok;
}
$$('.fld .inp, .ck input').forEach(i=>i.addEventListener('input',()=>{const w=i.closest('.fld')||i.closest('.ck');w&&w.classList.remove('err')}));

/* booking submit */
$('#bForm').addEventListener('submit',e=>{
 e.preventDefault();const err=$('#bErr');err.classList.remove('show');
 const left=sum();
 if(left.length){err.textContent='Сначала выберите '+left.join(', ')+'.';err.classList.add('show');const first=!bk.proc?'#bs1':bk.doc==null?'#bs2':!bk.day?'#bs3':'#bs4';scrollTo($(first));return}
 if(!validate(e.target)){err.textContent='Проверьте выделенные поля.';err.classList.add('show');return}
 $('#bOkText').innerHTML='<b>'+P[bk.proc].n+'</b>, '+DOCS[bk.doc].r+' — <b>'+dateTxt(bk.day)+', '+bk.time+'</b>. Ждём вас, '+$('#bName').value.trim()+'.';
 $('#bkSide').classList.add('done');
});
/* contact form submit */
$('#cForm').addEventListener('submit',e=>{
 e.preventDefault();const err=$('#cErr');err.classList.remove('show');
 if(!validate(e.target)){err.textContent='Проверьте выделенные поля.';err.classList.add('show');return}
 const id=$('#fProc').value;
 $('#cOkText').innerHTML='Спасибо, '+$('#fName').value.trim()+'. Запрос: <b>'+(id?P[id].n:'консультация')+'</b>, телефон <b>'+$('#fPhone').value+'</b>.';
 e.target.closest('.ct-f').classList.add('done');
});

/* faq */
$$('.qb').forEach(b=>b.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')==='true';$$('.qb').forEach(x=>{x.setAttribute('aria-expanded','false');x.closest('.q').classList.remove('open')});if(!open){b.setAttribute('aria-expanded','true');b.closest('.q').classList.add('open')}}));

/* privacy */
const pv=$('#privacy');
$$('.pvl').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();if(pv.showModal)pv.showModal();else pv.setAttribute('open','')}));
$$('[data-close]',pv).forEach(b=>b.addEventListener('click',()=>{if(pv.close)pv.close();else pv.removeAttribute('open')}));
pv.addEventListener('click',e=>{if(e.target===pv&&pv.close)pv.close()});

/* lightbox */
const lb=$('#lb'),lbI=$('#lbImg'),lbC=$('#lbCap');let lastF=null;
function lbOpen(src,alt,cap){lastF=document.activeElement;lbI.src=src;lbI.alt=alt;lbC.textContent=cap+' — фото-пример';lb.hidden=false;requestAnimationFrame(()=>lb.classList.add('vis'));document.body.classList.add('lock');$('#lbX').focus()}
function lbClose(){if(lb.hidden)return;lb.classList.remove('vis');document.body.classList.remove('lock');setTimeout(()=>{lb.hidden=true;lbI.removeAttribute('src');lastF&&lastF.focus()},RM?0:300)}
$$('.gi').forEach(g=>g.addEventListener('click',()=>lbOpen(g.dataset.full,$('img',g).alt,$('.cap',g).textContent)));
$('#lbX').addEventListener('click',lbClose);
lb.addEventListener('click',e=>{if(e.target===lb)lbClose()});
addEventListener('keydown',e=>{if(e.key==='Escape'){lbClose();if(burger.getAttribute('aria-expanded')==='true')menu(false)}});
})();
