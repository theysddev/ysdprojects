<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Траектория для бизнеса — корпоративное обучение сотрудников</title>
<meta name="description" content="Презентация онлайн-школы «Траектория» для HR-директоров: корпоративные программы по аналитике данных, продакт-менеджменту, Python и управлению командой, платформа, результаты и калькулятор стоимости.">
<meta property="og:title" content="Траектория для бизнеса — корпоративное обучение сотрудников">
<meta property="og:description" content="Живая презентация: программы, формат, платформа, кейс клиента и расчёт стоимости на вашу команду.">
<meta property="og:type" content="website">
<meta name="theme-color" content="#E8E3FF">
<link rel="icon" href="/slides/favicon.ico" sizes="32x32"><link rel="icon" type="image/png" sizes="48x48" href="/slides/favicon-48.png"><link rel="icon" type="image/png" sizes="96x96" href="/slides/icon-96.png"><link rel="icon" type="image/png" sizes="192x192" href="/slides/icon-192.png"><link rel="apple-touch-icon" href="/slides/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;600;700&family=Onest:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
 --paper:#F8F6FF;--ink:#1B1547;--ink2:#4B4676;--mut:#69648F;--line:rgba(27,21,71,.1);--line2:rgba(27,21,71,.16);
 --vio:#5B4BFF;--vio2:#4535E8;--pink:#FF5C9D;--sun:#FFC23D;--mint:#1CCB98;--sky:#3D9BFF;
 --tV:#EEEBFF;--tS:#FFF3D6;--tM:#DDF8EE;--tP:#FFE6F0;
 --gV:linear-gradient(140deg,#6E5CFF 0%,#9E4DFF 50%,#FF5C9D 100%);
 --gS:linear-gradient(150deg,#FFE27A 0%,#FFB53D 55%,#FF7A45 100%);
 --gM:linear-gradient(150deg,#6BF2C8 0%,#22C9A0 42%,#3D9BFF 100%);
 --gP:linear-gradient(115deg,#FF8EC4 0%,#FF6CA0 45%,#FFAE6B 100%);
 --gCard:linear-gradient(140deg,#4B3BEF 0%,#7B3EEA 55%,#A73BD0 100%);
 --e:cubic-bezier(.23,1,.32,1);--io:cubic-bezier(.65,0,.35,1);
 --barH:68px;--edge:40px
}
*,*::before,*::after{box-sizing:border-box}
html,body{margin:0;height:100%}
body{font-family:Onest,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);overflow:hidden;-webkit-font-smoothing:antialiased;
 background:radial-gradient(70vw 60vh at 8% -10%,#F6F3FF 0%,rgba(246,243,255,0) 70%),radial-gradient(60vw 60vh at 105% 110%,#FFE3F0 0%,rgba(255,227,240,0) 65%),#E6E1FF}
button,input{font:inherit;color:inherit}
button{cursor:pointer;background:none;border:0;padding:0;-webkit-tap-highlight-color:transparent}
a{color:inherit}
h1,h2,h3,h4,p,ul,ol,figure{margin:0}
ul,ol{padding:0;list-style:none}
:focus-visible{outline:3px solid var(--vio);outline-offset:3px;border-radius:10px}
.sr-only{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
kbd{font-family:inherit;font-weight:600;font-size:.86em;display:inline-grid;place-items:center;min-width:1.9em;height:1.9em;padding:0 .45em;border-radius:.5em;background:#fff;border:1px solid var(--line2);box-shadow:0 2px 0 var(--line2)}

/* ---------- deck & stage ---------- */
.deck{position:fixed;left:0;right:0;top:0;bottom:var(--barH);overflow:hidden}
.stage{position:absolute;left:50%;top:50%;width:1600px;height:900px;transform:translate(-50%,-50%) scale(var(--s,.6));border-radius:44px;background:var(--paper);overflow:hidden;
 box-shadow:0 50px 120px -50px rgba(58,32,170,.5),0 0 0 1px rgba(91,75,255,.08)}
.edge{position:absolute;top:0;bottom:0;width:var(--edge);z-index:5;cursor:pointer;display:grid;align-items:center}
.edge-l{left:0;justify-items:start;cursor:w-resize}.edge-r{right:0;justify-items:end;cursor:e-resize}
.edge i{width:44px;height:44px;margin:0 6px;border-radius:50%;background:rgba(255,255,255,.9);box-shadow:0 8px 24px -10px rgba(27,21,71,.4);display:grid;place-items:center;opacity:0;transform:scale(.9);transition:opacity .2s ease,transform .25s var(--e)}
.edge i svg{width:20px;height:20px;fill:none;stroke:var(--ink);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
@media (hover:hover) and (pointer:fine){.edge:hover i{opacity:1;transform:none}}
.edge[aria-disabled=true]{cursor:default}.edge[aria-disabled=true] i{display:none}

/* shapes */
.shapes{position:absolute;inset:0;z-index:0;pointer-events:none}
.sh{position:absolute;left:0;top:0;--x:.5;--y:.5;--r:0;--k:1;
 transform:translate(calc(var(--x)*1600px - 50%),calc(var(--y)*900px - 50%)) rotate(calc(var(--r)*1deg)) scale(var(--k));
 transition:transform 1.15s var(--io),opacity .6s ease;will-change:transform}
.sh-a{width:600px;height:600px;border-radius:50%;background:var(--gV)}
.sh-b{width:440px;height:220px;border-radius:220px 220px 0 0;background:var(--gS)}
.sh-c{width:300px;height:300px;border-radius:92px;background:var(--gM)}
.sh-d{width:480px;height:160px;border-radius:80px;background:var(--gP)}
.sh-e{width:170px;height:170px;border-radius:50%;border:30px solid var(--vio);background:transparent}
.shp-static{display:none;position:absolute;inset:0;z-index:-1;pointer-events:none}
.shp-static .sh{transition:none}

/* ---------- slide base ---------- */
.slide{position:absolute;inset:0;z-index:1;padding:76px 96px 70px;display:flex;flex-direction:column;
 --fs-d:86px;--fs-h:54px;--fs-l:29px;--fs-b:22px;--fs-s:18px;--fs-x:16px;
 opacity:0;visibility:hidden;transform:translateX(70px);
 transition:opacity .45s var(--e),transform .6s var(--e),visibility 0s linear .6s}
.slide.is-past{transform:translateX(-70px)}
.slide.is-active{opacity:1;visibility:visible;transform:none;transition:opacity .55s var(--e) .08s,transform .75s var(--e) .08s,visibility 0s}
.a{opacity:0;transform:translateY(26px);transition:opacity .6s var(--e),transform .85s var(--e);transition-delay:calc(var(--d,0)*85ms + 160ms)}
.a.pop{transform:scale(.92) translateY(14px)}
.a.lft{transform:translateX(-30px)}
.is-on .a{opacity:1;transform:none}
.t{font-family:Unbounded,Onest,sans-serif;font-weight:600;font-size:var(--fs-h);line-height:1.1;letter-spacing:-.03em;max-width:1240px;text-wrap:balance}
.lead{font-size:var(--fs-b);line-height:1.5;color:var(--ink2);max-width:640px}
.foot{font-size:var(--fs-x);line-height:1.45;color:var(--mut)}
.card{background:#fff;border-radius:32px;box-shadow:0 30px 70px -40px rgba(43,25,140,.35),0 0 0 1px rgba(27,21,71,.05)}
.num{font-family:Unbounded,Onest,sans-serif;font-weight:600;letter-spacing:-.04em;font-variant-numeric:tabular-nums}
.mark{display:block;flex:none}

/* ---------- 1 cover ---------- */
.cv-top{display:flex;align-items:center;gap:30px}
.brand{display:flex;align-items:center;gap:16px}
.brand .mark{width:58px;height:58px}
.brand-n{font-family:Unbounded,sans-serif;font-weight:600;font-size:28px;letter-spacing:-.02em}
.brand-t{white-space:nowrap;font-weight:600;font-size:17px;padding:8px 14px;border-radius:999px;background:#fff;box-shadow:0 0 0 1px var(--line)}
.cv-meta{font-size:17px;line-height:1.4;color:var(--ink2);padding-left:30px;border-left:2px solid var(--line2)}
.cv-body{margin-top:auto;margin-bottom:auto;max-width:860px;padding-top:20px}
.cv-h{font-family:Unbounded,sans-serif;font-weight:700;font-size:var(--fs-d);line-height:1;letter-spacing:-.045em}
.cv-lead{margin-top:30px;font-size:23px;line-height:1.5;color:var(--ink2);max-width:660px}
.chips{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
.chips li{font-weight:600;font-size:18px;padding:12px 20px;border-radius:999px;background:#fff;box-shadow:0 0 0 1px var(--line)}
.chips li:nth-child(1){background:var(--ink);color:#fff;box-shadow:none}
.cv-bot{display:flex;flex-direction:column;align-items:flex-start;gap:10px;max-width:860px}
.cv-hint{font-size:17px;color:var(--ink2);display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.cv-hint .m{display:none}
.demo-note{font-size:15px;color:var(--mut)}
.cv-art{position:absolute;inset:0;pointer-events:none}
.traj{position:absolute;inset:0;width:1600px;height:900px}
.traj path{fill:none;stroke:var(--ink);stroke-width:7;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 1.8s var(--io) .5s}
.traj circle{fill:#fff;stroke:var(--ink);stroke-width:7;transform-box:fill-box;transform-origin:center;transform:scale(0);transition:transform .6s var(--e)}
.traj .c1{transition-delay:.35s}.traj .c2{transition-delay:2.05s}
.is-on .traj path{stroke-dashoffset:0}.is-on .traj circle{transform:scale(1)}
.cv-loc{display:none}
.fc{position:absolute;background:#fff;border-radius:22px;padding:16px 20px;box-shadow:0 24px 50px -24px rgba(27,21,71,.45);display:flex;gap:14px;align-items:center}
.fc1{left:1010px;top:262px}
.fc2{left:1150px;top:586px;flex-direction:column;align-items:stretch;gap:10px;width:330px}
.fc-ic{width:44px;height:44px;border-radius:50%;background:var(--mint);display:grid;place-items:center;flex:none}
.fc-ic svg{width:22px;height:22px;stroke:#fff;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
.fc b{display:block;font-size:18px}.fc span{font-size:15px;color:var(--mut)}
.fc-bar{height:10px;border-radius:9px;background:var(--tV);overflow:hidden}
.fc-bar i{display:block;height:100%;width:68%;border-radius:9px;background:var(--gV)}
.fc2 .row{display:flex;justify-content:space-between;align-items:baseline}
.fc2 .row b{font-size:17px}.fc2 .row em{font-style:normal;font-family:Unbounded,sans-serif;font-weight:600;font-size:18px;color:var(--vio)}

/* ---------- 2 gap ---------- */
.s-gap .t{max-width:1240px}.s-mnt .t{max-width:980px}.s-case .t{max-width:1180px}
.gap-wrap{flex:1;display:grid;grid-template-columns:400px 1fr;gap:64px;margin-top:44px;min-height:0}
.facts{display:flex;flex-direction:column;justify-content:space-between;padding:6px 0 2px}
.fact{padding-left:24px;border-left:4px solid var(--c,var(--vio))}
.fact .num{font-size:52px;line-height:1;display:block}
.fact p{font-size:var(--fs-s);line-height:1.45;color:var(--ink2);margin-top:10px}
.gap-card{padding:38px 44px 32px;display:flex;flex-direction:column}
.card-h{display:flex;justify-content:space-between;align-items:baseline;gap:20px}
.card-h h3{font-size:var(--fs-l);font-weight:700;letter-spacing:-.01em}
.lg{display:flex;gap:22px;font-size:16px;color:var(--ink2)}
.lg li{display:flex;align-items:center;gap:8px}
.lg i{width:26px;height:12px;border-radius:6px}
.lg .need{border:2px dashed #B9B3E6}.lg .have{background:var(--gV)}
.gr-list{flex:1;display:flex;flex-direction:column;justify-content:space-around;margin:18px 0 10px}
.gr{display:grid;grid-template-columns:1fr 92px;grid-template-rows:auto 34px;column-gap:20px;row-gap:10px;align-items:center}
.gr-n{grid-column:1/-1;font-size:19px;font-weight:600;display:flex;justify-content:space-between}
.gr-n em{font-style:normal;font-weight:500;color:var(--mut);font-size:16px}
.gr-bar{position:relative;height:34px;border-radius:12px;border:2px dashed #C9C4EE}
.gr-bar i{position:absolute;left:-2px;top:-2px;bottom:-2px;width:calc(var(--v)*100% + 2px);border-radius:12px;background:var(--gV);transform-origin:left;transform:scaleX(0);transition:transform 1.2s var(--e);transition-delay:calc(var(--d,0)*120ms + .5s)}
.is-on .gr-bar i{transform:none}
.gr .num{font-size:26px;text-align:right}

/* ---------- 3 hire vs grow ---------- */
.hg-card{margin-top:40px;padding:36px 44px 30px}
.hg-axis{position:relative;margin-left:300px;height:26px;font-size:15px;color:var(--mut)}
.hg-axis span{position:absolute;transform:translateX(-50%);left:calc(var(--m)/9*100%)}
.hg-row{display:grid;grid-template-columns:300px 1fr;align-items:center;min-height:150px;border-top:1px solid var(--line)}
.hg-row:first-of-type{border-top:0}
.hg-lab b{display:block;font-size:22px;font-weight:700;letter-spacing:-.01em}
.hg-lab span{display:block;font-size:16px;color:var(--mut);margin-top:6px;line-height:1.4;padding-right:24px}
.hg-track{position:relative;height:150px;background:repeating-linear-gradient(90deg,var(--line) 0 1px,transparent 1px calc(100%/9))}
.seg{position:absolute;top:42px;height:64px;left:calc(var(--f)/9*100%);width:calc((var(--to) - var(--f))/9*100%);border-radius:18px;display:flex;align-items:center;padding:0 18px;font-weight:600;font-size:17px;white-space:nowrap;
 transform-origin:left;transform:scaleX(0);transition:transform 1s var(--e);transition-delay:calc(var(--d,0)*160ms + .45s)}
.is-on .seg{transform:none}
.seg span{opacity:0;transition:opacity .4s ease;transition-delay:calc(var(--d,0)*160ms + 1.2s)}
.is-on .seg span{opacity:1}
.seg-search{background:repeating-linear-gradient(-45deg,#ECE9FB 0 12px,#E1DCF8 12px 24px);color:var(--ink2)}
.seg-adapt{background:var(--tP);color:#8A2350}
.seg-learn{background:var(--gCard);color:#fff}
.flag{position:absolute;top:30px;left:calc(var(--m)/9*100%);height:84px;border-left:3px solid var(--ink);padding-left:10px;font-size:15px;font-weight:600;line-height:1.3;white-space:nowrap;opacity:0;transition:opacity .5s ease;transition-delay:calc(var(--d,0)*160ms + 1.5s)}
.flag::before{content:"";position:absolute;left:-8px;top:-6px;width:13px;height:13px;border-radius:50%;background:var(--ink)}
.flag b{display:block;font-family:Unbounded,sans-serif;font-size:16px}
.is-on .flag{opacity:1}
.tick{position:absolute;top:116px;left:calc(var(--m)/9*100%);font-size:14px;color:var(--ink2);white-space:nowrap;transform:translateX(-12px)}
.tick::before{content:"";position:absolute;left:8px;top:-12px;width:8px;height:8px;border-radius:50%;background:var(--sun)}
.hg-sum{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:auto;padding-top:30px}
.hg-sum div{padding-top:20px;border-top:3px solid var(--ink)}
.hg-sum .num{font-size:38px;line-height:1.05;display:block}
.hg-sum p{margin-top:10px;font-size:var(--fs-s);color:var(--ink2);line-height:1.45}
.s-hire .foot{margin-top:18px}

/* ---------- 4 programs ---------- */
.pg-grid{flex:1;display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:44px;min-height:0}
.pg{padding:30px 28px 26px;display:flex;flex-direction:column;position:relative;overflow:hidden}
.pg-ic{height:118px;position:relative;margin:-4px 0 18px}
.pg-ic i{position:absolute;left:0;top:0;background:var(--g)}
.pg-ic .i1{width:110px;height:110px;border-radius:50%}
.pg-ic .i2{width:150px;height:75px;border-radius:75px 75px 0 0;top:30px}
.pg-ic .i3{width:104px;height:104px;border-radius:32px;transform:rotate(-10deg);top:6px;left:6px}
.pg-ic .i4{width:170px;height:58px;border-radius:30px;top:28px;transform:rotate(-14deg)}
.pg-ic .n{position:absolute;right:0;top:0;text-align:right}
.pg-ic .n b{display:block;font-family:Unbounded,sans-serif;font-weight:600;font-size:52px;line-height:1;letter-spacing:-.04em}
.pg-ic .n span{font-size:15px;color:var(--mut)}
.pg h3{font-family:Unbounded,sans-serif;font-weight:600;font-size:24px;line-height:1.2;letter-spacing:-.02em}
.pg .meta{font-size:16px;color:var(--mut);margin-top:8px}
.pg ul{margin-top:20px;display:grid;gap:10px}
.pg li{font-size:18px;line-height:1.35;padding-left:20px;position:relative}
.pg li::before{content:"";position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:50%;background:var(--ink)}
.pg .res{margin-top:auto;padding:16px 18px;border-radius:18px;background:var(--tint);font-size:16px;line-height:1.4}
.pg .res b{display:block;font-size:14px;color:var(--ink2);font-weight:600;margin-bottom:4px}
.pg-for{margin-top:22px;font-size:var(--fs-s);color:var(--ink2)}

/* ---------- 5 format ---------- */
.fm-wrap{flex:1;display:grid;grid-template-columns:470px 1fr;gap:60px;margin-top:44px;min-height:0}
.fm-list{display:flex;flex-direction:column;gap:30px;justify-content:center}
.fm-i{display:grid;grid-template-columns:56px 1fr;gap:20px;align-items:start}
.fm-i i{width:56px;height:56px;background:var(--g)}
.fm-i .q1{border-radius:50%}.fm-i .q2{border-radius:18px}.fm-i .q3{border-radius:56px 56px 0 0;height:28px;margin-top:14px}
.fm-i h3{font-size:24px;font-weight:700;letter-spacing:-.01em}
.fm-i p{font-size:var(--fs-s);line-height:1.5;color:var(--ink2);margin-top:6px}
.cal{padding:28px 30px 24px;display:flex;flex-direction:column}
.cal-h{display:flex;justify-content:space-between;align-items:baseline}
.cal-h h3{font-size:22px;font-weight:700}
.cal-h span{font-size:16px;color:var(--mut)}
.cal-g{flex:1;display:grid;grid-template-columns:56px repeat(5,1fr);grid-template-rows:auto 1fr;margin-top:18px;min-height:0}
.cal-days{display:contents}
.cal-d{font-size:15px;font-weight:600;color:var(--ink2);padding:0 0 10px 10px}
.cal-hrs{grid-column:1;grid-row:2;position:relative}
.cal-hrs span{position:absolute;right:12px;font-size:13px;color:var(--mut);transform:translateY(-50%);top:calc((var(--h) - 9)/9*100%)}
.cal-col{grid-row:2;position:relative;border-left:1px solid var(--line);background:repeating-linear-gradient(180deg,var(--line) 0 1px,transparent 1px calc(100%/9))}
.ev{position:absolute;left:6px;right:6px;top:calc((var(--s) - 9)/9*100%);height:calc(var(--l)/9*100% - 3px);border-radius:12px;padding:7px 10px;font-size:13.5px;line-height:1.25;overflow:hidden;
 opacity:0;transform:translateY(-14px) scale(.96);transition:opacity .5s var(--e),transform .7s var(--e);transition-delay:calc(var(--d,0)*110ms + .6s)}
.is-on .ev{opacity:1;transform:none}
.ev b{display:block;font-weight:700;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ev span{display:block}
.ev-live{background:var(--gCard);color:#fff}
.ev-pr{background:var(--tM);color:#0D5C47;box-shadow:inset 3px 0 0 var(--mint)}
.ev-mt{background:var(--tS);color:#6E4A00;box-shadow:inset 3px 0 0 var(--sun)}
.cal-ls{display:none}
.cal-f{display:flex;gap:26px;margin-top:16px;font-size:15px;color:var(--ink2);flex-wrap:wrap}
.cal-f span{display:flex;align-items:center;gap:8px}
.cal-f i{width:14px;height:14px;border-radius:4px}

/* ---------- 6 mentors ---------- */
.mt-grid{flex:1;display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:44px;min-height:0}
.mt{padding:30px 30px 28px;display:flex;flex-direction:column}
.mt-m{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:auto;padding-top:22px}
.mt-m div{border-radius:18px;background:var(--tint);padding:14px 16px}
.mt-m b{display:block;font-family:Unbounded,sans-serif;font-weight:600;font-size:26px;letter-spacing:-.03em}
.mt-m span{font-size:14.5px;color:var(--ink2)}
.mt-top{display:flex;align-items:center;gap:18px}
.av{width:84px;height:84px;border-radius:50%;background:var(--g);display:grid;place-items:center;color:#fff;font-family:Unbounded,sans-serif;font-weight:600;font-size:26px;flex:none;position:relative}
.av.sm{width:52px;height:52px;font-size:17px}
.mt h3{font-size:24px;font-weight:700;letter-spacing:-.01em}
.mt .role{font-size:16px;color:var(--mut);margin-top:4px}
.mt p{font-size:var(--fs-s);line-height:1.5;color:var(--ink2);margin-top:20px}
.mt .tag{display:inline-block;align-self:flex-start;margin-top:18px;font-size:15px;font-weight:600;padding:8px 14px;border-radius:999px;background:var(--tint)}
.mt-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:36px}
.mt-stats div{display:flex;align-items:baseline;gap:18px;padding-top:20px;border-top:3px solid var(--ink)}
.mt-stats .num{font-size:46px;line-height:1}
.mt-stats p{font-size:var(--fs-s);line-height:1.4;color:var(--ink2)}

/* ---------- 7 platform ---------- */
