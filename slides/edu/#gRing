 if(p&&p.catch)p.catch(()=>{})}catch(e){}}
fsBtn.addEventListener('click',toggleFs);
['fullscreenchange','webkitfullscreenchange'].forEach(ev=>document.addEventListener(ev,()=>{fsBtn.setAttribute('aria-pressed',String(!!(document.fullscreenElement||document.webkitFullscreenElement)));fit()}));
const doPrint=()=>{try{window.print()}catch(e){}};
$('#pdfBtn').addEventListener('click',doPrint);$('#pdf2').addEventListener('click',doPrint);
addEventListener('beforeprint',()=>{slides.forEach(s=>s.classList.add('is-on'));finalCounts(document)});
addEventListener('afterprint',()=>{if(!feed)slides.forEach((s,j)=>{if(j!==cur)s.classList.remove('is-on')})});

/* ---------- toast ---------- */
let tT;const toast=m=>{const t=$('#toast');t.textContent=m;t.classList.add('on');clearTimeout(tT);tT=setTimeout(()=>t.classList.remove('on'),2200)};

/* ---------- platform tabs ---------- */
const tabs=$$('.pl-tab'),scrs=$$('.scr'),wsi=$$('.ws-i');
function setTab(n,focus){tabs.forEach((t,i)=>{const on=i===n;t.setAttribute('aria-selected',String(on));t.tabIndex=on?0:-1;if(on&&focus)t.focus()});scrs.forEach((s,i)=>s.classList.toggle('is-cur',i===n));wsi.forEach((w,i)=>w.classList.toggle('on',i===n));store.set('tab',n)}
tabs.forEach((t,i)=>{t.addEventListener('click',()=>setTab(i));t.addEventListener('keydown',e=>{const k=e.key;let n=null;if(k==='ArrowDown'||k==='ArrowRight')n=(i+1)%tabs.length;else if(k==='ArrowUp'||k==='ArrowLeft')n=(i-1+tabs.length)%tabs.length;else if(k==='Home')n=0;else if(k==='End')n=tabs.length-1;if(n!==null){e.preventDefault();setTab(n,true)}})});
setTab(Math.max(0,Math.min(3,+store.get('tab',0)||0)));

/* ---------- pricing ---------- */
const PLANS=[{p:32000,inc:['Живые занятия и записи на весь срок','Практика с автопроверкой и куратором','Чат группы и база знаний']},
 {p:46000,inc:['Всё из «Базового»','Наставник проверяет каждую работу за 48 часов','Созвон один на один раз в две недели']},
 {p:58000,inc:['Всё из формата «С наставником»','Практика на данных и процессах компании','Ежемесячный отчёт для HR и защита проектов']}];
const TIERS=[[5,0],[20,.1],[50,.15],[100,.2],[250,.25]];
const emp=$('#emp'),empV=$('#empV'),empW=$('#empW'),planBtns=$$('[data-plan]');
const PW=2.2,toN=v=>{let n=5+495*Math.pow(v/100,PW);n=n<30?Math.round(n):n<100?Math.round(n/5)*5:Math.round(n/10)*10;return Math.max(5,Math.min(500,n))};
const toV=n=>Math.round(100*Math.pow((n-5)/495,1/PW)*10)/10;
const disc=n=>{let d=0;TIERS.forEach(t=>{if(n>=t[0])d=t[1]});return d};
const plural=(n,a,b,c)=>{const m=n%10,h=n%100;return m===1&&h!==11?a:m>=2&&m<=4&&(h<10||h>=20)?b:c};
let P=store.get('price',{plan:1,n:50});if(!P||typeof P!=='object'||!(P.plan>=0&&P.plan<=2)||!(P.n>=5&&P.n<=500))P={plan:1,n:50};
const tiersEl=$('#tiers');
TIERS.forEach((t,i)=>{const d=document.createElement('span');d.className='tier';d.style.setProperty('--p',(i===0?0:toV(t[0]))+'%');d.innerHTML='<b>'+(t[1]?'−'+Math.round(t[1]*100)+' %':'без скидки')+'</b>'+(i===0?'от 5':'от '+t[0]);tiersEl.appendChild(d)});
const tierEls=$$('.tier',tiersEl);
const anim={};
function tween(el,to,fmt){if(RM.matches||!el._v&&el._v!==0){el._v=to;el.textContent=fmt(to);return}const from=el._v,t0=performance.now();cancelAnimationFrame(anim[el.id]);el._v=to;
 const st=t=>{const p=Math.min(1,(t-t0)/450),e=1-Math.pow(1-p,3);el.textContent=fmt(from+(to-from)*e);if(p<1)anim[el.id]=requestAnimationFrame(st)};anim[el.id]=requestAnimationFrame(st)}
function renderPrice(sync){
 const n=P.n,pl=PLANS[P.plan],d=disc(n),one=Math.round(pl.p*(1-d)/100)*100,tot=one*n,save=pl.p*n-tot;
 if(sync)emp.value=toV(n);
 emp.style.setProperty('--p',emp.value+'%');
 empV.textContent=n;empW.textContent=plural(n,'сотрудник','сотрудника','сотрудников');
 emp.setAttribute('aria-valuetext',n+' '+empW.textContent);
 $('#empM').disabled=n<=5;$('#empP').disabled=n>=500;
 planBtns.forEach((b,i)=>b.setAttribute('aria-pressed',String(i===P.plan)));
 tween($('#prOne'),one,rub);tween($('#prTot'),tot,rub);tween($('#prSave'),save,rub);
 const old=$('#prOld');old.textContent=rub(pl.p);old.hidden=!d;
 const dc=$('#prDisc');dc.textContent=d?'скидка '+Math.round(d*100)+' % за объём':'скидка начинается от 20 сотрудников';dc.classList.toggle('zero',!d);
 $('#prInc').innerHTML=pl.inc.map(x=>'<li>'+x.replace(/ (\S{1,2}) /g,' $1 ')+'</li>').join('');
 let ti=0;TIERS.forEach((t,i)=>{if(n>=t[0])ti=i});tierEls.forEach((t,i)=>t.classList.toggle('on',i===ti));
 $('#tb5').innerHTML=TIERS.map((t,i)=>{const v=Math.round(pl.p*(1-t[1])/100)*100;return '<div class="'+(i===ti?'on':'')+'"><i style="--h:'+Math.round(v/pl.p*100)+'"></i><span>'+nf(v/1000,1).replace(',0','')+'\u00A0тыс.</span><small>от '+t[0]+'</small></div>'}).join('');
 const nt=TIERS[ti+1];$('#prNext').textContent=nt?'Ещё '+(nt[0]-n)+' '+plural(nt[0]-n,'сотрудник','сотрудника','сотрудников')+' — и скидка вырастет до '+Math.round(nt[1]*100)+' %.':'Это максимальная скидка по объёму.';
 $('#prPay').textContent='Оплата частями: три платежа по '+rub(Math.round(tot/3/100)*100)+' — при старте, через месяц и через два.';
 store.set('price',P);
 clearTimeout(renderPrice._t);renderPrice._t=setTimeout(()=>{$('#prLive').textContent=n+' '+empW.textContent+': '+rub(one)+' за сотрудника, итого '+rub(tot)},700);
}
emp.addEventListener('input',()=>{P.n=toN(+emp.value);renderPrice(false)});
emp.addEventListener('change',()=>{emp.value=toV(P.n);emp.style.setProperty('--p',emp.value+'%')});
const stepOf=n=>n<30?1:n<100?5:10;
$('#empM').addEventListener('click',()=>{const s=stepOf(P.n-1);P.n=Math.max(5,P.n-s);renderPrice(true)});
$('#empP').addEventListener('click',()=>{const s=stepOf(P.n);P.n=Math.min(500,P.n+s);renderPrice(true)});
planBtns.forEach(b=>b.addEventListener('click',()=>{P.plan=+b.dataset.plan;renderPrice(false)}));
renderPrice(true);

/* ---------- reset ---------- */
$('#resetBtn').addEventListener('click',()=>{store.clear();P={plan:1,n:50};renderPrice(true);setTab(0);closeOv();go(0,{instant:true});toast('Демо сброшено: расчёт и экраны вернулись к началу')});

/* ---------- init ---------- */
const fromHash=()=>{const m=/^#(\d{1,2})$/.exec(location.hash);if(!m)return null;const n=+m[1];return n>=1&&n<=N?n-1:null};
addEventListener('hashchange',()=>{const h=fromHash();if(h!==null&&h!==cur)go(h,{instant:feed})});
let rz;addEventListener('resize',()=>{cancelAnimationFrame(rz);rz=requestAnimationFrame(()=>{const was=feed;fit();if(was!==feed){feed?feedOn():feedOff()}if(ovOpen)sizeThumbs()})});
fit();
const start=fromHash()||0;
if(feed){feedOn();setCur(start);if(start>0)requestAnimationFrame(()=>go(start,{instant:true}))}
else show(start);
})();
</script>
