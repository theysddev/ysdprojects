.en-links a,.en-links li>span{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;padding:0 26px;font:500 18px/1.2 var(--fb);text-decoration:none;transition:background-color .2s ease}
.en-links a:hover{background:var(--ln3)}
