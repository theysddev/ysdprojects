.rk-detail h3{font:600 26px/1.2 var(--fd);margin:8px 0 14px}
.rk-detail dl div{padding:10px 0;border-top:1px solid var(--ln2)}
.rk-detail dt{font:500 11.5px/1 var(--fm);letter-spacing:.07em;text-transform:uppercase;color:var(--ink2);margin-bottom:6px}
.rk-detail dd{font-size:17px;line-height:1.45}
.gr h3{font:600 22px/1.2 var(--fd);margin-bottom:8px}
.gr li{padding:11px 0;border-top:1px solid var(--ln2);font-size:16.5px;line-height:1.4}
.gr li b{display:block;font:600 22px/1.15 var(--fd);color:var(--sig);margin-bottom:2px}

/* ---------- 12 contacts ---------- */
.s-end{display:grid;grid-template-columns:1fr 560px;gap:70px;align-items:center;padding-top:64px}
.en-big{font:300 120px/.95 var(--fd);letter-spacing:-.03em;color:var(--sig);margin:18px 0 6px}
