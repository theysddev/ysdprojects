  .feed #stage .tb b{font-size:14px}.feed #stage .tb .tb-n b{font-size:16px}
  .feed #stage .tb small{font-size:9.5px}
  .feed #stage .hd,.feed #stage .ts-top,.feed #stage .gt-top,.feed #stage .of-top{display:block}
  .feed .bar{top:0;bottom:auto;height:54px;padding:0 8px 0 16px;border-top:0;border-bottom:1px solid rgba(232,241,255,.18)}
  .feed .bar::after{content:"";position:absolute;left:0;bottom:-1px;height:3px;width:var(--prog,0%);background:var(--sig);transition:width .4s var(--e)}
  .feed #bPrev,.feed #bNext,.feed #bFs,.feed #bPdf{display:none}
  .feed .bar-brand span{display:none}
  .feed .fab{display:grid;place-items:center;position:fixed;right:14px;bottom:calc(16px + env(safe-area-inset-bottom));z-index:20;width:56px;height:56px;background:var(--sig);color:#0A2F5E;box-shadow:0 10px 24px -8px rgba(0,0,0,.6);transition:transform .2s var(--e)}
  .feed .fab svg{width:22px;height:22px;transition:transform .3s var(--e)}
  .feed .fab.up svg{transform:rotate(180deg)}
  .feed .fab:active{transform:scale(.94)}
  .feed #stage .seg button{min-height:44px;padding:0 12px;font-size:13px}
  .feed #stage .sw{font-size:14px}
