.en-docs li::before{content:"";position:absolute;left:2px;top:16px;width:11px;height:6px;border-left:2px solid var(--sig);border-bottom:2px solid var(--sig);transform:rotate(-45deg)}
.en-card{border:2px solid var(--ln);background:rgba(8,38,80,.55)}
