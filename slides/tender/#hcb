  .feed #stage .tb{position:relative;right:auto;bottom:auto;width:auto;height:auto;margin:30px -8px -20px -14px;grid-template-columns:1fr 54px 54px;border-top:1px solid var(--ln);border-left:0}
  .feed #stage .tb>div{padding:7px 10px}
