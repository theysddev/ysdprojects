.en-act{display:flex;gap:12px;padding:20px 26px}
.s-end .demo-n{position:absolute;left:118px;bottom:40px;max-width:760px}

/* ---------- chrome ---------- */
.ruler{position:fixed;left:0;right:0;top:0;height:var(--topH);z-index:20;display:flex;background:var(--bpx);border-bottom:1px solid rgba(232,241,255,.14)}
.rl{position:relative;flex:1;height:100%;display:flex;align-items:flex-end;justify-content:flex-start;padding:0 0 6px 8px;font:500 11px/1 var(--fm);letter-spacing:.06em;color:rgba(183,204,234,.75);border-left:1px solid rgba(232,241,255,.3);transition:background-color .2s ease,color .2s ease}
.rl::before{content:"";position:absolute;left:0;right:0;top:0;height:9px;background:repeating-linear-gradient(90deg,rgba(232,241,255,.3) 0 1px,transparent 1px 20%)}
.rl::after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:transparent;transition:background-color .3s ease}
.rl.past::after{background:rgba(255,210,63,.55)}
.rl[aria-current="step"]{background:var(--sig);color:#0A2F5E}
.rl[aria-current="step"]::before{background:repeating-linear-gradient(90deg,rgba(10,47,94,.5) 0 1px,transparent 1px 20%)}
.rl:hover{color:var(--ink);background:rgba(232,241,255,.06)}
.rl[aria-current="step"]:hover{background:var(--sig);color:#0A2F5E}
.rl span{position:relative}
.bar{position:fixed;left:0;right:0;bottom:0;height:var(--barH);z-index:20;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 14px 0 20px;background:var(--bpx);border-top:1px solid rgba(232,241,255,.14)}
.bar-brand{display:flex;align-items:center;gap:14px;min-width:0}
.bar-brand b{font:700 17px/1 var(--fd);letter-spacing:.2em}
.bar-brand span{font:500 12px/1 var(--fm);letter-spacing:.06em;text-transform:uppercase;color:var(--ink2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bar-ctl{display:flex;align-items:center;gap:6px}
.count{font:500 13px/1 var(--fm);letter-spacing:.06em;text-transform:uppercase;color:var(--ink2);margin-right:10px;white-space:nowrap}
.count b{color:var(--sig);font-weight:600}
.ib{width:44px;height:44px;display:grid;place-items:center;border:1px solid rgba(232,241,255,.3);transition:background-color .2s ease,border-color .2s ease,transform .15s var(--e),opacity .2s ease}
.ib svg{width:20px;height:20px}
.ib:hover{background:rgba(232,241,255,.08);border-color:rgba(232,241,255,.7)}
.ib:active{transform:scale(.94)}
.ib:disabled{opacity:.3;cursor:default;background:none}
.ib[aria-pressed="true"]{background:var(--sig);color:#0A2F5E;border-color:var(--sig)}
.tlink{display:inline-flex;align-items:center;min-height:44px;padding:0 10px;font:500 13px/1 var(--fm);letter-spacing:.05em;text-transform:uppercase;color:var(--sig);text-decoration:underline;text-underline-offset:.35em}
.tlink:hover{color:var(--ink)}
.hint{position:fixed;left:50%;bottom:calc(var(--barH) + 16px);z-index:21;transform:translate(-50%,8px);opacity:0;pointer-events:none;background:var(--bpx);border:1px solid rgba(232,241,255,.3);color:var(--ink);padding:10px 16px;font:500 12.5px/1 var(--fm);letter-spacing:.04em;white-space:nowrap;transition:opacity .3s ease,transform .4s var(--e)}
.hint.show{opacity:1;transform:translate(-50%,0)}
.hint kbd{font:600 12px/1 var(--fm);color:var(--sig);border:1px solid rgba(255,210,63,.6);padding:3px 6px;margin:0 2px}
.edge{position:fixed;top:50%;z-index:5;width:44px;height:44px;margin-top:-22px;display:grid;place-items:center;background:var(--sig);color:#0A2F5E;opacity:0;pointer-events:none;transition:opacity .2s ease,transform .25s var(--e)}
.edge svg{width:20px;height:20px}
.edge-l{left:14px;transform:translateX(-6px)}.edge-r{right:14px;transform:translateX(6px)}
.deck[data-edge="l"],.deck[data-edge="r"]{cursor:pointer}
.deck[data-edge="l"]~.edge-l,.deck[data-edge="r"]~.edge-r{opacity:1;transform:none}
.fab{display:none}
.toast{position:fixed;left:50%;top:calc(var(--topH) + 14px);z-index:70;transform:translate(-50%,-8px);opacity:0;pointer-events:none;background:var(--sig);color:#0A2F5E;padding:11px 16px;font:500 14px/1.35 var(--fb);max-width:calc(100vw - 32px);transition:opacity .25s ease,transform .35s var(--e)}
.toast.show{opacity:1;transform:translate(-50%,0)}
@media (max-width:1100px){.bar-brand span{display:none}}
@media (max-width:700px){.rl span{display:none}}
@media (max-height:520px){:root{--topH:28px;--barH:46px}.ib{width:40px;height:40px}}

/* ---------- overview ---------- */
.ov{position:fixed;inset:0;z-index:60;display:flex;flex-direction:column;background:linear-gradient(rgba(232,241,255,.05) 1px,transparent 1px) 0 0/20px 20px,linear-gradient(90deg,rgba(232,241,255,.05) 1px,transparent 1px) 0 0/20px 20px,var(--bpx);opacity:0;transition:opacity .2s ease}
.ov[hidden]{display:none}
.ov.open{opacity:1}
.ov-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 18px 14px 26px;border-bottom:1px solid rgba(232,241,255,.2)}
.ov-head h2{font:600 26px/1 var(--fd);letter-spacing:.02em}
.ov-head p{font:500 12px/1 var(--fm);letter-spacing:.06em;text-transform:uppercase;color:var(--ink2);margin-top:8px}
.ov-act{display:flex;align-items:center;gap:4px}
.ov-grid{flex:1;overflow:auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:30px 26px;padding:30px 30px 46px;align-content:start}
.th{position:relative}
.th-frame{position:relative;aspect-ratio:16/9;overflow:hidden;outline:1px solid rgba(232,241,255,.3);transition:outline-color .2s ease,transform .25s var(--e)}
.th-frame .slide{transform:scale(var(--ts,.18));transform-origin:0 0;pointer-events:none}
.th-frame .slide .a{opacity:1;transform:none;transition:none}
.th-frame .slide .dl{stroke-dashoffset:0;transition:none}
.th-frame .slide .gb,.th-frame .slide .hb,.th-frame .slide .g-ms{transform:none;opacity:1;transition:none}
.th-cap{display:flex;gap:12px;align-items:baseline;margin-top:12px;font-size:15px}
.th-cap b{font:600 12px/1 var(--fm);letter-spacing:.06em;color:var(--sig)}
.th-btn{position:absolute;inset:-6px;border-radius:0}
.th:hover .th-frame{outline-color:var(--ink);transform:translateY(-3px)}
.th.is-cur .th-frame{outline:3px solid var(--sig)}
.th.is-cur .th-cap::after{content:"текущий лист";margin-left:auto;font:500 11px/1 var(--fm);letter-spacing:.06em;text-transform:uppercase;color:var(--sig)}

/* ---------- reduced motion ---------- */
@media (prefers-reduced-motion:reduce){
  #stage>.slide.wipe{transition:none}
  .slide .a,.slide.played .a{opacity:1;transform:none;transition:none}
  .dl{transition:none}.slide:not(.played) .dl{stroke-dashoffset:0}
  .gb,.hb,.g-ms,.kp td.p i,.ov,.hint,.toast,.th-frame,.rl,.sw i::after{transition:none}
  .s-gantt:not(.played) .gb,.s-res:not(.played) .hb{transform:none}.s-gantt:not(.played) .g-ms{opacity:1}
  .scan{display:none}
}

