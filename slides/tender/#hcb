.org-note{position:absolute;left:0;bottom:0;display:flex;gap:12px;align-items:center;font-size:16px;color:var(--ink2)}

/* ---------- 10 offer ---------- */
.of-top{display:flex;justify-content:space-between;align-items:flex-end;gap:30px}
