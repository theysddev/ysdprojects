.tl{position:relative;margin:auto 0}
.tl-axis{position:relative;height:30px;margin-left:430px;font-size:14px;color:var(--choc2)}
.tl-axis span{position:absolute;top:0;transform:translateX(-50%);white-space:nowrap}
.tl-grid{position:absolute;left:430px;right:0;top:30px;bottom:0;background:repeating-linear-gradient(90deg,rgba(46,33,27,.16) 0 1px,transparent 1px calc(100% / 9));border-right:1px solid rgba(46,33,27,.16);pointer-events:none}
.tl-rows li{position:relative;display:grid;grid-template-columns:430px 1fr;align-items:center;height:62px;border-top:1px dashed rgba(46,33,27,.2)}
