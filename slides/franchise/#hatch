.tl-name{font-size:20px;padding-right:26px}
.tl-track{position:relative;height:100%}
.tl-bar{position:absolute;top:14px;bottom:14px;left:calc((var(--s) - 1) / 90 * 100%);width:calc((var(--e) - var(--s) + 1) / 90 * 100%);border-radius:15px;background:linear-gradient(180deg,#D9913E,var(--crust) 55%,#8F4A17);box-shadow:inset 0 2px 0 rgba(255,230,180,.45),0 3px 6px -3px rgba(46,33,27,.6);transform-origin:left;transition:transform .8s var(--e) calc(.45s + var(--j)*.12s)}
