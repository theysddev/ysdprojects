function fit(){
  var f=isFeed();if(f!==feed)setMode(f);
  if(!feed){var bh=bar.offsetHeight||68,m=innerWidth>1000?28:12;var k=Math.min((innerWidth-m*2)/1600,(innerHeight-bh-m*1.4)/900);stage.style.setProperty('--k',Math.max(.1,k).toFixed(4))}
  if(ovOpen)scaleThumbs();
}
var rT=0;addEventListener('resize',function(){cancelAnimationFrame(rT);rT=requestAnimationFrame(fit)});

/* keyboard */
addEventListener('keydown',function(e){
  if(e.defaultPrevented||e.metaKey||e.ctrlKey||e.altKey)return;
  var k=e.key,t=e.target,tag=t&&t.tagName,edit=tag==='INPUT'||tag==='TEXTAREA'||tag==='SELECT'||(t&&t.isContentEditable);
  if(ovOpen){
    if(k==='Escape'||k==='o'||k==='O'||k==='щ'||k==='Щ'){e.preventDefault();closeOv();return}
    if(k==='Tab'){trap(e);return}
    if(k==='ArrowRight'||k==='ArrowLeft'||k==='ArrowDown'||k==='ArrowUp'){var bs=$$('.th-btn',$('#ovGrid')),ix=bs.indexOf(D.activeElement);if(ix<0)ix=cur;var cols=Math.max(1,Math.round($('#ovGrid').clientWidth/((bs[0]&&bs[0].offsetWidth)||300)));var dlt={ArrowRight:1,ArrowLeft:-1,ArrowDown:cols,ArrowUp:-cols}[k];var ni=Math.max(0,Math.min(bs.length-1,ix+dlt));if(bs[ni]){bs[ni].focus();e.preventDefault()}}
    return}
  if(edit&&k!=='PageUp'&&k!=='PageDown'&&k!=='Escape')return;
  var onBtn=tag==='BUTTON'||tag==='A';
  if(feed&&(k==='ArrowDown'||k==='ArrowUp'||k===' '))return;
  switch(k){
    case 'ArrowRight':case 'ArrowDown':case 'PageDown':e.preventDefault();next();break;
    case 'ArrowLeft':case 'ArrowUp':case 'PageUp':e.preventDefault();prev();break;
    case ' ':case 'Spacebar':if(onBtn)return;e.preventDefault();if(e.shiftKey)prev();else next();break;
    case 'Home':e.preventDefault();go(0,{scroll:true});break;
    case 'End':e.preventDefault();go(N-1,{scroll:true});break;
    case 'o':case 'O':case 'щ':case 'Щ':e.preventDefault();openOv();break;
    case 'f':case 'F':case 'а':case 'А':e.preventDefault();toggleFs();break;
  }
});

/* swipe + edge click */
var tx=0,ty=0,tt=0,tOk=false;
deck.addEventListener('touchstart',function(e){if(feed||e.touches.length>1){tOk=false;return}tOk=!e.target.closest('input,textarea,select,[data-noswipe]');var p=e.touches[0];tx=p.clientX;ty=p.clientY;tt=Date.now()},{passive:true});
deck.addEventListener('touchend',function(e){if(!tOk||feed)return;tOk=false;var p=e.changedTouches[0],dx=p.clientX-tx,dy=p.clientY-ty;if(Math.abs(dx)>40&&Math.abs(dx)>Math.abs(dy)*1.3&&Date.now()-tt<900){if(dx<0)next();else prev()}},{passive:true});
function edgeZone(e){if(e.target.closest('a,button,input,label,select,textarea,output,[data-noedge]'))return '';var w=innerWidth;return e.clientX<w*.12?'l':(e.clientX>w*.88?'r':'')}
deck.addEventListener('click',function(e){if(feed)return;var s=window.getSelection&&String(window.getSelection());if(s)return;var z=edgeZone(e);if(z==='l')prev();else if(z==='r')next()});
deck.addEventListener('mousemove',function(e){if(feed)return;var z=edgeZone(e);if(deck.dataset.edge!==z)deck.dataset.edge=z});
deck.addEventListener('mouseleave',function(){deck.dataset.edge=''});

/* fullscreen, pdf */
var fsOK=!!(D.fullscreenEnabled&&root.requestFullscreen);
if(!fsOK)$('#bFs').hidden=true;
function toggleFs(){if(!fsOK)return;try{if(D.fullscreenElement){var p=D.exitFullscreen();if(p&&p.catch)p.catch(function(){})}else{var q=root.requestFullscreen();if(q&&q.catch)q.catch(function(){toast('Браузер не разрешил полноэкранный режим')})}}catch(err){}}
D.addEventListener('fullscreenchange',function(){$('#bFs').setAttribute('aria-pressed',String(!!D.fullscreenElement));fit()});
$('#bFs').addEventListener('click',toggleFs);
function doPrint(){if(ovOpen)closeOv();setTimeout(function(){try{window.print()}catch(err){}},80)}
$('#bPdf').addEventListener('click',doPrint);$('#bPdf2').addEventListener('click',doPrint);

/* overview */
var ov=$('#ov'),ovGrid=$('#ovGrid'),lastFocus=null,ovT=0;
function scaleThumbs(){var f=$('.th-frame',ovGrid);if(f&&f.clientWidth)ov.style.setProperty('--ts',(f.clientWidth/1600).toFixed(5))}
function buildOv(){
  ovGrid.innerHTML='';
  slides.forEach(function(s,i){
    var li=D.createElement('li');li.className='th'+(i===cur?' is-cur':'');
    var fr=D.createElement('div');fr.className='th-frame';fr.setAttribute('aria-hidden','true');
    var c=s.cloneNode(true);c.removeAttribute('aria-label');c.removeAttribute('aria-roledescription');c.removeAttribute('aria-hidden');
    $$('[id]',c).forEach(function(n){n.removeAttribute('id')});$$('[for],[name],[aria-live]',c).forEach(function(n){n.removeAttribute('for');n.removeAttribute('name');n.removeAttribute('aria-live')});
    c.classList.add('played');c.classList.remove('is-before','is-active');c.inert=true;fr.appendChild(c);
    var cap=D.createElement('div');cap.className='th-cap';cap.setAttribute('aria-hidden','true');cap.innerHTML='<b>'+pad(i+1)+'</b><span>'+esc(s.dataset.title)+'</span>';
    var b=D.createElement('button');b.type='button';b.className='th-btn';b.dataset.i=i;b.setAttribute('aria-label','Слайд '+(i+1)+': '+s.dataset.title+(i===cur?', текущий':''));
    li.appendChild(fr);li.appendChild(cap);li.appendChild(b);ovGrid.appendChild(li);
  });
}
function openOv(){
  if(ovOpen)return;lastFocus=D.activeElement;clearTimeout(ovT);buildOv();ov.hidden=false;ovOpen=true;root.classList.add('ov-open');hideHint();
  requestAnimationFrame(function(){scaleThumbs();ov.classList.add('open');var b=$('.th.is-cur .th-btn',ovGrid);if(b){b.focus({preventScroll:true});b.closest('.th').scrollIntoView({block:'nearest'})}});
}
function closeOv(){
  if(!ovOpen)return;ovOpen=false;ov.classList.remove('open');root.classList.remove('ov-open');
  ovT=setTimeout(function(){if(!ovOpen){ov.hidden=true;ovGrid.innerHTML=''}},230);
  if(lastFocus&&lastFocus.focus&&D.contains(lastFocus)&&!lastFocus.closest('#ov'))lastFocus.focus({preventScroll:true});
}
function trap(e){var f=$$('button:not([hidden])',ov).filter(function(b){return b.offsetParent!==null});if(!f.length)return;var a=f[0],z=f[f.length-1];if(e.shiftKey&&D.activeElement===a){e.preventDefault();z.focus()}else if(!e.shiftKey&&D.activeElement===z){e.preventDefault();a.focus()}}
$('#bOv').addEventListener('click',openOv);$('#ovClose').addEventListener('click',closeOv);
ovGrid.addEventListener('click',function(e){var b=e.target.closest('.th-btn');if(!b)return;var i=+b.dataset.i;closeOv();go(i,{scroll:true})});
$('#bReset').addEventListener('click',function(){try{localStorage.removeItem(KEY)}catch(err){}state=defaults('home');fmPrev=null;setFmt('home',false);closeOv();go(0,{scroll:true});toast('Демо сброшено: формат и расчёт вернулись к исходным')});

/* hint */
function hideHint(){var h=$('#hint');if(h)h.classList.remove('show')}
function showHint(){if(feed||navd||matchMedia('(hover:none)').matches)return;var h=$('#hint');h.classList.add('show');hintT=setTimeout(hideHint,6500)}

/* hash */
addEventListener('hashchange',function(){var n=parseInt(location.hash.slice(1),10);if(n>=1&&n<=N&&n-1!==cur)go(n-1,{scroll:true,noHash:true})});

/* init */
(function(){var n=parseInt(location.hash.slice(1),10);cur=(n>=1&&n<=N)?n-1:0})();
setFmt(state.fmt,false);
fit();ui();
if(!feed)setTimeout(showHint,900);
})();
</script>
