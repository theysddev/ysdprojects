.ca-out{position:relative;border-radius:4px;padding:30px 36px 24px;color:var(--flour);background:var(--dust),radial-gradient(120% 120% at 15% 0%,#3D2C23,#271B15);box-shadow:0 18px 34px -20px rgba(46,33,27,.8)}
