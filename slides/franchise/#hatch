/* ---------- chrome ---------- */
.bar{position:fixed;left:0;right:0;bottom:0;height:var(--barH);z-index:20;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 22px;background:var(--dust),#2A1E18;color:var(--flour)}
.bar-brand{display:flex;align-items:center;gap:10px;font:400 18px/1 var(--fd);white-space:nowrap}
