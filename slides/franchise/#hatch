.bar-line{position:absolute;left:0;right:0;top:0;height:3px;background:rgba(251,246,236,.1)}
.bar-line i{display:block;height:100%;width:0;background:var(--gold2);transition:width .5s var(--e)}
.dots{display:flex;align-items:center}
.dot{position:relative;width:26px;height:44px;display:grid;place-items:center}
.dot::after{content:"";width:8px;height:8px;border-radius:4px;background:rgba(251,246,236,.32);transition:width .35s var(--e),background-color .2s ease}
.dot.past::after{background:var(--gold)}
.dot[aria-current="step"]::after{width:22px;background:var(--gold2)}
.dot:hover::after{background:var(--flour)}
.bar-ctl{display:flex;align-items:center;gap:8px}
.count{font:italic 400 20px/1 var(--fd);margin-right:10px;font-variant-numeric:lining-nums tabular-nums;white-space:nowrap}
.count b{font-weight:400;color:var(--gold2)}
.ib{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;box-shadow:inset 0 0 0 1.5px rgba(251,246,236,.3);transition:background-color .2s ease,box-shadow .2s ease,transform .15s var(--e),opacity .2s ease}
.ib svg{width:20px;height:20px}
.ib:hover{background:rgba(251,246,236,.12);box-shadow:inset 0 0 0 1.5px rgba(251,246,236,.6)}
.ib:active{transform:scale(.94)}
.ib:disabled{opacity:.3;cursor:default;background:none}
.ib[aria-pressed="true"]{background:var(--gold2);color:var(--choc)}
.bar :focus-visible,.ov :focus-visible{outline-color:var(--gold2)}
.hint{position:fixed;left:50%;bottom:calc(var(--barH) + 18px);z-index:21;transform:translate(-50%,8px);opacity:0;pointer-events:none;background:#2A1E18;color:var(--flour);border-radius:999px;padding:11px 20px;font-size:14px;white-space:nowrap;box-shadow:0 10px 30px -10px rgba(0,0,0,.5);transition:opacity .3s ease,transform .4s var(--e)}
.hint.show{opacity:1;transform:translate(-50%,0)}
.hint kbd{font:600 12px/1 var(--fb);border:1px solid rgba(251,246,236,.4);border-radius:5px;padding:3px 6px;margin:0 2px}
.edge{position:fixed;top:50%;z-index:5;width:46px;height:46px;margin-top:-56px;border-radius:50%;display:grid;place-items:center;background:rgba(42,30,24,.82);color:var(--flour);opacity:0;pointer-events:none;transition:opacity .2s ease,transform .25s var(--e)}
.edge svg{width:20px;height:20px}
.edge-l{left:18px;transform:translateX(-6px)}
.edge-r{right:18px;transform:translateX(6px)}
.deck[data-edge="l"]{cursor:pointer}.deck[data-edge="r"]{cursor:pointer}
.deck[data-edge="l"]~.edge-l,.deck[data-edge="r"]~.edge-r{opacity:1;transform:none}
.fab{display:none}
.toast{position:fixed;left:50%;top:22px;z-index:70;transform:translate(-50%,-10px);opacity:0;pointer-events:none;background:#2A1E18;color:var(--flour);border-radius:12px;padding:12px 18px;font-size:15px;max-width:calc(100vw - 32px);box-shadow:0 12px 30px -10px rgba(0,0,0,.5);transition:opacity .25s ease,transform .35s var(--e)}
.toast.show{opacity:1;transform:translate(-50%,0)}

@media (max-width:1100px){.dots{display:none}}
@media (max-width:760px){.bar-brand span{display:none}}
@media (max-height:520px){:root{--barH:54px}.ib{width:40px;height:40px}.count{font-size:17px}}
/* ---------- overview ---------- */
.ov{position:fixed;inset:0;z-index:60;display:flex;flex-direction:column;background:var(--noise),var(--fiber),#CDB68D;opacity:0;transition:opacity .22s ease}
.ov[hidden]{display:none}
.ov.open{opacity:1}
.ov-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 28px;background:#2A1E18;color:var(--flour)}
.ov-head h2{font:400 30px/1 var(--fd)}
.ov-head p{font-size:14px;color:rgba(251,246,236,.7);margin-top:6px}
.ov-act{display:flex;align-items:center;gap:6px}
.ov-act .tlink{color:var(--gold2);padding:0 10px}
.ov-act .tlink:hover{color:var(--flour)}
.ov-grid{flex:1;overflow:auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:34px 30px;padding:34px 34px 48px;align-content:start;-webkit-overflow-scrolling:touch}
.th{position:relative;transform:rotate(var(--r,0deg));transition:transform .3s var(--e)}
.th:nth-child(3n+1){--r:-.8deg}.th:nth-child(3n+2){--r:.6deg}.th:nth-child(3n){--r:-.3deg}
.th:hover,.th:focus-within{--r:0deg;transform:rotate(0) translateY(-4px)}
.th-frame{position:relative;aspect-ratio:16/9;overflow:hidden;border-radius:3px;background:var(--kraft);box-shadow:0 0 0 6px var(--flour),0 14px 26px -12px rgba(46,33,27,.6)}
.th-frame .slide{transform:scale(var(--ts,.18));transform-origin:0 0;pointer-events:none}
.th-frame .slide .a,.th-frame .slide .stamp{opacity:1;transform:none;transition:none}
.th-frame .slide .stamp{transform:rotate(-7deg)}
.th-cap{display:flex;gap:10px;align-items:baseline;margin-top:16px;font-size:16px}
.th-cap b{font:italic 400 20px/1 var(--fd);color:var(--crustInk)}
.th-btn{position:absolute;inset:-6px -6px auto -6px;height:calc(100% + 12px);border-radius:6px}
.th.is-cur .th-frame{box-shadow:0 0 0 6px var(--flour),0 0 0 9px var(--berry),0 14px 26px -12px rgba(46,33,27,.6)}
.th.is-cur .th-cap::after{content:"вы здесь";font:400 20px/1 var(--fh);color:var(--berry);margin-left:auto}
.th-btn:focus-visible{outline:3px solid var(--berry);outline-offset:4px}

/* ---------- reduced motion ---------- */
@media (prefers-reduced-motion:reduce){
  #stage>.slide,#stage>.slide.is-before,#stage>.slide.is-active{transform:none;transition:none}
  .slide .a,.slide.played .a,.slide .stamp,.slide.played .stamp{opacity:1;transition:none}
  .slide .a,.slide.played .a{transform:rotate(var(--rot,0deg))}
  .slide.played .stamp,.slide .stamp{transform:rotate(-7deg)}
  .draw,.seg,.vb i,.tl-bar,.cc-list .cc-bar i,.fm-svg,.th,.ov,.hint,.toast,.bar-line i,.dot::after{transition:none}
  .slide:not(.played) .draw{stroke-dashoffset:0}
  .s-why:not(.played) .vb i,.s-inv:not(.played) .seg,.s-plan:not(.played) .tl-bar,.s-concept:not(.played) .cc-list .cc-bar i{transform:none}
  .s-plan:not(.played) .tl-d{opacity:1}
  .s-cover .loaf .rise,.s-cover .loaf .flour,.s-cover .cv-ring{opacity:1;transform:none}
  .s-cover .cv-ring{transform:translate(-50%,-50%)}
}

/* ---------- feed (mobile portrait) ---------- */
@media screen{
  html.feed,html.feed body{height:auto;overflow:visible}
  html.feed body{overflow-x:hidden;background:#2A1E18}
  .feed .deck{position:static;padding-top:58px}
