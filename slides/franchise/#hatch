.tl-stamp{flex:none;margin:0 10px 20px 0;font:700 17px/1.2 var(--fd);letter-spacing:.12em;text-transform:uppercase;color:var(--berry);border:2.5px solid currentColor;outline:1px solid currentColor;outline-offset:3px;padding:10px 16px;transform:rotate(-4deg);text-align:center;-webkit-mask:var(--inkmask);mask:var(--inkmask)}
.tl-stamp span{display:block;font:400 26px/1.1 var(--fh);letter-spacing:0;text-transform:none}
@media screen{.s-plan:not(.played) .tl-bar{transform:scaleX(0)}.s-plan .tl-d{transition:opacity .5s ease calc(.9s + var(--j)*.12s)}.s-plan:not(.played) .tl-d{opacity:0}}

/* ---------- 12. end ---------- */
.s-end{display:grid;grid-template-columns:1fr 610px;gap:84px;align-items:center;padding-top:60px}
