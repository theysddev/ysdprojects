@media (hover:hover) and (pointer:fine){.mq:hover .mq-t{animation-play-state:paused}}
/* age picker */
.agebox{display:grid;grid-template-columns:260px 1fr;gap:40px;align-items:center;background:var(--w);border-radius:var(--r);padding:32px 40px;box-shadow:var(--sh);margin-bottom:36px}
.age-rd{display:grid;grid-template-columns:auto auto;justify-content:start;align-items:baseline;column-gap:14px}
.age-lbl{grid-column:1/-1;font-weight:600;color:var(--mut);font-size:15px}
.age-num{font-family:var(--hf);font-weight:700;font-size:clamp(72px,8vw,112px);line-height:1;letter-spacing:-.04em;display:inline-block}
.age-num.pop{animation:pop .45s var(--e)}
@keyframes pop{30%{transform:scale(1.14) rotate(-3deg)}}
.age-yr{font-family:var(--hf);font-weight:600;font-size:22px;color:var(--mut)}
.rng{-webkit-appearance:none;appearance:none;width:100%;height:56px;min-height:0;padding:0;border:0;border-radius:0;background:transparent;margin:0;cursor:pointer;display:block;--p:36%}
.rng::-webkit-slider-runnable-track{height:16px;border-radius:8px;background:linear-gradient(90deg,var(--cor) var(--p),#F2E6D3 var(--p))}
.rng::-webkit-slider-thumb{-webkit-appearance:none;width:50px;height:50px;border-radius:50%;background:var(--w);border:6px solid var(--cor);margin-top:-17px;box-shadow:0 8px 18px rgba(110,70,20,.22);transition:transform .2s var(--e)}
.rng:active::-webkit-slider-thumb{transform:scale(1.1)}
.rng::-moz-range-track{height:16px;border-radius:8px;background:#F2E6D3}
.rng::-moz-range-progress{height:16px;border-radius:8px;background:var(--cor)}
.rng::-moz-range-thumb{width:38px;height:38px;border-radius:50%;background:var(--w);border:6px solid var(--cor);box-shadow:0 8px 18px rgba(110,70,20,.22)}
.rng:focus-visible{outline-offset:6px;border-radius:999px}
.ticks{display:flex;justify-content:space-between;padding:0 18px;font-weight:600;font-size:13px;color:var(--mut);margin-top:2px}
.ticks span{width:14px;text-align:center;transition:color .2s ease,transform .3s var(--e)}
.ticks span.on{color:var(--ink);transform:scale(1.3)}
.age-fit{margin-top:14px;font-weight:600;display:flex;align-items:center;gap:10px}
.age-fit::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--sky)}
@media (max-width:860px){.agebox{grid-template-columns:1fr;gap:16px;padding:24px}.age-rd{column-gap:10px}.age-num{font-size:84px}}
.pgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.pc{background:var(--w);border-radius:24px;overflow:hidden;box-shadow:0 6px 20px rgba(110,70,20,.07);display:flex;flex-direction:column;transition:opacity .45s ease,transform .7s var(--e);will-change:transform}
.pc.off{opacity:.38}
