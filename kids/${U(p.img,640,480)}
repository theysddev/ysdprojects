.burger[aria-expanded="true"] span:nth-child(2){opacity:0;transform:scaleX(0)}
.burger[aria-expanded="true"] span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
.mnav{display:none;position:fixed;inset:var(--hh) 0 0;background:var(--bg);padding:24px 16px 32px;flex-direction:column;gap:6px;opacity:0;transform:translateY(-10px);transition:opacity .25s ease,transform .3s var(--e)}
