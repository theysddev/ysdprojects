const ROOM={en35:'№ 1, игровой',en69:'№ 2',en1014:'№ 3',school:'№ 4',logo:'логопедический',mental:'№ 4',art:'творческая студия',after:'№ 5, продлёнка'};
const S=[[0,'10:00','en35',2],[0,'13:00','after',6],[0,'16:00','school',3],[0,'17:00','en35',1],[0,'18:00','en69',4],
[1,'13:00','after',5],[1,'15:30','logo',1],[1,'16:30','en69',2],[1,'18:00','en1014',3],
[2,'10:00','en35',0],[2,'13:00','after',6],[2,'16:00','school',2],[2,'17:00','en35',3],[2,'18:00','en69',1],
[3,'13:00','after',4],[3,'15:30','logo',2],[3,'16:30','en69',0],[3,'18:00','en1014',2],[3,'19:00','en1014',5],
[4,'13:00','after',6],[4,'16:00','mental',3],[4,'17:00','art',4],[4,'18:00','en69',2],
[5,'10:00','en35',2],[5,'11:00','mental',1],[5,'12:30','art',3],[5,'13:00','school',2],[5,'14:00','en1014',4]];

/* header + burger */
const hd=$('#hd');const onS=()=>hd.classList.toggle('sc',scrollY>24);addEventListener('scroll',onS,{passive:true});onS();
const bg=$('#burger'),mn=$('#mnav');
const setM=o=>{bg.setAttribute('aria-expanded',o);bg.setAttribute('aria-label',o?'Закрыть меню':'Открыть меню');mn.classList.toggle('on',o);document.body.classList.toggle('lock',o)};
bg.addEventListener('click',()=>setM(bg.getAttribute('aria-expanded')!=='true'));
$$('a',mn).forEach(a=>a.addEventListener('click',()=>setM(false)));

/* hero parallax (desktop only) */
const hph=$('#hph');
if(!RM&&matchMedia('(min-width:981px)').matches){let tk=false;addEventListener('scroll',()=>{if(tk)return;tk=true;requestAnimationFrame(()=>{hph.style.transform=`translateY(${Math.min(scrollY,900)*.07}px)`;tk=false})},{passive:true})}

/* marquee: duplicate content */
const mq=$('#mq');mq.innerHTML+=mq.innerHTML;

/* live shapes: look at the pointer, shy away, squash on tap */
const pals=$$('.pal').map(el=>({el,bd:$('.bd',el),pp:$('.pp',el),bub:$('.bub',el),w:el.dataset.w.split('|'),i:0,x:0,y:0,vx:0,vy:0,r:0,ph:Math.random()*6.283}));
const tcs=$$('.tc').map(el=>({el,pp:$('.pp',el),ph:Math.random()*6.283}));
let PX=null,PY=null,pT=0,pTouch=false;
const setP=e=>{PX=e.clientX;PY=e.clientY;pT=performance.now();pTouch=e.pointerType==='touch'};
addEventListener('pointermove',setP,{passive:true});addEventListener('pointerdown',setP,{passive:true});
document.documentElement.addEventListener('pointerleave',()=>{PX=null});
const look=(pp,cx,cy,t,ph,k)=>{let lx,ly;
 if(PX===null){lx=Math.sin(t/1500+ph)*.6;ly=Math.cos(t/2100+ph)*.35}
 else{const dx=PX-cx,dy=PY-cy,d=Math.hypot(dx,dy)||1,n=Math.min(1,d/50);lx=dx/d*n;ly=dy/d*n}
 pp.setAttribute('transform',`translate(${(lx*k).toFixed(2)} ${(ly*k).toFixed(2)})`)};
function say(p,txt){
 p.bub.textContent=txt;p.bub.style.setProperty('--bx','0px');p.el.classList.add('say');
 const r=p.bub.getBoundingClientRect(),vw=document.documentElement.clientWidth;let sh=0;
 if(r.left<10)sh=10-r.left;else if(r.right>vw-10)sh=vw-10-r.right;
 p.bub.style.setProperty('--bx',sh.toFixed(0)+'px');clearTimeout(p.st);p.st=setTimeout(()=>p.el.classList.remove('say'),2600)}
pals.forEach(p=>p.el.addEventListener('click',()=>{
 if(!RM){p.vy-=8;p.vx+=(Math.random()-.5)*7;p.el.classList.remove('boop');void p.el.offsetWidth;p.el.classList.add('boop')}
 say(p,p.w[p.i++%p.w.length])}));
let heroOn=false,teamOn=false,raf=0;
function tick(t){
 if(pTouch&&PX!==null&&t-pT>1600)PX=null;
 if(heroOn)for(const p of pals){
  const rc=p.el.getBoundingClientRect(),cx=rc.left+rc.width/2+p.x,cy=rc.top+rc.height/2+p.y;
  let ax=(Math.sin(t/1700+p.ph)*4-p.x)*.035,ay=(Math.cos(t/2300+p.ph)*5-p.y)*.035;
  if(PX!==null){const dx=cx-PX,dy=cy-PY,d=Math.hypot(dx,dy)||1,R=rc.width/2+110;if(d<R){const f=Math.pow(1-d/R,2)*3.4;ax+=dx/d*f;ay+=dy/d*f}}
  p.vx=(p.vx+ax)*.86;p.vy=(p.vy+ay)*.86;p.x+=p.vx;p.y+=p.vy;
  const m=Math.hypot(p.x,p.y),M=rc.width*.5;if(m>M){p.x*=M/m;p.y*=M/m}
  p.r+=(p.vx*2.6-p.r)*.15;
  p.bd.style.transform=`translate3d(${p.x.toFixed(1)}px,${p.y.toFixed(1)}px,0) rotate(${p.r.toFixed(1)}deg)`;
  if(p.el.classList.contains('say')){p.bub.style.setProperty('--px',p.x.toFixed(1)+'px');p.bub.style.setProperty('--py',p.y.toFixed(1)+'px')}
  look(p.pp,cx,cy,t,p.ph,3.6)}
 if(teamOn)for(const c of tcs){const r=c.pp.closest('svg').getBoundingClientRect();look(c.pp,r.left+r.width/2,r.top+r.height*.5,t,c.ph,2.6)}
 raf=(heroOn||teamOn)?requestAnimationFrame(tick):0}
const wake=()=>{if(!raf&&!RM&&!document.hidden)raf=requestAnimationFrame(tick)};
if(!RM){
 new IntersectionObserver(es=>{heroOn=es[0].isIntersecting;wake()}).observe($('.hero'));
 new IntersectionObserver(es=>{teamOn=es[0].isIntersecting;wake()}).observe($('#teachers'));
 document.addEventListener('visibilitychange',()=>{if(document.hidden){cancelAnimationFrame(raf);raf=0}else wake()});
 setInterval(()=>{const pool=(heroOn?pals:[]).concat(teamOn?tcs:[]);if(!pool.length||document.hidden)return;const p=pool[Math.random()*pool.length|0];p.el.classList.add('blink');setTimeout(()=>p.el.classList.remove('blink'),150)},1100);
 setTimeout(()=>{if(heroOn&&scrollY<200)say(pals[0],'Привет! Нажми на меня')},1600);
}

/* programs */
const grid=$('#pgrid');
grid.innerHTML=P.map((p,i)=>`<article class="pc rv" data-id="${p.id}" style="--d:${i%4}">
<div class="pc-ph"><img src="${U(p.img,640,480)}" width="640" height="480" alt="${p.n}" loading="lazy"><span class="pc-age">${p.a[0]}–${p.a[1]} лет</span></div>
<div class="pc-b"><h3>${p.n}</h3><p class="pc-sub">Чему научится</p><ul class="pc-l">${p.l.map((t,j)=>`<li><i class="sh ${'csl'[j]}"></i>${t}</li>`).join('')}</ul>
<p class="pc-meta"><span>${ic('users')}${p.g}</span><span>${ic('clock')}${p.d}</span></p><p class="pc-sch">${ic('cal')}${p.s}</p>
<div class="pc-f"><p class="pc-pr"><b>${p.pr}</b><span>${p.u}${p.u?' · ':''}${p.note}</span></p><button type="button" class="btn btn-c btn-s btn-w" data-book="${p.id}">Записаться на пробное</button></div></div></article>`).join('');

const age=$('#age'),anum=$('#agenum'),ayr=$('#ageyr'),afit=$('#agefit'),ticks=$$('.ticks span');
function setAge(v,anim){
 v=+v;anum.textContent=v;ayr.textContent=yrs(v);age.setAttribute('aria-valuetext',v+' '+yrs(v));
 age.style.setProperty('--p',((v-3)/11*100)+'%');
 ticks.forEach(t=>t.classList.toggle('on',+t.textContent===v));
 if(anim&&!RM){anum.classList.remove('pop');void anum.offsetWidth;anum.classList.add('pop')}
 const cards=$$('.pc',grid),first=new Map(cards.map(c=>[c,c.getBoundingClientRect()]));
 const fit=c=>{const p=byId(c.dataset.id);return v>=p.a[0]&&v<=p.a[1]};
 const ord=cards.map((c,i)=>({c,i,f:fit(c)})).sort((a,b)=>(b.f-a.f)||(a.i-b.i));
 ord.forEach(o=>{o.c.classList.toggle('off',!o.f);grid.appendChild(o.c)});
 const n=ord.filter(o=>o.f).length;
 afit.textContent=`Подходит ${n} ${pl(n,'программа','программы','программ')} для ${v} ${yrs(v)}`;
 if(RM||!anim)return;
 cards.forEach(c=>{const f=first.get(c),l=c.getBoundingClientRect(),dx=f.left-l.left,dy=f.top-l.top;
  if(Math.abs(dx)>1||Math.abs(dy)>1){c.style.transition='none';c.style.transform=`translate(${dx}px,${dy}px)`;c.getBoundingClientRect();c.style.transition='';c.style.transform=''}});
}
age.addEventListener('input',()=>setAge(age.value,true));
setAge(age.value,false);

/* form prefill + scroll */
const fProg=$('#f-prog2'),fAge=$('#f-cage'),fCom=$('#f-com');
fProg.innerHTML+=P.map(p=>`<option value="${p.id}">${p.n}</option>`).join('');
for(let v=3;v<=14;v++){fAge.innerHTML+=`<option value="${v}">${v} ${yrs(v)}</option>`}
fAge.value=age.value;
function book(pid,a,note){
 if(pid)fProg.value=pid;if(a)fAge.value=a;if(note)fCom.value=note;
 $('#lead').scrollIntoView({behavior:RM?'auto':'smooth',block:'start'});
 setTimeout(()=>$('#f-child').focus({preventScroll:true}),RM?0:650);
}
grid.addEventListener('click',e=>{const b=e.target.closest('[data-book]');if(b)book(b.dataset.book,age.value)});

/* schedule */
const week=$('#week'),fp=$('#f-prog'),fa=$('#f-age');
fp.innerHTML+=P.map(p=>`<option value="${p.id}">${p.n}</option>`).join('');
for(let v=3;v<=14;v++){fa.innerHTML+=`<option value="${v}">${v} ${yrs(v)}</option>`}
const seatTxt=n=>n?`${n} ${pl(n,'место','места','мест')}`:'лист ожидания';
const dotCls=n=>n>2?'dot':n?'dot few':'dot no';
function renderWeek(){
 const pv=fp.value,av=+fa.value;
 week.innerHTML=DAYS.map((d,di)=>{
  const list=S.map((s,i)=>({s,i})).filter(({s})=>{const p=byId(s[2]);return s[0]===di&&(!pv||s[2]===pv)&&(!av||(av>=p.a[0]&&av<=p.a[1]))});
  return `<div class="day"><h3 class="day-h">${d}<small>${list.length} ${pl(list.length,'занятие','занятия','занятий')}</small></h3>${list.length?list.map(({s,i})=>{const p=byId(s[2]);return `<button type="button" class="slot k-${p.k}" data-i="${i}"><span class="sl-t">${s[1]}</span><span class="sl-n">${p.n}</span><span class="sl-m"><i class="${dotCls(s[3])}"></i>${seatTxt(s[3])}</span></button>`}).join(''):'<p class="day-e">Нет занятий по выбранным фильтрам</p>'}</div>`}).join('');
}
fp.addEventListener('change',renderWeek);fa.addEventListener('change',renderWeek);renderWeek();

/* modal */
const mo=$('#mo');let moLast=null,moSlot=null;
const openMo=i=>{const s=S[i],p=byId(s[2]);moSlot=s;moLast=document.activeElement;
 $('#mo-tag').innerHTML=`<i class="sh ${p.k==='en'?'s':p.k==='art'?'c':'l'}"></i>${DAYS[s[0]]}, ${s[1]}`;$('#mo-t').textContent=p.n;
 $('#mo-d').innerHTML=[['Возраст',`${p.a[0]}–${p.a[1]} лет`],['Длительность',p.d],['Формат',p.g==='индивидуально'?'индивидуально':'группа '+p.g],['Педагог',TCH[p.id]],['Кабинет',ROOM[p.id]],['Свободно',`<i class="${dotCls(s[3])}"></i>${seatTxt(s[3])}`]].map(([k,v])=>`<dt>${k}</dt><dd>${v}</dd>`).join('');
 $('#mo-book').textContent=s[3]?'Записаться на пробное':'Встать в лист ожидания';
 mo.hidden=false;document.body.classList.add('lock');requestAnimationFrame(()=>{mo.classList.add('on');$('.mo-x',mo).focus()})};
const closeMo=()=>{mo.classList.remove('on');document.body.classList.remove('lock');setTimeout(()=>{mo.hidden=true;moLast&&moLast.focus()},RM?0:260)};
week.addEventListener('click',e=>{const b=e.target.closest('.slot');if(b)openMo(+b.dataset.i)});
mo.addEventListener('click',e=>{if(e.target.hasAttribute('data-close'))closeMo()});
$('#mo-book').addEventListener('click',()=>{const s=moSlot;closeMo();setTimeout(()=>book(s[2],null,`Интересует занятие: ${DAYS[s[0]]}, ${s[1]} — ${byId(s[2]).n}`),RM?0:280)});

/* calculator */
const cp=$('#cprog');
cp.innerHTML=P.filter(p=>p.m).map(p=>`<label class="ck"><input type="checkbox" value="${p.id}"${p.id==='en69'?' checked':''}><span class="ck-b"></span><span class="ck-n">${p.n}<small>${p.note}</small></span><b>${fmt(p.m)} ₽/мес</b></label>`).join('')+'<p class="ck-note">Продлёнка — 12 900 ₽/мес или 850 ₽ за разовое посещение, оформляется у администратора.</p>';
let kids=1,pay='m';
const cu=(el,to)=>{const from=+el.dataset.v||0;el.dataset.v=to;if(RM||Math.abs(to-from)<1){el.textContent=fmt(to);return}
 const t0=performance.now(),d=700;cancelAnimationFrame(el._r);
 const f=t=>{const k=Math.min(1,(t-t0)/d),e=1-Math.pow(1-k,3);el.textContent=fmt(from+(to-from)*e);if(k<1)el._r=requestAnimationFrame(f)};el._r=requestAnimationFrame(f)};
function calc(){
 const sel=$$('input:checked',cp).map(i=>byId(i.value));
 const mo=sel.reduce((s,p)=>s+p.m,0),kf=1+(kids-1)*.9,base=mo*kf*9,dr=pay==='h'?.05:pay==='y'?.1:0,disc=base*dr,total=base-disc;
 cu($('#total'),total);cu($('#permo'),total/9);
 const rows=[[`Программы (${sel.length})`,mo?fmt(mo)+' ₽/мес':'не выбраны'],[`Детей: ${kids}${kids>1?' · скидка −10 % на '+(kids-1)+' '+pl(kids-1,'ребёнка','детей','детей'):''}`,'×'+kf.toFixed(1).replace('.',',')],['Учебный год','9 месяцев']];
 if(dr)rows.push([pay==='h'?'Оплата за полгода −5 %':'Оплата за год −10 %','−'+fmt(disc)+' ₽','disc']);
 $('#crows').innerHTML=rows.map(([k,v,c])=>`<li${c?' class="'+c+'"':''}><span>${k}</span><b>${v}</b></li>`).join('');
 $('#kids').textContent=kids;$('#kid-m').disabled=kids<=1;$('#kid-p').disabled=kids>=4;
}
cp.addEventListener('change',calc);
$('#kid-m').addEventListener('click',()=>{kids=Math.max(1,kids-1);calc()});
$('#kid-p').addEventListener('click',()=>{kids=Math.min(4,kids+1);calc()});
$('#pay').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;pay=b.dataset.p;$$('button','#pay'.length?$('#pay'):null).forEach(x=>x.setAttribute('aria-pressed',x===b));calc()});
calc();

