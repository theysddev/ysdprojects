addEventListener('keydown',e=>{if(e.key!=='Escape')return;if(!lb.hidden)closeLb();if(!mo.hidden)closeMo();if(bg.getAttribute('aria-expanded')==='true')setM(false)});

/* form */
const tel=$('#f-tel');
tel.addEventListener('input',()=>{let d=tel.value.replace(/\D/g,'');if(d.startsWith('8'))d='7'+d.slice(1);if(d&&!d.startsWith('7'))d='7'+d;d=d.slice(0,11);
 let s='';if(d.length){s='+7';if(d.length>1)s+=' ('+d.slice(1,4);if(d.length>=4)s+=')';if(d.length>4)s+=' '+d.slice(4,7);if(d.length>7)s+='-'+d.slice(7,9);if(d.length>9)s+='-'+d.slice(9,11)}tel.value=s});
const form=$('#form'),done=$('#done');
form.addEventListener('submit',e=>{e.preventDefault();
 let ok=true;$$('[required]',form).forEach(i=>{const bad=!i.value.trim()||(i===tel&&i.value.replace(/\D/g,'').length<11);i.style.borderColor=bad?'var(--cor)':'';if(bad&&ok){i.focus();ok=false}});
 if(!ok)return;
 const c=$('#f-child').value.trim(),p=fProg.value?byId(fProg.value).n.toLowerCase():'подходящую программу';
 $('#done-p').textContent=`Перезвоним в рабочее время, подберём ${p} и день пробного занятия для ${c||'ребёнка'} (${fAge.value} ${yrs(+fAge.value)}).`;
 done.hidden=false;$('.btn',done).focus({preventScroll:true})});
$('#again').addEventListener('click',()=>{form.reset();fAge.value=age.value;done.hidden=true;$('#f-child').focus({preventScroll:true})});
})();
