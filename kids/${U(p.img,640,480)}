.pc-ph{position:relative;aspect-ratio:4/3;background:var(--lemt)}
.pc-ph img{width:100%;height:100%;object-fit:cover}
.pc-age{position:absolute;left:12px;top:12px;background:var(--lem);font-weight:700;font-size:13px;padding:6px 11px;border-radius:999px;transition:background-color .3s ease}
.pc-b{padding:18px 18px 20px;display:flex;flex-direction:column;flex:1}
.pc h3{font-size:17px}
.pc-sub{font-size:13px;font-weight:600;color:var(--mut);margin-top:12px}
.pc-l{margin-top:6px;display:grid;gap:5px;font-size:14px;line-height:1.45}
.pc-l li{display:flex;gap:9px;align-items:flex-start}
.pc-l .sh{width:9px;height:9px;margin-top:6px}
.pc-meta{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:13px;color:var(--mut);margin-top:14px}
.pc-meta span,.pc-sch{display:inline-flex;align-items:center;gap:6px}
.pc-meta svg,.pc-sch svg{width:16px;height:16px}
.pc-sch{font-size:13px;color:var(--mut);margin-top:6px}
.pc-f{margin-top:auto;padding-top:16px}
.pc-pr{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 8px;margin-bottom:12px}
