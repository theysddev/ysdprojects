@media (max-width:1000px){.week{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:12px;padding:4px 16px 16px;margin:0 -16px;-webkit-overflow-scrolling:touch;scrollbar-width:thin}.day{min-width:232px;scroll-snap-align:start}.legend{margin-left:0}}
/* modal */
.mo,.lb{position:fixed;inset:0;z-index:80;display:grid;place-items:center;padding:16px}
.mo[hidden],.lb[hidden]{display:none}
.mo-bg{position:absolute;inset:0;background:rgba(35,48,58,.55);opacity:0;transition:opacity .25s ease}
.mo-c{position:relative;background:var(--w);border-radius:var(--r);padding:32px;width:min(100%,480px);box-shadow:0 30px 80px rgba(35,48,58,.3);opacity:0;transform:translateY(16px) scale(.97);transition:opacity .25s ease,transform .3s var(--e);max-height:calc(100dvh - 32px);overflow:auto}
.on .mo-bg{opacity:1}.on .mo-c{opacity:1;transform:none}
.mo-x{position:absolute;right:16px;top:16px;width:44px;height:44px;border-radius:50%;background:var(--bg);font-size:24px;line-height:1;display:grid;place-items:center}
.mo-c h3{font-size:22px;padding-right:44px}
.mo-d{display:grid;grid-template-columns:auto 1fr;gap:10px 18px;margin:20px 0 24px;font-size:15px}
.mo-d dt{color:var(--mut);font-weight:500}.mo-d dd{margin:0;font-weight:600}
.mo-d dd .dot{margin-right:6px;vertical-align:middle}
/* lesson steps */
.lsn{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;counter-reset:n}
.lsn li{background:var(--w);border-radius:24px;padding:26px 24px 28px;position:relative;box-shadow:0 6px 20px rgba(110,70,20,.06)}
.lsn-n{position:absolute;right:20px;top:18px;font-family:var(--hf);font-weight:700;font-size:15px;color:var(--mut)}
.lsn-i{width:60px;height:60px;border-radius:20px;display:grid;place-items:center;margin-bottom:20px}
.lsn-i svg{width:28px;height:28px}
.lsn li:nth-child(1) .lsn-i{background:var(--cort)}.lsn li:nth-child(2) .lsn-i{background:var(--skyt)}.lsn li:nth-child(3) .lsn-i{background:var(--lemt)}.lsn li:nth-child(4) .lsn-i{background:var(--cort)}
.lsn p{font-size:15px;color:var(--mut);margin-top:10px}
.lsn em{display:block;font-style:normal;font-weight:600;font-size:13px;margin-top:14px;color:var(--ink)}
@media (max-width:980px){.lsn{grid-template-columns:repeat(2,1fr)}}
@media (max-width:520px){.lsn{grid-template-columns:1fr;gap:12px}}
/* calculator */
.calc{display:grid;grid-template-columns:1.2fr .8fr;gap:24px;align-items:start}
.calc-l{display:grid;gap:20px}
.cf{background:var(--w);border-radius:24px;padding:22px 24px;border:0;margin:0;min-width:0}
.cf legend,.cf-l{font-weight:600;font-size:15px;color:var(--mut);padding:0;display:block;margin-bottom:12px}
fieldset.cf legend{float:left;width:100%}
fieldset.cf legend~*{clear:both}
.calc>*,.calc-l>*,.cf-row>*{min-width:0}
.ck{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;padding:12px 0;border-top:1px solid var(--line);cursor:pointer;min-height:52px}
.ck:first-of-type{border-top:0}
.ck input{position:absolute;opacity:0;width:1px;height:1px;min-height:0}
.ck-b{width:26px;height:26px;border-radius:9px;border:2px solid var(--line);background:var(--w);display:grid;place-items:center;transition:background-color .2s ease,border-color .2s ease}
.ck-b::after{content:"";width:12px;height:7px;border:solid var(--ink);border-width:0 0 2.5px 2.5px;transform:rotate(-45deg) scale(.6);opacity:0;transition:transform .25s var(--e),opacity .2s ease;margin-top:-3px}
.ck input:checked~.ck-b{background:var(--lem);border-color:var(--lem)}
.ck input:checked~.ck-b::after{opacity:1;transform:rotate(-45deg) scale(1)}
.ck input:focus-visible~.ck-b{outline:3px solid var(--sky2);outline-offset:3px}
.ck-n{font-weight:600;font-size:15px;line-height:1.3}
.ck-n small{display:block;font-weight:500;font-size:13px;color:var(--mut)}
.ck b{font-weight:600;font-size:15px;white-space:nowrap}
.ck-note{font-size:13px;color:var(--mut);padding-top:12px;border-top:1px solid var(--line)}
.cf-row{display:grid;grid-template-columns:auto 1fr;gap:20px}
.step{display:inline-flex;align-items:center;gap:6px;background:var(--bg);border-radius:999px;padding:4px}
.step button{width:46px;height:46px;border-radius:50%;background:var(--w);font-size:22px;font-weight:500;display:grid;place-items:center;transition:transform .2s var(--e),background-color .2s ease;box-shadow:0 2px 6px rgba(110,70,20,.1)}
.step button:active{transform:scale(.92)}
.step button:disabled{opacity:.35;cursor:default}
.step output{font-family:var(--hf);font-weight:700;font-size:22px;width:44px;text-align:center}
.cf small{display:block;font-size:13px;color:var(--mut);margin-top:10px}
.seg{display:flex;flex-wrap:wrap;gap:6px;background:var(--bg);border-radius:18px;padding:5px}
.seg button{flex:1;min-height:46px;border-radius:14px;padding:6px 14px;font-weight:600;font-size:14px;display:flex;align-items:center;justify-content:center;gap:8px;transition:background-color .2s ease,transform .2s var(--e),box-shadow .2s ease}
.seg button em{font-style:normal;font-size:12px;color:var(--cor2);font-weight:700}
.seg button[aria-pressed="true"]{background:var(--w);box-shadow:0 2px 8px rgba(110,70,20,.12)}
.seg button:active{transform:scale(.97)}
.calc-r{background:var(--ink);color:var(--bg);border-radius:var(--r);padding:32px;position:sticky;top:calc(var(--hh) + 16px)}
.cr-l{font-weight:600;color:rgba(255,248,239,.7);font-size:15px}
.cr-t{font-family:var(--hf);font-weight:700;font-size:clamp(34px,3.4vw,46px);line-height:1.1;margin-top:8px;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.cr-m{color:var(--lem);font-weight:600;margin-top:6px}
.cr-rows{margin:24px 0;display:grid;gap:10px;font-size:14px;border-top:1px dashed rgba(255,248,239,.25);padding-top:18px}
.cr-rows li{display:flex;justify-content:space-between;gap:12px}
.cr-rows span{color:rgba(255,248,239,.72)}
.cr-rows b{font-weight:600;white-space:nowrap}
.cr-rows .disc b{color:var(--lem)}
.calc-r .fine{color:rgba(255,248,239,.55);font-size:12px;margin-top:14px}
@media (max-width:900px){.calc{grid-template-columns:minmax(0,1fr)}.calc-r{position:static}.cf-row{grid-template-columns:minmax(0,1fr)}}
/* stages */
.stages{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;position:relative;padding-top:12px}
.st-line{position:absolute;left:4%;right:4%;top:26px;height:4px;border-radius:2px;background:var(--line);overflow:hidden}
.st-line i{display:block;height:100%;background:var(--sky);transform:scaleX(0);transform-origin:left;transition:transform 1.4s var(--e) .2s}
.stages.in .st-line i{transform:scaleX(1)}
.st-m{display:block;width:32px;height:32px;position:relative;z-index:1;margin-bottom:22px;box-shadow:0 0 0 8px var(--bg)}
.st-m.c{border-radius:50%;background:var(--cor)}.st-m.s{background:var(--sky);clip-path:polygon(50% 0,100% 100%,0 100%);box-shadow:none}.st-m.l{background:var(--lem);border-radius:8px}
.stages h3{font-size:17px}
.stages p{font-size:14px;color:var(--mut);margin-top:8px}
@media (max-width:900px){.stages{grid-template-columns:1fr;gap:28px;padding-left:52px}.st-line{left:14px;right:auto;top:8px;bottom:8px;width:4px;height:auto}.st-line i{transform:scaleY(0);transform-origin:top}.stages.in .st-line i{transform:scaleY(1)}.st-m{position:absolute;left:-52px;top:-2px;margin:0}}
/* teachers */
.tgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.tc{background:var(--w);border-radius:24px;padding:24px;box-shadow:0 6px 20px rgba(110,70,20,.06)}
.tc{display:grid;grid-template-columns:72px minmax(0,1fr);column-gap:16px;align-items:center}
.tc>svg{width:72px;height:72px;overflow:visible;grid-row:1/3}
.tc>p:last-child{grid-column:1/-1;margin-top:16px}
.tc .role{align-self:start;margin-top:4px}
.tc h3{align-self:end}
.tc .eyes{transform-box:fill-box;transform-origin:center;transition:transform .12s ease}
.tc.blink .eyes{transform:scaleY(.15)}
.tc .pp{transition:transform .25s var(--e)}
.tc h3{font-size:17px}
.tc .role{font-weight:600;font-size:14px;color:var(--sky2);margin-top:6px}
.tc p{font-size:14px;color:var(--mut);margin-top:10px}
@media (max-width:980px){.tgrid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:520px){.tgrid{grid-template-columns:1fr;gap:12px}}
/* gallery */
.mos{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:minmax(180px,22vw);gap:16px}
.mos figure{margin:0;position:relative;border-radius:24px;overflow:hidden;background:var(--lemt)}
.mos figure:nth-child(1){grid-column:1/3;grid-row:1/3}
.mos figure:nth-child(4){grid-column:3/5}
.mos button{display:block;width:100%;height:100%;border-radius:inherit}
.mos img{width:100%;height:100%;object-fit:cover;transition:transform .7s var(--e)}
@media (hover:hover) and (pointer:fine){.mos button:hover img{transform:scale(1.04)}}
.mos figcaption{position:absolute;left:14px;bottom:14px;background:rgba(255,248,239,.92);font-size:12px;font-weight:600;padding:5px 10px;border-radius:999px;pointer-events:none}
@media (max-width:760px){.mos{grid-template-columns:repeat(2,1fr);grid-auto-rows:minmax(140px,40vw);gap:10px}.mos figure:nth-child(1){grid-column:1/3;grid-row:1}.mos figure:nth-child(4){grid-column:1/3}}
.lb-bg{position:absolute;inset:0;background:rgba(35,48,58,.9);opacity:0;transition:opacity .25s ease}
.lb-c{position:relative;max-width:min(1100px,100%);opacity:0;transform:scale(.96);transition:opacity .25s ease,transform .3s var(--e)}
.lb-c img{max-width:100%;max-height:82vh;width:auto;height:auto;border-radius:20px;object-fit:contain}
.lb-cap{color:var(--bg);text-align:center;margin-top:12px;font-size:14px}
.lb-x{position:absolute;right:0;top:-54px;width:44px;height:44px;border-radius:50%;background:var(--w);font-size:24px;display:grid;place-items:center}
/* parents */
.par{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:center}
.par-ph{position:relative}
.par-ph img{border-radius:var(--r);width:100%;height:auto;aspect-ratio:5/6;object-fit:cover;box-shadow:var(--sh)}
.fl-3{left:-16px;bottom:36px;animation-delay:-2s}
.fl-3 .ic{width:40px;height:40px;border-radius:12px;background:var(--lemt);display:grid;place-items:center;flex:none}
.fl-3 .ic svg{width:20px;height:20px}
.fl-3 b{display:block;font-size:14px;font-weight:600}.fl-3 span{font-size:13px;color:var(--mut)}
.par-l{margin-top:28px;display:grid;gap:18px}
.par-l li{display:flex;gap:16px;align-items:flex-start}
.par-l svg{width:48px;height:48px;flex:none;padding:12px;border-radius:16px;background:var(--w);box-shadow:var(--sh)}
.par-l b{font-weight:600;font-size:16px}
.par-l p{font-size:15px;color:var(--mut);margin-top:3px}
@media (max-width:900px){.par{grid-template-columns:1fr;gap:32px}.par-ph{max-width:480px}.par-ph img{aspect-ratio:4/3}}
/* faq */
.faq{max-width:780px}
.fi{border-bottom:2px solid var(--line)}
.fq{width:100%;text-align:left;display:flex;justify-content:space-between;align-items:center;gap:18px;padding:22px 4px;font-family:var(--hf);font-weight:600;font-size:17px;line-height:1.35;min-height:56px}
.fq i{width:36px;height:36px;border-radius:50%;background:var(--w);flex:none;position:relative;box-shadow:inset 0 0 0 2px var(--line);transition:transform .35s var(--e),background-color .2s ease}
.fq i::before,.fq i::after{content:"";position:absolute;left:50%;top:50%;width:14px;height:2.5px;background:var(--ink);border-radius:2px;transform:translate(-50%,-50%)}
.fq i::after{transform:translate(-50%,-50%) rotate(90deg)}
.fq[aria-expanded="true"] i{transform:rotate(45deg);background:var(--lem);box-shadow:none}
.fa{padding:0 60px 24px 4px;color:var(--mut);font-size:16px;animation:fade .4s var(--e)}
.fa[hidden]{display:none}
@keyframes fade{from{opacity:0;transform:translateY(-6px)}}
@media (max-width:560px){.fq{font-size:15px}.fa{padding-right:4px}}
/* lead + contacts */
.lead-g{display:grid;grid-template-columns:1.1fr .9fr;gap:24px;align-items:start}
.lead-c{background:var(--w);border-radius:var(--r);padding:clamp(24px,3.4vw,44px);position:relative;overflow:hidden}
.lead-c .sec-h{margin-bottom:28px}
.lead-c .sec-p{font-size:16px;margin-top:12px}
form label{display:grid;gap:6px;font-weight:600;font-size:14px;color:var(--mut)}
form{display:grid;gap:16px}
.fg2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
textarea{resize:vertical;min-height:72px}
.fine{font-size:12.5px;color:var(--mut);line-height:1.5}
.done{position:absolute;inset:0;background:var(--w);display:grid;place-content:center;text-align:center;padding:32px;gap:12px;animation:fade .4s var(--e)}
.done[hidden]{display:none}
.done svg{width:88px;height:88px;margin:0 auto 8px}
.done h3{font-size:26px}
.done p{color:var(--mut);max-width:380px}
.done .btn{margin:14px auto 0}
.cont{display:grid;gap:20px}
.cont>*{min-width:0}.cont-l a,.cont-l span{overflow-wrap:anywhere}
.map{background:var(--w);border-radius:var(--r);aspect-ratio:1.3;position:relative;overflow:hidden;width:100%}
.map svg{position:absolute;inset:0;width:100%;height:100%}
.map-pin{position:absolute;left:50%;top:46%;transform:translate(-50%,-100%);display:grid;place-items:center}
.map-pin svg{position:static;width:54px;height:66px}
.map-lbl{position:absolute;left:18px;bottom:18px;background:var(--bg);padding:8px 14px;border-radius:999px;font-size:13px;font-weight:600}
.cont-l{background:var(--w);border-radius:var(--r);padding:28px 32px;display:grid;gap:18px}
.cont-l li{display:grid;gap:2px;font-size:16px}
.cont-l b{font-size:13px;color:var(--mut);font-weight:600}
.cont-l a{text-decoration:none;font-weight:600}
@media (max-width:900px){.lead-g{grid-template-columns:1fr}}
@media (max-width:520px){.fg2{grid-template-columns:1fr}}
/* footer */
.ft{background:var(--ink);color:var(--bg);padding:44px 0 calc(32px + env(safe-area-inset-bottom))}
.ft-in{display:flex;flex-wrap:wrap;gap:24px 48px;align-items:flex-start;justify-content:space-between}
.ft .logo{color:var(--bg)}
.ft p{font-size:14px;color:rgba(255,248,239,.7);margin-top:8px;max-width:360px}
.ft-c{font-size:15px;display:grid;gap:6px}
.ft-c a{text-decoration:none;font-weight:600}
.ft-b{width:100%;display:flex;flex-wrap:wrap;gap:12px 24px;justify-content:space-between;margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,248,239,.15);font-size:13px;color:rgba(255,248,239,.6)}
.ft-b a{color:var(--lem);text-decoration:none;font-weight:600}
/* mobile bar */
.mbar{display:none;position:fixed;left:12px;right:12px;bottom:12px;z-index:40;gap:10px;padding-bottom:env(safe-area-inset-bottom)}
.mbar .btn{flex:1;box-shadow:0 10px 24px rgba(35,48,58,.2)}
.mbar-tel{width:56px;height:56px;border-radius:50%;background:var(--ink);color:var(--bg);display:grid;place-items:center;flex:none;box-shadow:0 10px 24px rgba(35,48,58,.25)}
.mbar-tel svg{width:22px;height:22px}
@media (max-width:760px){.mbar{display:flex}body{padding-bottom:84px}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}.rv{opacity:1;transform:none}.stages .st-line i{transform:none}}
