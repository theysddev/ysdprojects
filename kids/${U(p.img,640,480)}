.rv{opacity:0;transform:translateY(26px);transition:opacity .6s ease,transform .8s var(--e);transition-delay:calc(var(--d,0)*90ms)}
.rv.in{opacity:1;transform:none}
.sec{padding:clamp(64px,8vw,112px) 0}
.sec-alt{background:var(--bg2)}
.sec-h{max-width:720px;margin-bottom:clamp(32px,4vw,52px)}
.sec-p{color:var(--mut);font-size:17px;margin-top:16px;max-width:600px}
/* header */
.hd{position:fixed;inset:0 0 auto;z-index:50;height:var(--hh);display:flex;align-items:center;transition:background-color .3s ease,box-shadow .3s ease}
.hd.sc{background:rgba(255,248,239,.82);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);box-shadow:0 1px 0 var(--line)}
