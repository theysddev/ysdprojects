.lead{font-size:clamp(17px,1.4vw,19px);color:var(--mut);margin-top:22px;max-width:520px}
.btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:40px;padding-top:28px;border-top:2px dashed var(--line)}
.facts li{display:flex;gap:12px;align-items:flex-start}
.facts svg{width:40px;height:40px;flex:none;padding:9px;border-radius:14px;background:var(--w);box-shadow:var(--sh)}
.facts b{display:block;font-weight:600;font-size:15px;line-height:1.3}
.facts span span{display:block;font-size:13px;color:var(--mut);margin-top:2px}
.hero-ph{position:relative}
.hero-img{border-radius:var(--r);overflow:hidden;box-shadow:var(--sh);will-change:transform}
.hero-img img{width:100%;height:auto;aspect-ratio:88/100;object-fit:cover}
.fl{position:absolute;display:flex;align-items:center;gap:12px;background:var(--w);border-radius:18px;padding:12px 16px;box-shadow:var(--sh);animation:float 6s ease-in-out infinite;will-change:transform}
.fl-1{top:28px;left:-22px;background:var(--lem);transform:rotate(-4deg);animation-name:floatr}
.fl-1 b{display:block;font-family:var(--hf);font-weight:600;font-size:15px;line-height:1.2}
.fl-1 span{font-size:13px;color:#5a4a1e}
.fl-2{right:-18px;bottom:40px;animation-delay:-3s;max-width:270px}
.fl-2 .ic{width:40px;height:40px;border-radius:50%;background:var(--skyt);display:grid;place-items:center;flex:none}
.fl-2 .ic svg{width:20px;height:20px}
.fl-2 b{display:block;font-size:14px;font-weight:600;line-height:1.3}
.fl-2 span{font-size:13px;color:var(--mut)}
@keyframes float{50%{transform:translateY(-10px)}}
@keyframes floatr{50%{transform:translateY(-10px) rotate(-4deg)}0%,100%{transform:rotate(-4deg)}}
@media (max-width:980px){.hero-in{grid-template-columns:1fr;gap:36px}.hero-ph{max-width:560px}.hero-img img{aspect-ratio:4/3.6}}
@media (max-width:560px){.facts{grid-template-columns:1fr;gap:16px}}
@media (max-width:560px){.hero{padding-top:calc(var(--hh) + 20px)}.fl-1{left:-6px;top:14px}.fl-2{right:-6px;bottom:18px;max-width:230px;padding:10px 12px}}
/* live shapes */
.pals{position:absolute;inset:0;pointer-events:none;z-index:3}
.pal{position:absolute;width:var(--s);height:var(--s);pointer-events:auto;touch-action:manipulation;-webkit-tap-highlight-color:transparent;border-radius:50%}
.pal:focus-visible{outline:3px solid var(--sky2);outline-offset:6px;border-radius:50%}
.pal .bd{display:block;width:100%;height:100%;will-change:transform}
.pal svg{display:block;width:100%;height:100%;overflow:visible;filter:drop-shadow(0 10px 12px rgba(110,70,20,.2));transform-origin:50% 90%}
.pal .eyes{transform-box:fill-box;transform-origin:center;transition:transform .1s ease}
.pal.blink .eyes{transform:scaleY(.12)}
.pal.boop svg{animation:boop .6s var(--e)}
@keyframes boop{0%{transform:none}22%{transform:scale(1.2,.78)}52%{transform:scale(.88,1.14)}76%{transform:scale(1.05,.96)}100%{transform:none}}
.pal-c{--s:116px;top:-46px;right:-34px}
.pal-t{--s:104px;bottom:-26px;left:-40px}
.pal-q{--s:80px;top:42%;left:-42px}
.pal-s1{--s:46px;bottom:-24px;right:36%}
.pal-s2{--s:40px;top:-20px;left:60%}
.bub{position:absolute;left:50%;bottom:calc(100% + 10px);z-index:2;--bx:0px;--px:0px;--py:0px;transform:translate(calc(-50% + var(--bx) + var(--px)),calc(8px + var(--py))) scale(.9);opacity:0;background:var(--ink);color:var(--bg);font-family:var(--bf);font-weight:600;font-size:14px;line-height:1.25;padding:9px 13px;border-radius:14px;white-space:nowrap;pointer-events:none;transition:opacity .2s ease,transform .35s var(--e)}
.bub::after{content:"";position:absolute;left:calc(50% - var(--bx));top:100%;border:7px solid transparent;border-top-color:var(--ink);transform:translateX(-50%)}
.pal[data-b] .bub{bottom:auto;top:calc(100% + 10px);transform:translate(calc(-50% + var(--bx) + var(--px)),calc(-8px + var(--py))) scale(.9)}
.pal[data-b] .bub::after{top:auto;bottom:100%;border-top-color:transparent;border-bottom-color:var(--ink)}
.pal.say .bub{opacity:1;transform:translate(calc(-50% + var(--bx) + var(--px)),var(--py)) scale(1)}
@media (max-width:980px){.pal-c{--s:96px;top:-30px;right:-14px}.pal-t{--s:88px;bottom:-34px;left:-14px}.pal-q{--s:64px;left:-20px}}
@media (max-width:560px){.pal-c{--s:78px;top:-24px;right:-8px}.pal-t{--s:70px;bottom:-26px;left:-8px}.pal-q{--s:52px;top:46%;left:-12px}.pal-s1{--s:38px;bottom:-16px}.pal-s2{--s:34px;top:-14px}.bub{font-size:13px;padding:8px 11px}}
/* marquee */
.mq-clip{overflow:hidden;padding:26px 0 30px;margin:-16px 0 -6px}
.mq{background:var(--cor);color:var(--ink);overflow:hidden;padding:14px 0;transform:rotate(-1.2deg) scale(1.02)}
.mq-t{display:flex;gap:34px;width:max-content;animation:mq 32s linear infinite;font-family:var(--hf);font-weight:600;font-size:15px;white-space:nowrap;align-items:center}
.mq-t .sh{width:11px;height:11px}
.mq-t .sh.c{background:var(--ink)}.mq-t .sh.s{background:var(--w)}.mq-t .sh.l{background:var(--w)}
