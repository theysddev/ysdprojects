<style>
:root{--bg:#FFF8EF;--bg2:#FFEFD9;--w:#fff;--ink:#23303A;--mut:#5C6B78;--cor:#FF6B57;--cor2:#C93A26;--sky:#3C8DDE;--sky2:#1F6FC0;--lem:#FFD166;--lemt:#FFF3D6;--skyt:#E7F0FB;--cort:#FFE6E1;--line:rgba(35,48,58,.13);--e:cubic-bezier(.23,1,.32,1);--hf:'Unbounded',sans-serif;--bf:'Onest',sans-serif;--max:1200px;--r:28px;--rs:18px;--sh:0 14px 34px rgba(110,70,20,.10);--hh:76px}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:96px;-webkit-text-size-adjust:100%;overflow-x:clip}
body{margin:0;font-family:var(--bf);font-size:16px;line-height:1.6;color:var(--ink);background:var(--bg);overflow-x:hidden}
body.lock{overflow:hidden}
img{display:block;max-width:100%}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none;padding:0}
a{color:inherit}
h1,h2,h3{font-family:var(--hf);font-weight:700;margin:0;line-height:1.1;letter-spacing:-.01em}
h1{font-size:clamp(2rem,6.2vw,3.9rem);line-height:1.06}
h2{font-size:clamp(1.65rem,3.5vw,2.7rem)}
h3{font-size:18px;font-weight:600;line-height:1.3}
p{margin:0}
ul,ol{margin:0;padding:0;list-style:none}
:focus-visible{outline:3px solid var(--sky2);outline-offset:3px;border-radius:6px}
.wrap{width:min(100% - 32px,var(--max));margin-inline:auto}
@media (min-width:760px){.wrap{width:min(100% - 64px,var(--max))}}
.sh{display:inline-block;width:12px;height:12px;flex:none;vertical-align:middle}
.sh.c{border-radius:50%;background:var(--cor)}
.sh.s{background:var(--sky);clip-path:polygon(50% 0,100% 100%,0 100%)}
.sh.l{background:var(--lem);border-radius:3px}
.tag{display:inline-flex;align-items:center;gap:10px;font-weight:600;font-size:15px;color:var(--mut);margin-bottom:14px}
.stk{display:inline-block;padding:.02em .32em .08em;border-radius:.42em;background:var(--lem);transform:rotate(-2deg);box-shadow:0 2px 0 rgba(35,48,58,.14);white-space:nowrap}
.stk.c{background:var(--cor)}
.stk.s{background:var(--sky)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 26px;border-radius:999px;font-weight:600;font-size:16px;text-decoration:none;color:var(--ink);transition:transform .25s var(--e),background-color .2s ease,box-shadow .2s ease;white-space:nowrap}
.btn:active{transform:scale(.97)}
