.slot::before{content:"";position:absolute;left:0;top:10px;bottom:10px;width:4px;border-radius:0 4px 4px 0;background:var(--sky)}
.slot.k-en{background:var(--skyt)}.slot.k-dev{background:var(--lemt)}.slot.k-dev::before{background:var(--lem)}.slot.k-art{background:var(--cort)}.slot.k-art::before{background:var(--cor)}.slot.k-care{background:#EEF0F2}.slot.k-care::before{background:var(--mut)}
