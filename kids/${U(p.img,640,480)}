{id:'after',n:'Продлёнка',a:[7,11],m:0,pr:'12 900 ₽',u:'/мес',note:'после школы, до 19:00',l:['Встречаем у трёх ближайших школ','Домашние задания с педагогом','Обед, прогулка и кружки центра'],g:'до 12 детей',d:'до 4 часов',s:'Пн–Пт · 13:00–19:00',img:'1588075592405-d3d4f0846961',k:'care'}];
