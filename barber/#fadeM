function past(di,h){return di===0&&h<=now.getHours()}
function dLabel(di){var d=DAYS[di];return (di===0?'сегодня':di===1?'завтра':WD[d.getDay()])+', '+d.getDate()+' '+MO[d.getMonth()]}
var st={s:null,b:null,d:null,t:null};
var bkS=$('#bkS'),bkB=$('#bkB'),bkD=$('#bkD'),bkT=$('#bkT'),bkHint=$('#bkHint'),bkGo=$('#bkGo');

SV.forEach(function(s,i){
  var b=document.createElement('button');b.type='button';b.className='chip';b.setAttribute('aria-pressed','false');b.dataset.i=i;
  b.innerHTML=s.name+'<small>от '+fmt(s.price)+'</small>';
  b.addEventListener('click',function(){st.s=i;press(bkS,b);update()});
  bkS.appendChild(b);
});
$$('.bb',bkB).forEach(function(b){b.addEventListener('click',function(){st.b=+b.dataset.b;press(bkB,b);renderSlots();update()})});
DAYS.forEach(function(d,di){
  var b=document.createElement('button');b.type='button';b.className='day';b.setAttribute('aria-pressed','false');
  var off=d.getDay()===0;
  b.innerHTML='<i>'+(di===0?'сегодня':di===1?'завтра':WD[d.getDay()])+'</i><b>'+d.getDate()+'</b><small>'+(off?'выходной':MO[d.getMonth()])+'</small>';
  if(off){b.disabled=true;b.setAttribute('aria-label',d.getDate()+' '+MO[d.getMonth()]+', воскресенье — выходной')}
  else{b.addEventListener('click',function(){st.d=di;press(bkD,b);renderSlots();update()})}
  bkD.appendChild(b);
});
function press(c,b){$$('[aria-pressed]',c).forEach(function(x){x.setAttribute('aria-pressed',x===b?'true':'false')})}
function renderSlots(){
  bkT.innerHTML='';
  if(st.b===null||st.d===null){bkHint.hidden=false;bkHint.textContent=st.d===null?'Выберите барбера и день — покажем свободные окна.':'Выберите барбера — у каждого своя загрузка.';st.t=null;return}
  var free=0;
  HOURS.forEach(function(h){
    var b=document.createElement('button');b.type='button';b.className='slot';
    var p=past(st.d,h),bz=busy(st.b,st.d,h);
    b.innerHTML='<span>'+h+':00</span>'+(p?'<small>прошло</small>':bz?'<small>занято</small>':'');
    if(p||bz){b.disabled=true;b.setAttribute('aria-label',h+':00 — '+(p?'время прошло':'занято'))}
    else{free++;b.setAttribute('aria-pressed',st.t===h?'true':'false');b.addEventListener('click',function(){st.t=h;press(bkT,b);update()})}
    bkT.appendChild(b);
  });
  if(st.t!==null&&(past(st.d,st.t)||busy(st.b,st.d,st.t)))st.t=null;
  bkHint.hidden=free>0;
  if(!free)bkHint.textContent='На этот день у барбера всё занято — выберите другой день или барбера.';
}
function update(){
  var s=st.s!==null?SV[st.s]:null,b=st.b!==null?BBS[st.b]:null;
  $('#smS').textContent=s?s.name:'—';
  $('#smB').textContent=b?b.name+' · '+b.spec:'—';
  $('#smD').textContent=st.d!==null?dLabel(st.d):'—';
  $('#smT').textContent=st.t!==null?st.t+':00':'—';
  $('#smL').textContent=s?'≈ '+s.dur+' мин':'—';
  countUp($('#smP'),s?s.price:0);
  $('#stS').classList.toggle('done',st.s!==null);$('#stB').classList.toggle('done',st.b!==null);
  $('#stD').classList.toggle('done',st.d!==null);$('#stT').classList.toggle('done',st.t!==null);
  bkGo.disabled=!(s&&b&&st.d!==null&&st.t!==null);
}
update();
var fService=$('#fService'),fMsg=$('#fMsg');
function goForm(){
  $('#contacts').scrollIntoView({behavior:reduce?'auto':'smooth',block:'start'});
  setTimeout(function(){$('#fName').focus({preventScroll:true})},reduce?0:650);
}
bkGo.addEventListener('click',function(){
  var s=SV[st.s],b=BBS[st.b];
  fService.value=s.id;
  fMsg.value='Онлайн-запись: '+s.name+'. Барбер: '+b.name+' ('+b.spec+'). '+dLabel(st.d)+', '+st.t+':00. Стоимость '+fmt(s.price)+'.';
  goForm();
});
/* "в запись" links from other blocks */
$$('[data-book]').forEach(function(a){
  a.addEventListener('click',function(){
    var id=a.dataset.book,i=-1;SV.forEach(function(s,k){if(s.id===id)i=k});
    if(i<0)return;st.s=i;press(bkS,bkS.children[i]);update();
  });
});
/* nearest window plate */
(function(){
  var found=null;
  outer:for(var di=0;di<14;di++){if(DAYS[di].getDay()===0)continue;for(var k=0;k<HOURS.length;k++){var h=HOURS[k];if(past(di,h))continue;for(var b=0;b<4;b++){if(!busy(b,di,h)){found={di:di,h:h};break outer}}}}
  $('#nearSlot').textContent=found?'Ближайшее окно: '+dLabel(found.di)+', '+found.h+':00':'Ближайшее окно: звоните, подберём время';
})();

/* pass */
var PASS=[{n:3,off:5,term:'4 месяца',u:'стрижки'},{n:6,off:10,term:'8 месяцев',u:'стрижек'},{n:12,off:15,term:'12 месяцев',u:'стрижек'}],BASE=1800,passIdx=1;
function setPass(i){
  passIdx=i;var p=PASS[i],total=p.n*BASE*(1-p.off/100);
  countUp($('#pcN'),p.n,function(v){return String(Math.round(v))});
  $('#pcU').textContent=p.u;$('#pcSave').textContent='−'+p.off+' %';
  countUp($('#pcTotal'),total);countUp($('#pcEach'),total/p.n);countUp($('#pcEco'),p.n*BASE-total);
  $('#pcTerm').textContent=p.term;
}
$$('.seg button').forEach(function(b){b.addEventListener('click',function(){press($('.seg'),b);setPass(+b.dataset.p)})});
$('#pcN')._v=6;$('#pcTotal')._v=9720;$('#pcEach')._v=1620;$('#pcEco')._v=1080;
$('#pcBtn').addEventListener('click',function(){
  var p=PASS[passIdx];fService.value='pass';
  fMsg.value='Абонемент на '+p.n+' '+p.u+' (−'+p.off+' %), '+fmt(p.n*BASE*(1-p.off/100))+'.';
});

/* gallery lightbox */
var lb=$('#lb'),lbImg=$('#lbImg'),lbCap=$('#lbCap'),gBtns=$$('#mosaic button'),gi=0,lastFocus=null,lbTimer=null;
function showLb(i){
  gi=(i+gBtns.length)%gBtns.length;var b=gBtns[gi],img=$('img',b);
  lbImg.src=b.dataset.full;lbImg.alt=img.alt;lbCap.textContent='Фото-пример · '+img.alt;
}
function openLb(i){
  lastFocus=document.activeElement;showLb(i);lb.hidden=false;clearTimeout(lbTimer);
  requestAnimationFrame(function(){lb.classList.add('open')});document.body.classList.add('lock');$('#lbX').focus();
}
function closeLb(){
  lb.classList.remove('open');document.body.classList.remove('lock');
  lbTimer=setTimeout(function(){lb.hidden=true},reduce?0:260);
  if(lastFocus)lastFocus.focus();
}
gBtns.forEach(function(b,i){b.addEventListener('click',function(){openLb(i)})});
$('#lbX').addEventListener('click',closeLb);
$('#lbP').addEventListener('click',function(){showLb(gi-1)});
$('#lbN').addEventListener('click',function(){showLb(gi+1)});
lb.addEventListener('click',function(e){if(e.target===lb)closeLb()});
addEventListener('keydown',function(e){
  if(lb.hidden)return;
  if(e.key==='Escape')closeLb();else if(e.key==='ArrowLeft')showLb(gi-1);else if(e.key==='ArrowRight')showLb(gi+1);
});

/* faq */
$$('.fq-q').forEach(function(q){
  q.addEventListener('click',function(){
    var o=q.getAttribute('aria-expanded')==='true',p=$('#'+q.getAttribute('aria-controls'));
    q.setAttribute('aria-expanded',o?'false':'true');p.hidden=o;
  });
});

/* form */
var form=$('#form'),fName=$('#fName'),fPhone=$('#fPhone'),fAgree=$('#fAgree'),ok=$('#ok');
function mask(v){
  var d=v.replace(/\D/g,'');
  if(d.charAt(0)==='8'||d.charAt(0)==='7')d=d.slice(1);
  d=d.slice(0,10);
  var r='+7';
  if(d.length)r+=' ('+d.slice(0,3);
  if(d.length>=3)r+=')';
  if(d.length>3)r+=' '+d.slice(3,6);
  if(d.length>6)r+='-'+d.slice(6,8);
  if(d.length>8)r+='-'+d.slice(8,10);
  return r;
}
fPhone.addEventListener('input',function(){var v=fPhone.value;if(v.replace(/\D/g,'').length===0){fPhone.value='';return}fPhone.value=mask(v)});
fPhone.addEventListener('focus',function(){if(!fPhone.value)fPhone.value='+7 ('});
fPhone.addEventListener('blur',function(){if(fPhone.value.replace(/\D/g,'').length<=1)fPhone.value=''});
function bad(el,is){el.closest('.fld').classList.toggle('bad',is);return is}
form.addEventListener('submit',function(e){
  e.preventDefault();
  var e1=bad(fName,fName.value.trim().length<2);
  var e2=bad(fPhone,fPhone.value.replace(/\D/g,'').length!==11);
  var e3=!fAgree.checked;$('#consentWrap').classList.toggle('bad',e3);
  if(e1){fName.focus();return}if(e2){fPhone.focus();return}if(e3){fAgree.focus();return}
  var sName=fService.options[fService.selectedIndex].text;
  $('#okText').textContent='Спасибо, '+fName.value.trim()+'. Заявка «'+sName+'» принята: перезвоним на '+fPhone.value+' в рабочее время — с 10:00 до 21:00, кроме воскресенья.';
  form.hidden=true;ok.hidden=false;ok.focus();
});
$('#okAgain').addEventListener('click',function(){form.reset();ok.hidden=true;form.hidden=false;fName.focus()});
})();
</script>
