<meta property="og:type" content="website">
<meta property="og:title" content="РИТМ 2027 — живая айдентика музыкального фестиваля">
<meta property="og:description" content="Хромовая лента, красный круг и генератор афиш в фирменной сетке. Дизайн-концепт студии YSD DEV.">
<meta property="og:image" content="https://ysddev.com/og/design-ritm.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
