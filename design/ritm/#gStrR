let mcTab=S.mc.tab;
function mcRender(){const M=S.mc,box=$('#mcSvg');
  box.innerHTML=mcTab==='tee'?tee(M.color,M.side):mcTab==='band'?band(M.band):badge(M.role,M.name);
  $('#mcTag').textContent=mcTab==='tee'?'Футболка, хлопок 220 г/м²':mcTab==='band'?'Браслет, тканый полиэстер, замок из металла':'Бейдж 86 × 136 мм, ПВХ, ланъярд 20 мм';
}
function mcSync(){const M=S.mc;[['tcol',M.color],['tside',M.side],['btype',M.band],['brole',M.role]].forEach(([n,v])=>{const el=$(`input[name=${n}][value="${v}"]`);if(el)el.checked=true});$('#bName').value=M.name}
function mcSel(btn){mcTab=btn.id.slice(3);S.mc.tab=mcTab;save();$$('.mc-tabs .tab').forEach(b=>{const on=b===btn;b.setAttribute('aria-selected',on);b.tabIndex=on?0:-1;$('#'+b.getAttribute('aria-controls')).hidden=!on});mcRender()}
$('.mc-tabs').addEventListener('click',e=>{const b=e.target.closest('.tab');if(b)mcSel(b)});tabsKeys($('.mc-tabs'),mcSel);
$('#merch').addEventListener('change',e=>{const t=e.target,M=S.mc;if(t.name==='tcol')M.color=t.value;else if(t.name==='tside')M.side=t.value;else if(t.name==='btype')M.band=t.value;else if(t.name==='brole')M.role=t.value;else return;save();mcRender()});
$('#bName').addEventListener('input',e=>{S.mc.name=e.target.value.slice(0,24);save();mcRender()});

