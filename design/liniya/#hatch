const form=$('#form'),fN=$('#fName'),fP=$('#fPhone');
fP.addEventListener('input',()=>{let v=fP.value.replace(/\D/g,'');if(!v){fP.value='';return}if(v[0]==='8')v='7'+v.slice(1);if(v[0]!=='7')v='7'+v;v=v.slice(0,11);let s='+7';if(v.length>1)s+=' '+v.slice(1,4);if(v.length>4)s+=' '+v.slice(4,7);if(v.length>7)s+='-'+v.slice(7,9);if(v.length>9)s+='-'+v.slice(9,11);fP.value=s});
function err(i,e,msg){i.setAttribute('aria-invalid',msg?'true':'false');e.textContent=msg||''}
form.addEventListener('submit',e=>{e.preventDefault();let ok=true;
  if(fN.value.trim().length<2){err(fN,$('#eName'),'Напишите имя — хотя бы две буквы.');ok=false}else err(fN,$('#eName'));
  if(fP.value.replace(/\D/g,'').length<11){err(fP,$('#ePhone'),'Нужен номер из 11 цифр, например +7 912 345-67-89.');ok=false}else err(fP,$('#ePhone'));
  if(!ok){(fN.getAttribute('aria-invalid')==='true'?fN:fP).focus();return}
  const kind=$('input[name=kind]:checked').value;
  $('#okT').textContent=`${fN.value.trim()}, мы позвоним на ${fP.value} в течение рабочего дня и предложим время встречи: 22 или 29 октября. Тема: ${kind.toLowerCase()}.`;
  LS.s('lead',{n:fN.value.trim(),k:kind});form.style.display='none';const okb=$('#ok');okb.classList.add('show');okb.focus()});
$('#again').addEventListener('click',()=>{form.reset();form.style.display='';$('#ok').classList.remove('show');fN.focus()});
$('#rst').addEventListener('click',()=>{LS.clr();stopPlay();go(0,{instant:true});gridT.checked=false;book.classList.remove('grid-on');
  fl=0;selR[0]='a4';selR[1]='b4';for(const i of $$('input[name=fl]'))i.checked=i.value==='0';drawPlan();
  mat='wood';for(const i of $$('input[name=mat]'))i.checked=i.value==='wood';drawMat();setTime(980);
  form.reset();form.style.display='';$('#ok').classList.remove('show');
  const b=$('#rst');b.textContent='Демо сброшено';setTimeout(()=>{b.textContent='Сбросить демо'},1800)});

