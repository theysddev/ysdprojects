playB.addEventListener('click',()=>{if(playT){stopPlay();return}playB.setAttribute('aria-pressed','true');playB.setAttribute('aria-label','Остановить');$('#playI').setAttribute('d','M4.5 3.5h3v11h-3zM10.5 3.5h3v11h-3z');playT=setInterval(()=>{let m=tmV+(RM?30:5);if(m>1430)m=300;setTime(m)},RM?400:60)});

