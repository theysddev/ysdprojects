  const lv=$('#ltLv');lv.setAttribute('fill',mix('#57534c','#b3ada2',1-day));lv.setAttribute('stroke',mix('#93502c','#d08a5f',1-day));
  $('#ltLines').setAttribute('stroke',mix('#1d1d1b','#3c3d42',1-day));
  for(const r of $$('.lt-refl'))r.setAttribute('opacity',F(day*.4));
  // readouts
  $('#clkT').textContent=hm(m);
  const ph=alt<-12?'Ночь':alt<-1.2?(m<720?'Перед рассветом':'Сумерки'):alt<6?(m<720?'Рассвет':'Закат'):alt<12?(m<720?'Утро':'Золотой час'):'День';
  $('#phase').textContent=ph;
  $('#sunr').innerHTML=alt>-.8?`<span>Солнце <b>${Math.round(alt)}°</b> над горизонтом</span><span>Азимут <b>${Math.round(az)}°</b></span><span>${onF>0?'Освещён южный фасад':'Фасад в тени'}</span>`:`<span>Солнце за горизонтом</span><span>Восход <b>${hm(RISE)}</b>, закат <b>${hm(SET)}</b></span>`;
  const tm=$('#tm');tm.value=m;tm.setAttribute('aria-valuetext',`${hm(m)}, ${ph.toLowerCase()}`);
  for(const b of $$('#presets button'))b.setAttribute('aria-pressed',Math.abs(+b.dataset.m-m)<3);
  drawSpd(alt,az);LS.s('time',m);
}
function drawSpd(alt,az){
  const P=(a,z)=>{const r=78*(1-cl(a,0,90)/90);return[100+r*Math.sin(z*D2R),100-r*Math.cos(z*D2R)]};
  let path='';for(let m=RISE;m<=SET;m+=10){const s=sunPos(m);const p=P(Math.max(s.alt,0),s.az);path+=(path?'L':'M')+F(p[0])+' '+F(p[1])}
  let o=`<circle cx="100" cy="100" r="78" fill="none" stroke="#1d1d1b" stroke-width="1"/><circle cx="100" cy="100" r="52" fill="none" stroke="#9a958c" stroke-width=".6" stroke-dasharray="3 3"/><circle cx="100" cy="100" r="26" fill="none" stroke="#9a958c" stroke-width=".6" stroke-dasharray="3 3"/>`;
  o+=`<path d="M100 18V26M100 174V182M18 100H26M174 100H182" stroke="#1d1d1b"/><g font-size="11" fill="#57534c" text-anchor="middle" font-family="Commissioner,sans-serif"><text x="100" y="12">С</text><text x="100" y="197">Ю</text><text x="8" y="104">З</text><text x="192" y="104">В</text></g>`;
  o+=`<path d="${path}" fill="none" stroke="#b4673e" stroke-width="1.4"/><rect x="${F(100-14.4)}" y="${F(100-10.8)}" width="28.8" height="21.6" fill="#f4f0e8" stroke="#1d1d1b"/>`;
  if(alt>0){const p=P(alt,az);const L=Math.min(70,10/Math.tan(Math.max(alt,1)*D2R));const sx=100-Math.sin(az*D2R)*L,sy=100+Math.cos(az*D2R)*L;o+=`<path d="M100 100L${F(sx)} ${F(sy)}" stroke="#1d1d1b" stroke-width="5" opacity=".18" stroke-linecap="round"/><circle cx="${F(p[0])}" cy="${F(p[1])}" r="7" fill="#b4673e"/><circle cx="${F(p[0])}" cy="${F(p[1])}" r="11" fill="none" stroke="#b4673e" opacity=".4"/>`}
  $('#spd').innerHTML=`<svg viewBox="0 0 200 200">${o}</svg>`;
}
