<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>«ЛИНИЯ» — архитектурное бюро, Екатеринбург. Каталог проектов</title>
<meta name="description" content="Интерактивный каталог архитектурного бюро «ЛИНИЯ»: дом у леса, загородная резиденция, лофт-офис и павильон у воды. Листайте разворот, изучайте планы, материалы и свет.">
<meta property="og:type" content="website">
<meta property="og:title" content="«ЛИНИЯ» — каталог проектов архитектурного бюро">
<meta property="og:description" content="Архитектура. Пространство. Люди. Живой каталог: перелистывание, планы этажей, доска материалов, день и ночь на фасаде.">
<meta property="og:image" content="https://ysddev.com/og/design-liniya.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
