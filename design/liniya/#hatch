for(const b of $$('#presets button'))b.addEventListener('click',()=>{stopPlay();setTime(+b.dataset.m)});
const tmI=$('#tm');tmI.addEventListener('input',()=>{stopPlay();setTime(+tmI.value)});
let playT=0;const playB=$('#play');
