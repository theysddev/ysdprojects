.foot .wrap{display:grid;gap:28px}
@media (min-width:900px){.foot .wrap{grid-template-columns:1.2fr 1fr auto;align-items:end}}
.foot .brand{color:var(--cream);justify-content:flex-start}
.foot p{font-size:15px;max-width:30em;margin-top:14px;color:#a9ad9c}
.foot .made{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.foot a.ysd{color:var(--cream);text-underline-offset:4px;min-height:44px;display:inline-flex;align-items:center}
.foot .btn{color:#ebe5d6;--fg:#ebe5d6;--bg:#0f120d}

/* dock */
.dock{position:fixed;left:10px;right:10px;bottom:calc(10px + env(safe-area-inset-bottom));z-index:45;display:none;gap:4px;padding:5px;border-radius:999px;background:rgba(20,24,18,.92);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border:1px solid rgba(235,229,214,.12);overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;transform:translateY(140%);transition:transform .45s var(--ease)}
.dock::-webkit-scrollbar{display:none}
.dock a{flex:none;scroll-snap-align:start;display:flex;align-items:center;gap:6px;min-height:44px;padding:0 14px;border-radius:999px;text-decoration:none;font-size:14px;color:rgba(235,229,214,.78);white-space:nowrap}
.dock a i{font-style:normal;font-size:11px;opacity:.6}
.dock a[aria-current=true]{background:var(--cream);color:var(--ink)}
.dock.show{transform:none}
@media (max-width:900px){.dock{display:flex}}
body.has-setbar .dock{transform:translateY(140%)}

.toast{position:fixed;left:50%;bottom:calc(84px + env(safe-area-inset-bottom));z-index:60;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:var(--cream);color:var(--ink);padding:12px 20px;border-radius:999px;font-size:15px;transition:opacity .25s ease,transform .35s var(--ease);box-shadow:0 14px 30px -12px rgba(0,0,0,.5);white-space:nowrap}
.toast.on{opacity:1;transform:translate(-50%,0)}

@media (prefers-reduced-motion:reduce){
