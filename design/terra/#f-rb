.lt::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--c)}
.reco{margin-top:40px;display:grid;gap:14px}
.reco h3{font-size:17px;color:var(--mut);font-weight:400}
.reco ul{display:flex;flex-wrap:wrap;gap:8px}
.reco li{border:1px solid var(--hair);border-radius:999px;padding:9px 16px;font-size:15px;display:flex;gap:10px;align-items:center}

