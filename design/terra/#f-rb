.type p{color:var(--mut);font-size:15px;margin-top:14px}
.type .w{display:flex;gap:18px;margin-top:14px;font-size:20px}
.type .w span:nth-child(1){font-weight:300}.type .w span:nth-child(2){font-weight:400}.type .w span:nth-child(3){font-weight:500}
.sws{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.sw{display:grid;gap:0;padding:0;border:1px solid var(--hair);border-radius:12px;background:none;cursor:pointer;text-align:left;overflow:hidden;transition:border-color .2s ease,transform .15s ease}
.sw i{display:block;height:92px;background:var(--c);box-shadow:inset 0 -1px 0 rgba(0,0,0,.12)}
