}

/* 07 system */
.sys{display:grid;gap:clamp(48px,6vw,96px)}
.sys-row{display:grid;gap:28px 56px}
@media (min-width:960px){.sys-row{grid-template-columns:minmax(0,1fr) minmax(0,1.15fr)}}
.sys h3{font-size:24px;font-weight:300}
.sys .d{color:var(--mut);margin-top:10px;max-width:30em;font-size:16px}
.tgl{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
