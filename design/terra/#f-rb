.set-grid{display:grid;gap:clamp(28px,4vw,64px)}
@media (min-width:1000px){.set-grid{grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);align-items:start}.set-left{position:sticky;top:96px}}
.box-stage{aspect-ratio:13/10;background:radial-gradient(70% 60% at 50% 42%,#f7f3ea 0%,#e6dfcd 60%,#d5cbb2 100%)}
.box-stage svg{position:absolute;inset:0}
.slot-p{transition:opacity .35s ease}
.slot-p.drop{animation:drop .55s var(--ease) both}
@keyframes drop{from{opacity:0;transform:translateY(-60px)}}
.lid{transform:translateY(-150px);opacity:0;transition:transform .7s var(--io),opacity .35s ease}
.closed .lid{transform:none;opacity:1}
#slots{transition:opacity .2s ease .45s}
.closed #slots{opacity:0}
.sum{margin-top:24px;display:grid;gap:18px}
.sum-st{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap}
.sum-st b{font:300 28px/1.1 var(--sans)}
.sum-st span{color:var(--mut);font-size:15px}
.sum dl{border-top:1px solid var(--hair)}
.sum dl div{display:flex;justify-content:space-between;gap:16px;padding:10px 0;border-bottom:1px solid var(--hair);font-size:15px;font-variant-numeric:tabular-nums}
.sum dt{color:var(--mut)}
.sum dl div.total{font-size:20px;border-bottom:0;padding-top:14px}
.sum dl div.total dt{color:var(--fg)}
.sum-act{display:flex;gap:10px;flex-wrap:wrap}
.pick-g+.pick-g{margin-top:30px}
.pick-g h3{display:flex;align-items:center;gap:12px;font-size:13px;font-weight:500;letter-spacing:.2em;margin-bottom:12px}
.pick-g h3 small{letter-spacing:0;font-weight:400;font-size:14px;color:var(--mut)}
.pick-g h3::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--c)}
.pick{display:grid;gap:8px}
.pick button{display:grid;grid-template-columns:52px minmax(0,1fr) auto;align-items:center;gap:16px;width:100%;min-height:76px;padding:8px 18px 8px 10px;border:1px solid var(--hair);border-radius:14px;background:rgba(255,255,255,.22);cursor:pointer;text-align:left;transition:border-color .2s ease,background-color .2s ease,opacity .2s ease}
.pick button svg{width:52px;height:60px}
.pick button b{display:block;font-weight:400;font-size:16px;line-height:1.3}
.pick button small{color:var(--mut);font-size:13px}
.pick button .pr{font-variant-numeric:tabular-nums;font-size:15px;display:flex;align-items:center;gap:12px}
.pick button .ck{width:22px;height:22px;border-radius:50%;border:1px solid var(--hair);display:grid;place-items:center;transition:background-color .2s ease,border-color .2s ease}
.pick button .ck svg{width:12px;height:12px;opacity:0;transition:opacity .2s ease}
.pick button[aria-pressed=true]{border-color:var(--fg);background:rgba(255,255,255,.55)}
.pick button[aria-pressed=true] .ck{background:var(--fg);border-color:var(--fg);color:var(--bg)}
.pick button[aria-pressed=true] .ck svg{opacity:1}
.pick button:disabled{opacity:.42;cursor:not-allowed}
.pick button:not(:disabled):active{transform:scale(.985)}
@media (hover:hover) and (pointer:fine){.pick button:not(:disabled):hover{border-color:var(--fg)}}
.set-bar{display:none}
@media (max-width:999px){
  .set-bar{display:flex;position:sticky;bottom:calc(12px + env(safe-area-inset-bottom));z-index:5;margin-top:24px;align-items:center;justify-content:space-between;gap:12px;padding:10px 10px 10px 20px;border-radius:999px;background:#1c2218;color:#ebe5d6;box-shadow:0 18px 40px -16px rgba(20,24,18,.6)}
  .set-bar span{font-size:15px}
