<style>
:root{
  --ink:#141812;--olive:#3f4a34;--cream:#ebe5d6;--sand:#cbbf9f;--deep:#262e22;
  --face:#b9c29a;--body:#d6a15a;--care:#ab9fc4;
  --ease:cubic-bezier(.23,1,.32,1);--io:cubic-bezier(.65,0,.35,1);
  --sans:'Jost','Futura','Century Gothic','Avenir Next',system-ui,sans-serif;
  --serif:'Cormorant Garamond','Cormorant',Georgia,'Times New Roman',serif;
  --gut:clamp(16px,4.2vw,64px);--maxw:1280px;
}
*,*::before,*::after{box-sizing:border-box}
*{margin:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;scroll-padding-top:72px}
body{background:var(--ink);color:var(--cream);font:400 17px/1.6 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden;text-rendering:optimizeLegibility}
img,svg{display:block;max-width:100%}
button{font:inherit;color:inherit}
a{color:inherit}
ul,ol{padding:0;list-style:none}
.vh{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.tj{font-family:var(--sans)}
.tc{font-family:var(--serif);font-style:italic}
:focus-visible{outline:2px solid var(--focus,#d9c98f);outline-offset:3px;border-radius:4px}
.skip{position:fixed;left:16px;top:-60px;z-index:100;background:var(--cream);color:var(--ink);padding:12px 18px;border-radius:999px;text-decoration:none;transition:top .2s var(--ease)}
.skip:focus{top:12px}

/* themes */
.t-ink{--bg:#141812;--fg:#ebe5d6;--mut:#a9ad9c;--hair:rgba(235,229,214,.16);--focus:#d9c98f}
.t-olive{--bg:#2d3526;--fg:#ebe5d6;--mut:#c4c5b0;--hair:rgba(235,229,214,.2);--focus:#e3d6a3}
.t-cream{--bg:#ebe5d6;--fg:#1c2218;--mut:#525846;--hair:rgba(28,34,24,.17);--focus:#3f4a34}
.t-sand{--bg:#d8ceb5;--fg:#1c2218;--mut:#4a4f3d;--hair:rgba(28,34,24,.2);--focus:#2d3526}

/* top bar */
.top{position:fixed;inset:0 0 auto 0;z-index:40;height:72px;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:0 var(--gut);color:var(--cream);transition:background-color .35s ease,border-color .35s ease;border-bottom:1px solid transparent}
.top.solid{background:rgba(20,24,18,.86);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-color:rgba(235,229,214,.08)}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;min-height:44px;font:400 14px/1 var(--sans);letter-spacing:.52em;margin-right:-.52em}
.brand svg{width:26px;height:26px}
.nav{display:flex;gap:4px}
.nav a{display:flex;align-items:baseline;gap:7px;padding:0 11px;min-height:44px;align-items:center;text-decoration:none;font-size:14px;color:rgba(235,229,214,.74);border-radius:999px;transition:color .2s ease,background-color .2s ease}
.nav a i{font-style:normal;font-size:11px;color:rgba(235,229,214,.64);letter-spacing:.04em}
.nav a[aria-current=true]{color:var(--cream);background:rgba(235,229,214,.08)}
.top-note{display:none;font-size:13px;color:rgba(235,229,214,.7)}
@media (hover:hover) and (pointer:fine){.nav a:hover{color:var(--cream);background:rgba(235,229,214,.06)}}
@media (max-width:1080px){.nav a i{display:none}.nav a{padding:0 9px}}
@media (max-width:900px){.nav{display:none}.top-note{display:block}.top{height:60px}}
@media (max-width:359px){.top-note{display:none}}

/* cover */
.cover{position:relative;height:100vh;height:100svh;min-height:620px;max-height:1080px;overflow:hidden;color:var(--cream);
  background:radial-gradient(50% 48% at 50% 52%,#3a4430 0%,#252d1f 40%,#161b13 72%,#121510 100%)}
.cover::after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(120% 90% at 50% 40%,transparent 55%,rgba(8,10,7,.55) 100%)}
.leaf{position:absolute;pointer-events:none;transform:var(--t);animation:leafIn 1.1s var(--ease) both}
.leaf.l1{width:min(48vw,760px);right:-9vw;top:-15vh;--t:rotate(160deg);filter:blur(1.2px)}
.leaf.l2{width:min(40vw,600px);left:-12vw;top:-2vh;--t:rotate(28deg);filter:blur(2.4px);opacity:.92}
.leaf.l3{width:min(56vw,860px);left:-22vw;bottom:-30vh;--t:rotate(-38deg);filter:blur(9px);z-index:3}
.leaf.l4{width:min(34vw,520px);right:-15vw;bottom:2vh;--t:rotate(196deg);filter:blur(6px);z-index:3;opacity:.9}
@keyframes leafIn{from{opacity:0;transform:var(--t) translateY(-14px) scale(1.03)}}
.cover-stage{position:absolute;left:0;right:0;top:72px;bottom:150px;z-index:2}
.cover-stage svg{width:100%;height:100%;overflow:visible}
.wm{font-family:var(--sans);font-weight:300;fill:#ebe5d6;animation:fade 1s ease-out .05s both}
.cover .it{animation:rise .8s var(--ease) both;animation-delay:calc(.12s + var(--i)*.08s)}
@keyframes rise{from{opacity:0;transform:translateY(26px)}}
@keyframes fade{from{opacity:0}}
.cover-copy{position:absolute;z-index:4;left:var(--gut);right:var(--gut);bottom:clamp(28px,4.4vh,48px);display:flex;justify-content:space-between;align-items:flex-end;gap:40px}
.cover-copy>*{animation:fade .9s ease-out .25s both}
.cover h1{font:300 clamp(26px,2.5vw,38px)/1.12 var(--sans);letter-spacing:-.005em;max-width:15em}
.cover h1 + p{margin-top:12px;color:rgba(235,229,214,.74);font-size:15px;max-width:34em}
.lines-mini{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.lines-mini a{display:flex;flex-direction:column;justify-content:center;gap:3px;min-height:56px;padding:8px 18px 8px 16px;border:1px solid rgba(235,229,214,.18);border-radius:14px;text-decoration:none;transition:border-color .2s ease,background-color .2s ease}
.lines-mini b{font-weight:500;font-size:12px;letter-spacing:.24em;display:flex;align-items:center;gap:9px}
.lines-mini b::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--c)}
.lines-mini span{font-size:13px;color:rgba(235,229,214,.68);padding-left:16px}
.lines-mini a:active{transform:scale(.98)}
@media (hover:hover) and (pointer:fine){.lines-mini a:hover{border-color:var(--c);background:rgba(235,229,214,.04)}}
@media (max-width:700px){
  .cover{min-height:600px}
  .cover-stage{top:56px;bottom:236px}
  .cover-copy{flex-direction:column;align-items:stretch;gap:20px;bottom:22px}
  .cover h1{font-size:27px}
  .cover h1 + p{font-size:14px;margin-top:8px}
  .lines-mini{justify-content:space-between;flex-wrap:nowrap;gap:6px}
  .lines-mini a{flex:1;padding:8px 10px;min-height:52px;border-radius:12px}
  .lines-mini span{padding-left:0;font-size:12px;white-space:nowrap}
  .leaf.l1{width:82vw;right:-32vw;top:-6vh}
  .leaf.l2{width:70vw;left:-34vw;top:4vh}
  .leaf.l3{width:96vw;left:-50vw;bottom:-22vh}
  .leaf.l4{width:60vw;right:-36vw;bottom:24vh}
}

/* sections */
.sec{position:relative;background:var(--bg);color:var(--fg);padding:clamp(88px,10vw,160px) var(--gut)}
.wrap{max-width:var(--maxw);margin:0 auto}
.head{display:grid;gap:16px 40px;margin-bottom:clamp(40px,5.5vw,76px)}
.idx{display:flex;align-items:center;gap:14px;font:300 15px/1 var(--sans);letter-spacing:.06em;color:var(--mut);padding-top:.5em}
.idx::after{content:"";height:1px;width:44px;background:currentColor;opacity:.45}
.head h2{font:300 clamp(36px,4.9vw,70px)/1.02 var(--sans);letter-spacing:-.02em;max-width:12em}
.head p{color:var(--mut);max-width:31em;font-size:17px}
@media (min-width:960px){
  .head{grid-template-columns:132px minmax(0,1.25fr) minmax(0,1fr);align-items:end}
  .idx{align-self:start;padding-top:1.2em}
  .head p{padding-bottom:.4em}
}
h3{font:400 21px/1.25 var(--sans);letter-spacing:-.005em}
.lat{font-family:var(--serif);font-style:italic;font-size:1.12em;line-height:1.3}
[data-rv]{transition:opacity .9s var(--ease),transform .9s var(--ease)}
.js [data-rv]:not(.in){opacity:0;transform:translateY(18px)}

/* segmented control */
.seg{position:relative;display:inline-flex;padding:4px;border:1px solid var(--hair);border-radius:999px;gap:2px;max-width:100%}
.seg button{position:relative;z-index:1;flex:1;min-height:46px;padding:0 22px;border:0;background:none;border-radius:999px;cursor:pointer;font-weight:500;font-size:13px;letter-spacing:.18em;white-space:nowrap;transition:color .3s ease}
.seg.ru button{letter-spacing:.01em;font-size:15px;font-weight:400}
@media (max-width:700px){.seg{display:flex;width:100%}.seg button{padding:0 8px}.seg.ru button{font-size:14px}}
.line-grid>*,.spin-grid>*,.ana-grid>*,.mat-grid>*,.set-grid>*,.sys-row>*{min-width:0}
.seg button[aria-selected=true]{color:var(--bg)}
.seg .pill{position:absolute;z-index:0;top:4px;bottom:4px;left:0;width:0;border-radius:999px;background:var(--fg);transition:transform .5s var(--ease),width .5s var(--ease)}
.seg button:active{transform:scale(.97)}
@media (hover:hover) and (pointer:fine){.seg button:not([aria-selected=true]):hover{background:var(--hair)}}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 24px;border:1px solid currentColor;border-radius:999px;background:none;cursor:pointer;font-size:15px;text-decoration:none;transition:background-color .2s ease,color .2s ease,opacity .2s ease,transform .15s ease}
.btn:active{transform:scale(.97)}
.btn:disabled{opacity:.38;cursor:not-allowed;transform:none}
.btn.fill{background:var(--fg);color:var(--bg);border-color:var(--fg)}
@media (hover:hover) and (pointer:fine){.btn:not(:disabled):hover{background:var(--fg);color:var(--bg)}.btn.fill:not(:disabled):hover{background:transparent;color:var(--fg)}}

.studio{position:relative;border-radius:6px;overflow:hidden;isolation:isolate}
.studio svg{width:100%;height:100%}

/* 01 line */
.line-grid{display:grid;gap:clamp(28px,4vw,64px)}
.line-grid>.seg,.mat-grid>.seg{order:-1;justify-self:stretch}
@media (min-width:960px){.line-grid{grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);grid-template-rows:1fr auto auto 1fr;row-gap:30px}.line-stage{grid-row:1/5;grid-column:1}.line-grid>.seg{order:0;grid-row:2;grid-column:2;justify-self:start}.line-panel{grid-row:3;grid-column:2}}
.line-stage{aspect-ratio:13/12;background:radial-gradient(70% 62% at 50% 46%,#46523a 0%,#323b2a 48%,#252c1f 100%)}
.line-stage .glow{position:absolute;inset:-20%;background:radial-gradient(38% 34% at 50% 44%,var(--acc) 0%,transparent 70%);opacity:.2;transition:background .6s ease}
.ln-layer{position:absolute;inset:0;opacity:0;transform:scale(.985);transition:opacity .6s var(--io),transform .8s var(--ease);will-change:opacity}
.ln-layer.on{opacity:1;transform:none}
.ln-layer.on .it{animation:rise .7s var(--ease) both;animation-delay:calc(var(--i)*.07s + .08s)}
.line-panel{transition:opacity .22s ease,transform .9s var(--ease)}
.line-panel.swap{opacity:0}
.line-ru{font:300 clamp(30px,3vw,40px)/1.1 var(--sans)}
.line-ru small{display:block;margin-top:8px;font-size:14px;color:var(--mut);letter-spacing:.02em}
.line-desc{margin-top:16px;color:var(--mut);max-width:30em}
.plist{margin-top:28px;border-top:1px solid var(--hair)}
.plist li{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:18px;align-items:baseline;padding:14px 0;border-bottom:1px solid var(--hair);font-size:16px}
.plist li span:nth-child(2){color:var(--mut);font-size:14px}
.plist li span:last-child{min-width:5.2em;text-align:right;font-variant-numeric:tabular-nums}
.spec{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:26px}
.spec dt{font-size:13px;color:var(--mut)}
.spec dd{font-size:15px;margin-top:4px;line-height:1.35}
.dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--acc);margin-right:8px;vertical-align:baseline;transition:background-color .6s ease}

/* 02 spin */
.spin-grid{display:grid;gap:clamp(28px,5vw,80px)}
@media (min-width:960px){.spin-grid{grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);align-items:center}}
.spin-stage{position:relative;aspect-ratio:1/1.02;background:radial-gradient(66% 60% at 48% 42%,#f6f2e8 0%,#e7e0cf 55%,#d6ccb3 100%);cursor:grab;touch-action:pan-y;user-select:none;-webkit-user-select:none}
.spin-stage.drag{cursor:grabbing}
.spin-stage svg{position:absolute;inset:4% 0 0 0;width:100%;height:96%}
.spin-hint{position:absolute;left:0;right:0;bottom:18px;display:flex;justify-content:center;align-items:center;gap:10px;font-size:13px;color:#525846;pointer-events:none}
.spin-hint svg{position:static;width:46px;height:12px}
.spin-read{display:flex;align-items:baseline;gap:18px;margin:8px 0 26px}
.spin-read b{font:300 clamp(54px,6vw,84px)/1 var(--sans);letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.spin-read span{color:var(--mut)}
.panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.panels button{display:grid;gap:2px;text-align:left;min-height:64px;padding:12px 16px;border:1px solid var(--hair);border-radius:12px;background:none;cursor:pointer;transition:border-color .2s ease,background-color .2s ease}
.panels button small{color:var(--mut);font-size:13px}
.panels button[aria-pressed=true]{border-color:var(--fg);background:rgba(63,74,52,.07)}
.panels button:active{transform:scale(.98)}
@media (hover:hover) and (pointer:fine){.panels button:hover{border-color:var(--fg)}}
.spin-keys{display:flex;gap:8px;margin-top:18px;flex-wrap:wrap}
.spin-keys .btn{min-width:48px;padding:0 18px}
.note{font-size:14px;color:var(--mut);margin-top:22px;max-width:32em}

/* 03 anatomy */
.ana-grid{display:grid;gap:clamp(32px,5vw,80px)}
@media (min-width:960px){.ana-grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:start}}
.ana-fig{position:relative}
.ana-label{position:relative;max-width:520px;margin:0 auto}
.ana-label svg{width:100%;height:auto;overflow:visible}
.ana-fig figcaption{text-align:center;margin-top:20px;font-size:14px;color:var(--mut)}
.hs{position:absolute;width:44px;height:44px;margin:-22px 0 0 -22px;border:0;background:none;cursor:pointer;display:grid;place-items:center;padding:0}
.hs span{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:rgba(20,24,18,.86);color:var(--cream);font-size:13px;font-weight:500;border:1px solid rgba(235,229,214,.6);transition:background-color .2s ease,color .2s ease,transform .25s var(--ease)}
.hs[aria-pressed=true] span{background:var(--cream);color:var(--ink);transform:scale(1.12)}
.hs:active span{transform:scale(.94)}
@media (hover:hover) and (pointer:fine){.hs:hover span{background:var(--olive)}}
#anaHole,#anaRing{transition:x .5s var(--ease),y .5s var(--ease),width .5s var(--ease),height .5s var(--ease)}
.ana-list{border-top:1px solid var(--hair)}
.ana-list li{border-bottom:1px solid var(--hair)}
.ana-list button{width:100%;display:grid;grid-template-columns:36px minmax(0,1fr) auto;align-items:center;gap:12px;min-height:60px;padding:10px 0;border:0;background:none;cursor:pointer;text-align:left;font-size:19px;font-weight:300}
.ana-list button i{font-style:normal;font-size:13px;color:var(--mut);font-weight:400}
.ana-list button em{font-style:normal;font-size:13px;color:var(--mut)}
.ana-list button[aria-expanded=true]{font-weight:400}
.ana-list button[aria-expanded=true] i{color:var(--fg)}
.ana-body{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s var(--ease)}
.ana-body>div{overflow:hidden}
.ana-list button[aria-expanded=true]+.ana-body{grid-template-rows:1fr}
.ana-body p{color:var(--mut);padding:0 0 8px 48px;max-width:36em}
.ana-body dl{display:flex;flex-wrap:wrap;gap:8px;padding:6px 0 22px 48px}
.ana-body dl div{border:1px solid var(--hair);border-radius:999px;padding:6px 14px;font-size:13px;display:flex;gap:6px}
.ana-body dt{color:var(--mut)}
@media (hover:hover) and (pointer:fine){.ana-list button:hover{color:#fff}}

/* 04 materials */
.mat-grid{display:grid;gap:clamp(28px,5vw,72px)}
@media (min-width:960px){.mat-grid{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);grid-template-rows:1fr auto auto auto 1fr;row-gap:0}.mat-stage{grid-row:1/6;grid-column:1}.mat-grid>.seg{order:0;grid-row:2;grid-column:2;justify-self:start}.mat-top{grid-row:3;grid-column:2}.mat-info{grid-row:4;grid-column:2}}
.mat-stage{aspect-ratio:12/11;background:radial-gradient(70% 66% at 46% 40%,#ece4d1 0%,#d9ceb2 52%,#c2b490 100%)}
.mat-layer{position:absolute;inset:0;opacity:0;transition:opacity .6s var(--io)}
.mat-layer.on{opacity:1}
.mat-top{display:flex;gap:22px;align-items:center;margin:30px 0 18px}
@media (max-width:959px){.mat-top{margin:4px 0 0}}
.macro{position:relative;flex:none;width:112px;height:112px;border-radius:50%;overflow:hidden;box-shadow:0 0 0 1px rgba(28,34,24,.18),0 18px 30px -18px rgba(28,34,24,.6)}
.macro svg{position:absolute;inset:0;width:100%;height:100%;opacity:0;transition:opacity .5s var(--io)}
.macro svg.on{opacity:1}
.mat-name{font:300 clamp(28px,2.6vw,36px)/1.1 var(--sans)}
.mat-sub{color:var(--mut);font-size:15px;margin-top:6px}
.mat-info .spec2{margin-top:22px;border-top:1px solid var(--hair)}
.spec2 div{display:grid;grid-template-columns:9.5em minmax(0,1fr);gap:16px;padding:12px 0;border-bottom:1px solid var(--hair);font-size:15px}
.spec2 dt{color:var(--mut)}
.mat-panel{transition:opacity .22s ease,transform .9s var(--ease)}
.mat-panel.swap{opacity:0}

/* 05 inci */
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chips button{min-height:44px;padding:0 18px;border:1px solid var(--hair);border-radius:999px;background:none;cursor:pointer;font-size:15px;transition:background-color .2s ease,color .2s ease,border-color .2s ease}
.chips button[aria-pressed=true]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.chips button:active{transform:scale(.97)}
@media (hover:hover) and (pointer:fine){.chips button:not([aria-pressed=true]):hover{border-color:var(--fg)}}
.inci-bar{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px 32px;margin-bottom:36px}
.inci-count{color:var(--mut);font-size:15px}
.inci{display:grid;gap:0 56px;border-top:1px solid var(--hair)}
@media (min-width:900px){.inci{grid-template-columns:repeat(2,minmax(0,1fr))}}
.ing{display:grid;grid-template-columns:64px minmax(0,1fr);gap:20px;padding:24px 0;border-bottom:1px solid var(--hair);transition:opacity .35s ease,transform .45s var(--ease)}
.ing.out{opacity:0;transform:translateY(8px)}
.ing[hidden]{display:none}
