.icons figure{display:grid;justify-items:center;align-content:start;gap:10px;padding:20px 6px 14px;border:1px solid var(--hair);border-radius:12px;text-align:center}
.icons svg{width:40px;height:40px;color:var(--cream)}
.icons figcaption{font-size:13px;color:var(--mut);line-height:1.3}
.ic-h{font-size:14px;color:var(--mut);margin:28px 0 12px}

