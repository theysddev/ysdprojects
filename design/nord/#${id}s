const KEY='nord-brandbook-v1';
const DEF={logo:{v:'h',bg:'night',grid:false},tt:{f:'g',w:400,it:false,s:88,t:0,text:'Больше чем кофе'},cfg:{item:'cup',col:{cup:'black',bag:'kraft',mug:'black',card:'cream',sign:'black'},name:'Алиса',vol:350,sort:'eth',side:'front',sign:'round',lit:true},pat:{seed:4821,d:14,sc:'kn',star:true},mb:{cat:'esp',size:1,veg:false}};
const clone=o=>JSON.parse(JSON.stringify(o));
const merge=(a,b)=>{if(!b||typeof b!=='object')return a;for(const k in a){if(!(k in b))continue;if(a[k]&&typeof a[k]==='object')merge(a[k],b[k]);else if(typeof b[k]===typeof a[k])a[k]=b[k]}return a};
let S=clone(DEF);
try{const raw=localStorage.getItem(KEY);if(raw)S=merge(clone(DEF),JSON.parse(raw))}catch(e){}
let saveT=0;const flush=()=>{clearTimeout(saveT);saveT=0;try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}};const save=()=>{clearTimeout(saveT);saveT=setTimeout(flush,150)};addEventListener('pagehide',()=>{if(saveT)flush()});

/* ---------- utils ---------- */
const hx=h=>{if(h.length===4)h='#'+h[1]+h[1]+h[2]+h[2]+h[3]+h[3];return[1,3,5].map(i=>parseInt(h.slice(i,i+2),16))};
