.toasts{position:absolute;left:12px;right:12px;bottom:100px;z-index:45;display:grid;gap:8px;justify-items:center;pointer-events:none}
.toast{pointer-events:auto;display:flex;align-items:center;gap:14px;max-width:100%;min-height:46px;padding:8px 8px 8px 16px;border-radius:16px;background:#2b2826;color:#f5efe9;font-size:13.5px;font-weight:500;line-height:1.35;box-shadow:0 14px 34px -10px rgba(0,0,0,.55);animation:tin .28s var(--ease)}
