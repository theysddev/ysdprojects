  close:()=>{if(MOB.matches)setView('app');closeSheet(true);closeDay();pulsePhone()},
  theme:()=>{const v=S.settings.theme==='dark'?'light':'dark';setTheme(v);if(U.scr==='profile')renderProfile();if(MOB.matches)setView('app');toast(T.theme_set(v));pulsePhone()},
  add:()=>goScreen('add'),
