function renderThumbs(){$('#thumbs').innerHTML=SCR.map(([k,l])=>`<button type="button" class="th" data-pact="nav" data-to="${k}" aria-label="Открыть экран «${l}»"><span class="th-f">${thumb(k)}</span><span>${l}</span></button>`).join('');markThumbs()}
