  const p='k'+(KID++),f=CURVES[type],P=[];
  const ca=Math.cos(ax),sa=Math.sin(ax),cb=Math.cos(ay),sb=Math.sin(ay),cz=Math.cos(az),sz=Math.sin(az);
  for(let i=0;i<N;i++){const[x,y,z]=f(i/N*Math.PI*2),y1=y*ca-z*sa,z1=y*sa+z*ca,x2=x*cb+z1*sb,z2=-x*sb+z1*cb;P.push([x2*cz-y1*sz,x2*sz+y1*cz,z2])}
  const b=[1e9,-1e9,1e9,-1e9];P.forEach(([x,y])=>{b[0]=Math.min(b[0],x);b[1]=Math.max(b[1],x);b[2]=Math.min(b[2],y);b[3]=Math.max(b[3],y)});
  const span=Math.max(b[1]-b[0],b[3]-b[2])+tube*2,sc=size*(1-pad*2)/span,ox=size/2-(b[0]+b[1])/2*sc,oy=size/2-(b[2]+b[3])/2*sc;
  const Q=P.map(([x,y,z])=>[x*sc+ox,y*sc+oy,z]),R=tube*sc,q=i=>Q[((i%N)+N)%N];
  const f1=v=>v.toFixed(1),pd=(a,z)=>{let s='';for(let i=a;i<=z;i++){const c=q(i);s+=(i===a?'M':'L')+f1(c[0])+' '+f1(c[1])}return s};
  const full='M'+Q.map(c=>f1(c[0])+' '+f1(c[1])).join('L')+'Z',X=[];
  for(let i=0;i<N;i++){const A=Q[i],B=q(i+1);for(let j=i+6;j<N;j++){if(i+N-j<6)continue;const C=Q[j],D=q(j+1),rx=B[0]-A[0],ry=B[1]-A[1],sx=D[0]-C[0],sy=D[1]-C[1],den=rx*sy-ry*sx;if(Math.abs(den)<1e-9)continue;
    const t=((C[0]-A[0])*sy-(C[1]-A[1])*sx)/den,u=((C[0]-A[0])*ry-(C[1]-A[1])*rx)/den;
    if(t>=0&&t<1&&u>=0&&u<1){const zi=A[2]+(B[2]-A[2])*t,zj=C[2]+(D[2]-C[2])*u,sn=Math.abs(den)/(Math.hypot(rx,ry)*Math.hypot(sx,sy));X.push(zi>zj?[i,j,sn,zi]:[j,i,sn,zj])}}}
  const piece=(i,len)=>{let a=i,z=i,s=0;while(s<len&&z-i<N/3){s+=Math.hypot(q(z+1)[0]-q(z)[0],q(z+1)[1]-q(z)[1]);z++}s=0;while(s<len&&i-a<N/3){s+=Math.hypot(q(a-1)[0]-q(a)[0],q(a-1)[1]-q(a)[1]);a--}return pd(a,z)};
  const w=v=>f1(v*R),fu=`filterUnits="userSpaceOnUse" x="${-size*.1}" y="${-size*.1}" width="${size*1.2}" height="${size*1.2}"`;
  let defs=[.13,.17,.1].map((v,i)=>`<filter id="${p}f${i}" ${fu}><feGaussianBlur stdDeviation="${f1(v*R)}"/></filter>`).join('')+`<filter id="${p}fs" ${fu}><feGaussianBlur stdDeviation="${w(.32)}"/></filter><radialGradient id="${p}g"><stop offset="0" stop-color="#000" stop-opacity=".5"/><stop offset="1" stop-color="#000" stop-opacity="0"/></radialGradient>`;
  const tb=(d,m)=>`<g mask="url(#${m})"><path d="${d}" stroke="#c27652" stroke-width="${w(2)}"/><path d="${d}" stroke="#d68d66" stroke-width="${w(1.9)}" transform="translate(${w(.1)} ${w(.13)})" filter="url(#${p}f0)"/><path d="${d}" stroke="#e39c74" stroke-width="${w(1.72)}" transform="translate(${w(-.09)} ${w(-.11)})" filter="url(#${p}f0)"/><path d="${d}" stroke="#f2b48c" stroke-width="${w(1.2)}" transform="translate(${w(-.19)} ${w(-.23)})" filter="url(#${p}f1)"/><path d="${d}" stroke="#f9d1b5" stroke-width="${w(.6)}" transform="translate(${w(-.29)} ${w(-.35)})" filter="url(#${p}f1)"/><path d="${d}" stroke="#fff6f0" stroke-width="${w(.26)}" transform="translate(${w(-.34)} ${w(-.42)})" filter="url(#${p}f2)" opacity=".8"/></g>`;
