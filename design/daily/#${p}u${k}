/* ---------- knot illustration (layered tube, depth-correct crossings) ---------- */
const CURVES={tre:t=>[Math.sin(t)+2*Math.sin(2*t),Math.cos(t)-2*Math.cos(2*t),-Math.sin(3*t)],
  cinq:t=>{const r=Math.cos(5*t)+3.4;return[r*Math.cos(2*t),r*Math.sin(2*t),-Math.sin(5*t)*1.1]}};
let KID=0;
