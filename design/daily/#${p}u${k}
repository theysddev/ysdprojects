function goScreen(to){
  if(MOB.matches)setView('app');closeSheet(true);
  if(to==='add'){if(U.scr==='onb')show('today');openSheet()}
  else{if(to==='onb')U.onb=0;if(to==='today'){U.empty=false}if(to==='week')U.wk=monday(TODAY);show(to)}
  pulsePhone();
}
