function ev(h){S.events.unshift({t:hm(clock()),h,n:1});S.events=S.events.slice(0,7);renderEvents()}
function renderEvents(){$('#events').innerHTML=S.events.map(e=>`<li class="${e.n?'new':''}"><time>${e.t}</time><span>${e.h}</span></li>`).join('');S.events.forEach(e=>delete e.n)}
function renderStats(){const tot=S.week.reduce((a,b)=>a+b,0),mx=Math.max(...S.week,12);$('#wkTotal').textContent=tot;$('#wkSub').textContent=`из ${tot+75} записей салона — ${Math.round(tot/(tot+75)*100)}%`;
  const lbl=[9,10,11,12,13,14,15].map(d=>WS[wd(d-1)]+' '+d);$('#bars').innerHTML=S.week.map((v,i)=>`<div class="${i===6?'today':''}"><small>${v}</small><i style="height:${Math.round(v/mx*70)}px"></i><em>${i===6?'сегодня':lbl[i]}</em></div>`).join('');
  $('#mCx b').textContent=S.cx;$('#mCx span').textContent=`${S.cx===1?'отмена':S.cx<5?'отмены':'отмен'} — окна ушли листу ожидания`;$('#mCert b').textContent=S.certN;$('#mCert span').textContent=`${S.certN<5?'сертификата':'сертификатов'} на ${rub(S.certSum)}`;$('#mConf b').textContent=S.conf+'%'}
function flash(id){const e=$('#'+id);if(!e)return;const t=e.classList.contains('mini')?$('b',e):e;t.classList.remove('flash');void t.offsetWidth;t.classList.add('flash')}
function blkHtml(x,mid){const isB=!!x.id,sv=SV[x.sv]||SV.consult,cat=sv.c,st=isB?({reminded:'🔔',confirmed:'✓',moved:'↻'}[x.st]||''):(x.rem?'🔔':'');const w=x.d/720*100;
  const cls='blk '+cat+(x.mine?' mine':'')+(x.src==='bot'?' bot':'')+(x.src==='wait'?' wait':'')+(isB&&S.sel===x.id?' sel':'')+(x.d<60?' xs':'')+(x.d<45?' xxs':'');
  return `<button type="button" class="${cls}" data-k="${isB?x.id:x.k}" style="left:${(x.s-600)/720*100}%;width:${w}%" aria-label="${hm(x.s)}–${hm(x.s+x.d)}, ${esc(x.c)}, ${sv.sn}${x.mine?', ваша запись':''}"><b>${hm(x.s)}</b>${st?'<span class="st" aria-hidden="true">'+st+'</span>':''}<span>${esc(x.c)}${x.d>=100?' · '+sv.sn:''}</span></button>`}
function renderPanel(landId,moveId){const dn=S.pday;const prev=new Map();$$('#tl .blk').forEach(e=>prev.set(e.dataset.k,e.getBoundingClientRect()));
  $('#dTitle').innerHTML=`${cap(dLong(dn))}<small>${dn===S.today?'сегодня':dn===S.today+1?'завтра':dn<S.today?'прошедший день':'через '+(dn-S.today)+' дн.'}</small>`;$('#dPrev').disabled=dn<=TODAY0;$('#dNext').disabled=dn>=LASTDN;
  let h=`<div class="tl-hd"><span class="mw-h"></span><div class="hours">${Array.from({length:13},(_,i)=>`<span style="left:${i/12*100}%${i===12?';transform:translateX(-100%)':i===0?';transform:none':''}">${10+i}</span>`).join('')}</div></div>`;
  MS.forEach(m=>{h+=`<div class="tl-row"><div class="mw"><i>${m.n.split(' ').map(w=>w[0]).join('')}</i><span><b>${m.sh} ${m.n.split(' ')[1][0]}.</b><small>${m.r}</small></span></div><div class="track">${daySched(dn,m.id).map(x=>blkHtml(x,m.id)).join('')}</div></div>`});
  if(dn===S.today){const c=clock();if(c>=600&&c<=1320)h+=`<div class="nowl" style="left:calc(132px + (100% - 132px) * ${(c-600)/720})" aria-hidden="true"></div>`}
  $('#tl').innerHTML=h;
  if(!RM.matches)$$('#tl .blk').forEach(e=>{const p=prev.get(e.dataset.k);if(e.dataset.k===moveId&&p&&p.width){const r=e.getBoundingClientRect();const dx=p.left-r.left,dy=p.top-r.top;if(dx||dy)e.animate([{transform:`translate(${dx}px,${dy}px)`},{transform:'none'}],{duration:650,easing:'cubic-bezier(.65,0,.35,1)'})}});
  if(landId){const e=$(`#tl .blk[data-k="${landId}"]`);if(e){e.classList.add('land');if(!MOB.matches||document.body.dataset.view==='biz'){const sc=$('.tl-scroll');const r=e.getBoundingClientRect(),cr=sc.getBoundingClientRect();if(r.left<cr.left||r.right>cr.right)sc.scrollLeft+=r.left-cr.left-140}}}
  renderDet();renderStats();renderRemAll();save()}
function findBlock(k){const b=bk(k);if(b)return{x:b,mid:b.mid};for(const m of MS){const x=daySched(S.pday,m.id).find(y=>y.k===k);if(x)return{x,mid:m.id}}return null}
function renderDet(){const el=$('#det');const f=S.sel?findBlock(S.sel):null;if(!f||(f.x.id&&f.x.st==='cancelled')){el.innerHTML='<h3>Карточка записи</h3><p class="det-empty">Нажмите на запись в журнале — здесь откроется карточка клиента и кнопка напоминания.</p>';return}
  const x=f.x,m=M(f.mid),sv=SV[x.sv]||SV.consult,isB=!!x.id;const src=x.mine?'Telegram-бот (это вы)':x.src==='bot'?'Telegram-бот':x.src==='wait'?'лист ожидания':x.src==='site'?'сайт':'телефон';
  const st=isB?({new:'<span class="chip g">новая</span>',reminded:'<span class="chip">напоминание отправлено</span>',confirmed:'<span class="chip ok">подтверждена</span>',moved:'<span class="chip">перенесена</span>'}[x.st]):x.rem?'<span class="chip">напоминание отправлено</span>':'<span class="chip ok">в журнале</span>';
  el.innerHTML=`<h3>${esc(x.c)}${x.mine?' · Мария Лебедева':''}</h3><dl><dt>Услуга</dt><dd>${sv.n}</dd><dt>Когда</dt><dd>${cap(dShort(x.dn!=null?x.dn:S.pday))}, ${hm(x.s)}–${hm(x.s+x.d)}</dd><dt>Мастер</dt><dd>${m.n}</dd><dt>Телефон</dt><dd>+7 (9••) •••-${x.mine?'12-48':String(10+x.s%89).slice(-2)+'-'+String(10+(x.d*7)%89).slice(-2)}</dd><dt>Источник</dt><dd>${src}</dd><dt>Статус</dt><dd>${st}</dd></dl>
  <div class="det-acts"><button class="btn" type="button" id="detRem">🔔 Отправить напоминание</button><button class="btn ghost" type="button" id="detClose">Закрыть</button></div>`;
  $('#detRem').addEventListener('click',()=>{if(x.mine){if(x.remAt){pToast(`Напоминание уже ушло в ${x.remAt} — клиент видит его в чате`);return}remind(x.id,'panel');pToast('Напоминание отправлено в Telegram — загляните в чат');if(MOB.matches)$('#dotChat').classList.add('on')}else{if(x.rem){pToast(`${x.c} уже получила напоминание`);return}x.rem=1;S.remK=(S.remK||[]).concat(x.k);pToast(`Напоминание отправлено: ${x.c}, ${hm(x.s)}`);renderPanel()}});
  $('#detClose').addEventListener('click',()=>{S.sel=null;renderPanel()})}
function renderRemAll(){const n=countTomorrow();$('#remindAllT').textContent=S.remAllAt?`Напоминания на завтра ушли в ${S.remAllAt}`:`Напомнить клиентам на завтра · ${n}`}
function countTomorrow(){return MS.reduce((a,m)=>a+daySched(S.today+1,m.id).filter(x=>x.sv!=='consult').length,0)}

/* ================= init ================= */
function tickClock(){$('#sbTime').textContent=hm(clock())}
function initChat(){svc('Сегодня');me('/start',{time:clock()-1,read:true});
  add({from:'bot',kind:'hero',time:clock()-1,html:'<b>Добрый вечер, Мария!</b> Я — бот студии NOIR на Малой Бронной.<br>Запишу к мастеру за минуту, напомню о визите накануне и сохраню ваши бонусы.<br><br>На завтра ещё есть дневные окна у Алины Соколовой.',kb:[[{t:'✂️ Записаться',a:'book',hl:true}],[{t:'🗓 Мои записи',a:'my'},{t:'🎁 Сертификаты',a:'cert'}],[{t:'✨ Бонусы',a:'bonus'},{t:'📍 Как добраться',a:'venue'}]]});
  $$('.row',feed).forEach(r=>r.classList.remove('new'))}
function restoreRem(){const ks=new Set(S.remK||[]);if(!ks.size)return;Object.values(memo).forEach(list=>list.forEach(x=>{if(ks.has(x.k))x.rem=1}))}
function renderAll(){feed.innerHTML='';S.msgs.forEach(m=>feed.append(renderMsg(m)));feed.scrollTop=feed.scrollHeight;renderRkb();renderGuide();renderEvents();renderPanel();tickClock()}
function preMemo(){for(let dn=TODAY0;dn<=LASTDN;dn++)MS.forEach((m,i)=>baseSched(dn,i));restoreRem()}
function resume(){S.bookings.forEach(b=>{if(b.mine&&b.st==='new'&&!b.remAt&&!b.old){const id=b.id;later(()=>remind(id),2500)}})}
function reset(){gen++;T.forEach(clearTimeout);T.clear();chain=Promise.resolve();typingOn(false);closeSheet();cmds.hidden=true;menuBtn.setAttribute('aria-expanded','false');
  Object.values(memo).forEach(l=>l.forEach(x=>delete x.rem));S=fresh();try{localStorage.removeItem(KEY)}catch(e){}feed.innerHTML='';initChat();renderAll();$$('.tabs .dot').forEach(d=>d.classList.remove('on'));save()}
function setView(v){document.body.dataset.view=v;$('#tabChat').setAttribute('aria-selected',String(v==='chat'));$('#tabBiz').setAttribute('aria-selected',String(v==='biz'));$('#'+(v==='chat'?'dotChat':'dotBiz')).classList.remove('on');if(v==='chat')scrollDown();if(v==='biz'){renderPanel(S.landPending||null);S.landPending=null}renderGuide()}

$('#composer').addEventListener('submit',e=>{e.preventDefault();const t=inp.value.trim();if(!t)return;clearHL();me(t.slice(0,200));inp.value='';sendBtn.disabled=true;route(t)});
inp.addEventListener('input',()=>{sendBtn.disabled=!inp.value.trim()});
menuBtn.addEventListener('click',()=>{const open=cmds.hidden;cmds.hidden=!open;menuBtn.setAttribute('aria-expanded',String(open));if(open){const f=$('button',cmds);f&&f.focus({preventScroll:true})}});
$$('button',cmds).forEach(b=>b.addEventListener('click',()=>{cmds.hidden=true;menuBtn.setAttribute('aria-expanded','false');clearHL();me(b.dataset.cmd);route(b.dataset.cmd)}));
kbdTgl.addEventListener('click',()=>{S.rkbOpen=!S.rkbOpen;renderRkb();save()});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(!$('#sheet').hidden)closeSheet();if(!cmds.hidden){cmds.hidden=true;menuBtn.setAttribute('aria-expanded','false');menuBtn.focus()}}});
document.addEventListener('click',e=>{if(!cmds.hidden&&!cmds.contains(e.target)&&!menuBtn.contains(e.target)){cmds.hidden=true;menuBtn.setAttribute('aria-expanded','false')}});
feed.addEventListener('click',e=>{const d=e.target.closest('[data-ics]');if(d)ics(d.dataset.ics)});
$('#shX').addEventListener('click',closeSheet);$('#scrim').addEventListener('click',closeSheet);$('#shPay').addEventListener('click',doPay);
$('#tl').addEventListener('click',e=>{const b=e.target.closest('.blk');if(!b)return;S.sel=b.dataset.k;renderPanel()});
$('#dPrev').addEventListener('click',()=>{if(S.pday>TODAY0){S.pday--;S.sel=null;renderPanel()}});
$('#dNext').addEventListener('click',()=>{if(S.pday<LASTDN){S.pday++;S.sel=null;renderPanel()}});
$('#remindAll').addEventListener('click',()=>{const n=countTomorrow();if(S.remAllAt){pToast(`Напоминания на завтра уже отправлены в ${S.remAllAt}`);return}S.remAllAt=hm(clock());ev(`Администратор отправил напоминания на завтра: ${n} клиентам`);pToast(`Отправлено ${n} ${n%10===1&&n%100!==11?'напоминание':n%10>=2&&n%10<=4&&(n%100<10||n%100>=20)?'напоминания':'напоминаний'} на завтра`);
  const mine=S.bookings.find(b=>b.mine&&b.dn===S.today+1&&b.st!=='cancelled'&&!b.remAt);if(mine)remind(mine.id,'panel');renderPanel()});
['#resetTop','#resetChat','#resetFoot'].forEach(s=>$(s).addEventListener('click',reset));
$('#tabChat').addEventListener('click',()=>setView('chat'));$('#tabBiz').addEventListener('click',()=>setView('biz'));
$('.tabs').addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){const v=document.body.dataset.view==='chat'?'biz':'chat';setView(v);$(v==='chat'?'#tabChat':'#tabBiz').focus()}});
$('#pushBtn').addEventListener('click',()=>{$('#push').classList.remove('show');scrollDown()});
$('#gpushBtn').addEventListener('click',()=>{$('#gpush').classList.remove('show');setView('chat')});
MOB.addEventListener('change',renderGuide);
setInterval(()=>{if(S)tickClock()},5000);

const saved=load();
if(saved){S=saved;preMemo();renderAll();resume()}else{S=fresh();preMemo();initChat();renderAll();save()}
})();
</script>
