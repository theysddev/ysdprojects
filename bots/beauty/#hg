function route(raw){const t=raw.trim();if(!t)return;const l=t.toLowerCase().replace(/ё/g,'е');
  if(S.wait==='certName'&&!MENUW.test(l))return promptCertName(t);
  if(/отменить покупку/.test(l)){S.wait=null;S.cert=null;setRkb('main');return say({html:'Покупку сертификата отменили. Вернуться можно в любой момент.'})}
  if(/^\/start/.test(l))return say({html:'С возвращением! Чем помочь?',kb:[[{t:'✂️ Записаться',a:'book'}],[{t:'🗓 Мои записи',a:'my'},{t:'🎁 Сертификаты',a:'cert'}]]});
  if(/^\/book|записат|запиши|записи?ся$/.test(l)&&!/мои/.test(l))return H.book();
  if(/^\/my|мои записи|моя запись/.test(l))return H.my();
  if(/^\/gift|сертификат|подар/.test(l))return H.cert();
  if(/^\/bonus|бонус|балл/.test(l))return H.bonus();
  if(/отмен|перенес|перенест/.test(l))return H.my();
  if(/адрес|где вы|как добрат|метро|парков|доехать/.test(l))return H.venue();
  if(/цен|прайс|сколько стоит|стоимост/.test(l))return H.prices();
  const map=[[/стриж|подстрич|челк/,'cut'],[/окраш|цвет|блонд|тонир/,'color'],[/укладк|локон/,'style'],[/маникюр|ногт|гель/,'mani'],[/педикюр/,'pedi'],[/уход|чистк|кож/,'care'],[/массаж/,'massage'],[/бров|ресниц/,'brows'],[/макияж|мейк/,'mk']];
  for(const [re,id] of map)if(re.test(l)){if(S.step<2)S.step=2;return say({html:`Записываю на «${SV[id].n}» — выберите мастера 👇`,wait:500},()=>H.svc(id))}
  if(/привет|здравств|добр/.test(l))return say({html:'Добрый вечер! Записать вас к мастеру?',kb:catKb()});
  if(/спасиб|благодар/.test(l))return say({html:'Всегда рады 🤍'});
