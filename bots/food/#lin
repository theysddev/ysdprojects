  S.co.addr='ул. 8 Марта, 2/1 · по геопозиции';S.wait=null;setRkb('main');say({kind:'text',html:'Определил адрес: <b>ул. 8 Марта, 2/1</b>. Подъезд и квартиру курьер уточнит по телефону.'});askWhen()}

/* ================= payment sheet ================= */
let sheetMsg=null,lastFocus=null;
function openSheet(m){sheetMsg=m;lastFocus=document.activeElement;const o=m.o;
  $('#shBody').innerHTML=`<div class="sh-prod"><div class="th">${bagArt().replace('<svg ','<svg preserveAspectRatio="xMidYMid slice" ')}</div><div><b>Заказ №${o.no} · Сытый двор</b><span>${Object.keys(o.items).map(id=>D[id].s+' × '+o.items[id]).join(', ')}</span></div></div>
  <div class="sh-sec"><h4>Способ оплаты</h4><label class="opt"><input type="radio" name="pm" value="card" checked><span>Карта •••• 7731<small>сохранена в Telegram</small></span></label><label class="opt"><input type="radio" name="pm" value="sbp"><span>СБП<small>подтвердите в приложении банка</small></span></label></div>
  <div class="sh-sec"><h4>Доставка</h4><div class="sh-row"><span>Адрес</span><span>${esc(o.addr)}</span></div><div class="sh-row"><span>Время</span><span>${o.whenTxt}</span></div></div>
  <div class="sh-row"><span>Блюда</span><span>${rub(o.sub)}</span></div>${o.disc?`<div class="sh-row"><span>Промокод ${o.code}</span><span>−${rub(o.disc)}</span></div>`:''}<div class="sh-row"><span>Доставка</span><span>${o.del?rub(o.del):'бесплатно'}</span></div><div class="sh-row tot"><span>Итого</span><span>${rub(o.total)}</span></div>`;
  const pb=$('#shPay');pb.disabled=false;pb.className='paybtn';pb.textContent='Оплатить '+rub(o.total);$('#sheet').hidden=false;later(()=>pb.focus({preventScroll:true}),60)}
function closeSheet(){$('#sheet').hidden=true;sheetMsg=null;if(lastFocus&&lastFocus.isConnected)lastFocus.focus({preventScroll:true})}
function doPay(){const m=sheetMsg;if(!m||m.paid)return;const pb=$('#shPay');pb.disabled=true;pb.innerHTML='<span class="spin" aria-hidden="true"></span>Проводим платёж…';const g=gen;
  later(()=>{if(g!==gen)return;pb.classList.add('ok');pb.innerHTML='✓ Оплачено';later(()=>{if(g!==gen)return;closeSheet();paid(m)},650)},1300)}
function paid(m){if(m.paid)return;m.paid=true;upd(m);const o=m.o;
  S.cart={};S.promo=null;S.co=null;S.wait=null;S.nextNo=Math.max(S.nextNo,o.no+1);refreshCart();setRkb('main');
  svc(`Вы оплатили ${rub(o.total)} · заказ №${o.no}`);
  const order={no:o.no,who:'Анна',addr:o.addr,items:o.items,total:o.total,st:0,at:hm(clock()),when:o.whenTxt.replace(/^.*· /,''),mine:true};
  S.orders.push(order);S.kpi.rev+=o.total;S.kpi.cnt++;renderKpi(['k-rev','k-cnt','k-avg'],o.total);arm(order);renderBoard();if(!fly($('#m'+m.id+' .bub'),order))dropAnim(order.no);bizPing();setStep(6);
  say({kind:'text',html:`Спасибо, оплата прошла ✅<br>Заказ <b>№${o.no}</b> уже на экране кухни. Статусы буду присылать сюда — можно свернуть Telegram.`+trk(0)})}

/* ================= order pipeline ================= */
const AUTO=[6500,9000,5000];
function arm(o){if(!o.mine||o.st>=3){o.autoAt=0;return}const st=o.st,no=o.no,ms=AUTO[st];o.autoAt=Date.now()+ms;later(()=>{const x=ord(no);if(x&&x.st===st)advance(no,'auto')},ms);save()}
function advance(no,src){const o=ord(no);if(!o||o.st>=4)return;if(o.st===3&&src==='panel')return;o.st++;
  if(o.st===3){o.cs=Date.now();o.dur=o.mine?16000:30000;kick()}
  if(o.mine){const N2=o.no;
    if(o.st===1){S.skew+=1;push(`Заказ №${N2} принят`,'Кухня начала готовить ваш обед');say({kind:'text',html:`✅ <b>Заказ №${N2} принят.</b> Привезём к <b>${o.when.replace(/^к /,'')}</b>.`+trk(1),wait:350});
      const g=gen;later(()=>{if(g!==gen||o.st!==1||o.cooked)return;cooking(o)},2600)}
    if(o.st===2){if(!o.cooked)cooking(o);S.skew+=12;push('Заказ упакован','Передаём курьеру');say({kind:'text',html:'📦 <b>Всё готово и упаковано</b> в термосумку. Передаём курьеру.',wait:300})}
    if(o.st===3){if(!o.cooked)cooking(o);S.skew+=2;push('Курьер Данияр выехал','Будет через 25 минут — следите на карте');say({kind:'text',html:'🛵 <b>Курьер Данияр выехал</b> — будет через 25 мин. Слежу за ним на карте:',wait:300},{kind:'map',no:N2,wait:500},()=>{const mm=S.msgs.filter(x=>x.kind==='map'&&x.no===N2).pop();if(mm)o.mapId=mm.id;kick()})}
    if(o.st===4){S.skew+=24;if(o.mapId){const mm=S.msgs.find(x=>x.id===o.mapId);if(mm)upd(mm)}push(`Заказ №${N2} доставлен`,'Приятного аппетита! Оцените заказ');
      say({kind:'rate',no:N2,html:`🎉 <b>Заказ №${N2} доставлен.</b> Приятного аппетита!<br>Оцените, пожалуйста, как всё прошло:`,wait:400})}
    arm(o);tickClock()}
  else if(src==='panel'){const T3=['','приняли заказ','заказ готовится к выдаче','курьер выехал'];pToast(`${o.who} получила уведомление: «${T3[o.st]||'статус обновлён'}»`.replace('Игорь получила','Игорь получил').replace('Павел получила','Павел получил'))}
  renderBoard();save()}
function cooking(o){o.cooked=true;S.skew+=2;push('Готовится 🍲','Галина лепит пельмени, борщ уже на плите');say({kind:'text',html:'👩‍🍳 <b>Готовится.</b> Галина лепит пельмени, борщ уже на плите — ещё минут пятнадцать.',wait:300})}
let raf=0;
function kick(){if(!raf)raf=requestAnimationFrame(loop)}
function loop(){raf=0;let any=false;const now=Date.now();
  for(const o of S.orders){if(o.st!==3||!o.cs)continue;any=true;const p=Math.min(1,Math.max(0,(now-o.cs)/o.dur));const mins=Math.max(1,Math.ceil(25*(1-p)));
    if(o.mine&&o.mapId){const r=document.getElementById('m'+o.mapId);if(r){const path=$('.route',r),done=$('.done',r),c=$('.cour',r);if(path&&c){const L=path.getTotalLength(),q=path.getPointAtLength(L*p);c.setAttribute('transform',`translate(${N(q.x)} ${N(q.y)})`);done.style.strokeDashoffset=String(1-p)}const e=$('.eta',r);if(e)e.textContent=p>=1?'на месте':`через ${mins} мин`}}
    const ce=$(`.chit-w[data-no="${o.no}"] .eta`);if(ce)ce.textContent=`в пути · ещё ${mins} мин`;
    if(p>=1)advance(o.no,'auto')}
  if(any)raf=requestAnimationFrame(loop)}

/* ================= business panel ================= */
const COLS=[[0],[1],[2],[3,4]];
const EMPTY=['Новых заказов нет — оплатите заказ в чате, и он появится здесь','На плите пусто','Полка выдачи свободна','Курьеры свободны'];
function chit(o){const items=Object.keys(o.items).map(id=>`<li><span>${o.items[id]}×</span>${D[id].s}</li>`).join('');
  const btn=o.st===0?`<button class="act a0" data-adv="${o.no}" type="button">Принять</button>`:o.st===1?`<button class="act a1" data-adv="${o.no}" type="button">Готово</button>`:o.st===2?`<button class="act a2" data-adv="${o.no}" type="button">Передать курьеру</button>`:'';
  let tail='';if(o.st===3)tail=`<span class="eta">в пути · ещё ${Math.max(1,Math.ceil(25*(1-Math.min(1,(Date.now()-o.cs)/o.dur))))} мин</span>`;
  if(o.st===4)tail=`<span class="stamp" aria-label="Доставлен">ДОСТАВЛЕН</span>`+(o.rate?`<span class="stars" aria-label="Оценка ${o.rate} из 5">${'★'.repeat(o.rate)}${'☆'.repeat(5-o.rate)}</span>`:'');
  let auto='';if(o.mine&&o.st<3&&o.autoAt){const rem=Math.max(300,o.autoAt-Date.now());auto=`<div class="auto" aria-hidden="true"><i style="animation-duration:${rem}ms"></i></div><span class="auto-l">нажмите или подождите — сдвинется сам</span>`}
  return `<div class="chit-w" data-no="${o.no}"><article class="chit${o.mine?' mine':''}${o.st===4?' gone':''}" aria-label="Заказ №${o.no}"><header><b>№${o.no}</b><time>${o.at}</time></header><p class="who">${o.who}${o.mine?'<span class="src">вы</span>':''}</p><p class="adr">${esc(o.addr)}</p><ul>${items}</ul><p class="sum"><span>Итого</span><span>${rub(o.total)}</span></p><p class="when">${esc(o.when)} · оплачен</p>${tail}${btn}${auto}</article></div>`}
function renderBoard(drop){const prev=new Map();$$('#rail .chit-w').forEach(e=>prev.set(e.dataset.no,e.getBoundingClientRect()));
  $$('#rail .col').forEach((col,i)=>{const list=S.orders.filter(o=>COLS[i].includes(o.st)).sort((a,b)=>(a.st===4)-(b.st===4)||b.no-a.no);$('.cnt',col).textContent=list.length;$('.lst',col).innerHTML=list.length?list.map(chit).join(''):`<p class="empty">${EMPTY[i]}</p>`});
  if(RM.matches)return;
  $$('#rail .chit-w').forEach(e=>{const r=e.getBoundingClientRect(),p=prev.get(e.dataset.no);
    if(p&&p.width>0&&r.width>0){const dx=p.left-r.left,dy=p.top-r.top;if(Math.abs(dx)>1||Math.abs(dy)>1)e.animate([{transform:`translate(${dx}px,${dy}px)`},{transform:'none'}],{duration:560,easing:'cubic-bezier(.65,0,.35,1)'})}
    else if(drop&&e.dataset.no===String(drop))e.animate([{transform:'translateY(-46px) rotate(-4deg)',opacity:0},{transform:'translateY(5px) rotate(1deg)',opacity:1,offset:.65},{transform:'none',opacity:1}],{duration:760,easing:'cubic-bezier(.23,1,.32,1)'})})}
function dropAnim(no){const e=$(`.chit-w[data-no="${no}"]`);if(!e||RM.matches)return;e.animate([{transform:'translateY(-46px) rotate(-4deg)',opacity:0},{transform:'translateY(5px) rotate(1deg)',opacity:1,offset:.65},{transform:'none',opacity:1}],{duration:760,easing:'cubic-bezier(.23,1,.32,1)'})}
function fly(src,o){const tgt=$(`.chit-w[data-no="${o.no}"]`);if(RM.matches||MOB.matches||!src||!tgt)return false;const a=src.getBoundingClientRect(),b=tgt.getBoundingClientRect();
  if(!a.width||!b.width||a.bottom<0||a.top>innerHeight)return false;const f=document.createElement('div');f.className='flyer';f.setAttribute('aria-hidden','true');
  f.innerHTML=`<b>№${o.no}</b>${Object.keys(o.items).slice(0,3).map(id=>o.items[id]+'× '+D[id].s).join('<br>')}`;const x0=a.left+a.width/2-66,y0=a.top+a.height/2-50;f.style.left=x0+'px';f.style.top=y0+'px';document.body.append(f);
  const dx=b.left+b.width/2-66-x0,dy=b.top+10-y0;tgt.style.opacity='0';
  const an=f.animate([{transform:'translate(0,0) scale(.55) rotate(-10deg)',opacity:0},{transform:`translate(${dx*.45}px,${dy*.45-110}px) scale(1.04) rotate(5deg)`,opacity:1,offset:.45},{transform:`translate(${dx}px,${dy}px) scale(1) rotate(0deg)`,opacity:1}],{duration:1000,easing:'cubic-bezier(.65,0,.35,1)'});
  const done=()=>{f.remove();tgt.style.opacity='';dropAnim(o.no)};an.onfinish=done;an.oncancel=done;return true}
function fmtK(id,v){if(id==='k-rate')return v?(Math.round(v*10)/10).toFixed(1).replace('.',','):'—';if(id==='k-cnt')return String(Math.round(v));return rub(v)}
function kval(id){const k=S.kpi;return id==='k-rev'?k.rev:id==='k-cnt'?k.cnt:id==='k-avg'?k.rev/k.cnt:k.rs/k.rn}
function renderKpi(changed,delta){['k-rev','k-cnt','k-avg','k-rate'].forEach(id=>{const box=$('#'+id),b=$('b',box),to=kval(id),from=+b.dataset.v;b.dataset.v=to;
  const anim=changed&&changed.includes(id)&&!RM.matches;if(!anim){b.textContent=fmtK(id,to);return}
  const t0=performance.now();const stp=t=>{const k=Math.min(1,(t-t0)/800),e=1-Math.pow(1-k,3);b.textContent=fmtK(id,from+(to-from)*e);if(k<1)requestAnimationFrame(stp)};requestAnimationFrame(stp);
  box.classList.remove('flash');void box.offsetWidth;box.classList.add('flash');const em=$('em',box);em.textContent=id==='k-rev'?'+'+rub(delta||0):id==='k-cnt'?'+1':id==='k-rate'?'новая оценка':'пересчитан';em.classList.add('show');later(()=>em.classList.remove('show'),2600)})}
function tickClock(){const t=hm(clock());$('#sbTime').textContent=t;$('#bizClock').textContent=t}

/* ================= init & events ================= */
function initChat(){svc('Сегодня');me('/start',{time:clock()-1,read:true});
  add({from:'bot',kind:'hero',time:clock()-1,html:'<b>Здравствуйте, Анна!</b> Это «Сытый двор» — домашняя кухня в Тюмени.<br>Готовим с утра небольшими партиями и привозим за 45–60 минут. Доставка бесплатно от 1 000 ₽.<br><br>Сегодня наваристый борщ, пельмени ручной лепки и курник прямо из печи.',
    kb:[[{t:'🍲 Открыть меню',a:'menu',hl:true}],[{t:'🔥 Блюдо дня',a:'dday'},{t:'🛒 Корзина',a:'cart'}],[{t:'📦 Мои заказы',a:'orders'},{t:'ℹ️ Доставка и оплата',a:'help'}]]});
  $$('.row',feed).forEach(r=>r.classList.remove('new'))}
function renderAll(){feed.innerHTML='';S.msgs.forEach(m=>feed.append(renderMsg(m)));feed.scrollTop=feed.scrollHeight;renderRkb();renderGuide();renderBoard();renderKpi();tickClock()}
function resume(){const now=Date.now();S.orders.forEach(o=>{if(o.mine&&o.st<3&&o.autoAt){const st=o.st,no=o.no;later(()=>{const x=ord(no);if(x&&x.st===st)advance(no,'auto')},Math.max(900,o.autoAt-now))}});if(S.orders.some(o=>o.st===3))kick()}
function reset(){gen++;T.forEach(clearTimeout);T.clear();chain=Promise.resolve();typingOn(false);closeSheet();cmds.hidden=true;menuBtn.setAttribute('aria-expanded','false');
  S=fresh();try{localStorage.removeItem(KEY)}catch(e){}feed.innerHTML='';initChat();renderAll();resume();$$('.tabs .dot').forEach(d=>d.classList.remove('on'));save()}
function setView(v){document.body.dataset.view=v;$('#tabChat').setAttribute('aria-selected',String(v==='chat'));$('#tabBiz').setAttribute('aria-selected',String(v==='biz'));$('#'+(v==='chat'?'dotChat':'dotBiz')).classList.remove('on');if(v==='chat')scrollDown();if(v==='biz')renderBoard();renderGuide()}

$('#composer').addEventListener('submit',e=>{e.preventDefault();const t=inp.value.trim();if(!t)return;clearHL();me(t.slice(0,200));inp.value='';sendBtn.disabled=true;route(t)});
inp.addEventListener('input',()=>{sendBtn.disabled=!inp.value.trim()});
menuBtn.addEventListener('click',()=>{const open=cmds.hidden;cmds.hidden=!open;menuBtn.setAttribute('aria-expanded',String(open));if(open){const f=$('button',cmds);f&&f.focus({preventScroll:true})}});
$$('button',cmds).forEach(b=>b.addEventListener('click',()=>{cmds.hidden=true;menuBtn.setAttribute('aria-expanded','false');clearHL();me(b.dataset.cmd);route(b.dataset.cmd)}));
kbdTgl.addEventListener('click',()=>{S.rkbOpen=!S.rkbOpen;renderRkb();save()});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(!$('#sheet').hidden)closeSheet();if(!cmds.hidden){cmds.hidden=true;menuBtn.setAttribute('aria-expanded','false');menuBtn.focus()}}});
document.addEventListener('click',e=>{if(!cmds.hidden&&!cmds.contains(e.target)&&!menuBtn.contains(e.target)){cmds.hidden=true;menuBtn.setAttribute('aria-expanded','false')}});
$('#shX').addEventListener('click',closeSheet);$('#scrim').addEventListener('click',closeSheet);$('#shPay').addEventListener('click',doPay);
$('#rail').addEventListener('click',e=>{const b=e.target.closest('button[data-adv]');if(b)advance(+b.dataset.adv,'panel')});
['#resetTop','#resetChat','#resetFoot'].forEach(s=>$(s).addEventListener('click',reset));
$('#tabChat').addEventListener('click',()=>setView('chat'));$('#tabBiz').addEventListener('click',()=>setView('biz'));
$('.tabs').addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){const v=document.body.dataset.view==='chat'?'biz':'chat';setView(v);$(v==='chat'?'#tabChat':'#tabBiz').focus()}});
$('#pushBtn').addEventListener('click',()=>{$('#push').classList.remove('show');scrollDown()});
$('#gpushBtn').addEventListener('click',()=>{$('#gpush').classList.remove('show');setView('chat')});
MOB.addEventListener('change',renderGuide);
setInterval(()=>{if(S)tickClock()},5000);

const saved=load();
if(saved){S=saved;renderAll();resume()}else{S=fresh();initChat();renderAll();resume();save()}
})();
