  bot({html:near?`Ровно в этот бюджет ${RN[S.rooms].toLowerCase()} нет — показываю ${n} ближайших варианта.`:`Нашёл ${n} ${word} — ${pr==='river'?'сначала с видом на Каму':pr==='high'?'сначала повыше':pr==='cheap'?'сначала дешевле':'по цене'}. Листайте ◀ ▶, сохраняйте в ❤.`});
  bot({...carMsg(),onShow:row=>{ S.crow=row; seen(); fun('pick'); setStatus('Выбирает'); tip('Лид листает подборку. Если добавит в избранное — самое время предложить показ.'); }}); }
function carMsg(){ const fl=S.res[S.ci]; const n=S.res.length; const fav=FAV.includes(fl.id);
