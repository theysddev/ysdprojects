/* text routing */
function route(raw){ const t=raw.trim(), l=t.toLowerCase();
  const cmd={'/start':menu,'/flats':askRooms,'/favorites':favorites,'/mortgage':()=>startMort(),'/progress':()=>progress('oct'),'/promo':promo,'/office':office}[l.split(/\s|@/)[0]];
  if(cmd){ S.aw=null; hideRKB(); setPh(''); return cmd(); }
  if(S.aw==='phone') return onPhone(t);
  if(S.aw==='budget'&&/\d/.test(l)) return onBudgetText(t);
  if(/студи/.test(l)) return setRooms(0);
  if(/(^|\D)1[\s-]?(к|комн)|однокомн|однушк/.test(l)) return setRooms(1);
  if(/(^|\D)2[\s-]?(к|комн)|двухкомн|двушк/.test(l)) return setRooms(2);
  if(/(^|\D)3[\s-]?(к|комн)|тр[её]хкомн|тр[её]шк/.test(l)) return setRooms(3);
  if(/подобр|квартир|подбор/.test(l)) return askRooms();
  if(/избран/.test(l)) return favorites();
  if(/ипотек|платёж|платеж|кредит/.test(l)) return startMort();
  if(/просмотр|показ|посмотреть|экскурс/.test(l)){ return askPlace(); }
  if(/ход|строит|сдач|срок|когда/.test(l)) return progress('oct');
  if(/акци|скидк|рассрочк/.test(l)) return promo();
  if(/офис|адрес|где вы|добрат|телефон|контакт/.test(l)) return office();
  if(/паркинг|машино|парков/.test(l)) return bot({html:'Под домами — тёплый подземный паркинг с лифтом в подъезд, двор без машин. Машино-места — от 1,4 млн ₽, есть рассрочка на 12 месяцев.'});
  if(/отделк|ремонт|white/.test(l)) return bot({html:'Квартиры сдаются в white box: ровные стены и стяжка, разводка электрики и сантехники. Чистовая отделка — опция за 16 000 ₽/м², два месяца после передачи ключей.'});
  if(/цен|стоим|сколько/.test(l)) return bot({html:'Цены сейчас: студии от 5,9 млн ₽, 1-комнатные от 7,5 млн, 2-комнатные от 10,8 млн, 3-комнатные от 15,4 млн. Подобрать под ваш бюджет?',kb:[[{t:'🏠 Подобрать квартиру',cb:'pick',hl:true}]]});
  if(/спасиб|благодар/.test(l)) return bot({html:'Пожалуйста! Если появятся вопросы — пишите, я на связи.'});
  if(/привет|здравств|добр(ый|ое)/.test(l)) return menu();
  bot({html:'Я понимаю кнопки и простые запросы: «двушка», «ипотека», «показ», «ход строительства», «акции», «паркинг». Выберите раздел:',kb:mainKB(false),once:false}); }

/* clicks */
function clearHL(){ $$('.kbtn.hl,.rbtn.hl',screen).forEach(x=>x.classList.remove('hl')); }
msgs.addEventListener('click',e=>{ const lb=e.target.closest('[data-lb]'); if(lb){ openLB(+lb.dataset.lb); return; }
  const b=e.target.closest('button.kbtn'); if(!b||b.disabled) return; const kb=b.closest('.kb');
  if(kb&&kb.dataset.once){ $$('button',kb).forEach(x=>{ x.disabled=true; }); b.classList.add('picked'); }
  if(!/^(prev|next|fav|sub)$/.test(b.dataset.cb)) clearHL(); closePops(); const f=CB[b.dataset.cb]; if(f) f(b.dataset.a,b.textContent.trim(),b); });

/* tabs */
function setTab(t){ document.body.dataset.tab=t; $$('.seg [role=tab]').forEach(b=>b.setAttribute('aria-selected',String(b.dataset.tab===t))); if(t==='panel'){ badgeN=0; $('#badge').hidden=true; const st=$('.stage'); st.scrollTop=$('#pane-panel').offsetTop-12; } store.set('tab',t); }
$$('.seg [role=tab]').forEach(b=>b.addEventListener('click',()=>setTab(b.dataset.tab)));
function texts(){ const d=isDesk(); $('.pin-x').textContent=d?'Демо: подберите квартиру — лид появится в CRM':'Демо: лид появится в «Панели бизнеса»'; $('#hintT').textContent=d?'Нажмите «Подобрать квартиру» в чате — карточка лида справа начнёт заполняться.':'Пройдите подбор в чате — карточка лида ниже заполнится по вашим ответам.'; }
texts(); try{ matchMedia('(min-width:960px)').addEventListener('change',texts); }catch(e){}
$('#pinClose').addEventListener('click',()=>{ $('#pin').hidden=true; store.set('pin','0'); });
$('#pinGo').addEventListener('click',()=>msgs.scrollTo({top:0,behavior:RM?'auto':'smooth'}));
if(store.get('pin')==='0') $('#pin').hidden=true;
function tick(){ const d=now(); $('#sbTime').textContent=d.getHours()+':'+String(d.getMinutes()).padStart(2,'0'); }
setInterval(tick,10000);

function resetDemo(){ SID++; TM.forEach(clearTimeout); TM.clear(); Q=Promise.resolve(); t0=Date.now(); tick();
  msgs.innerHTML=''; lastDay=null; LB=[]; typingEl=null; hideTyping(); hideRKB(); setPh(''); closePops(); closeLayer(); pushEl.classList.remove('on');
  FAV=[]; store.del('fav'); resetState(); resetCRM(); Object.keys(FN).forEach(k=>delete FN[k]); renderFunnel(); badgeN=0; $('#badge').hidden=true; welcome(); msgs.scrollTop=0; }
$$('[data-reset]').forEach(b=>b.addEventListener('click',()=>{ closePops(); resetDemo(); if(!isDesk()) setTab('chat'); }));

/* init */
resetState(); resetCRM(); renderFunnel(); if(FAV.length) setF('fav',favHTML()); welcome(); tick();
if(store.get('tab')==='panel'&&!isDesk()) setTab('panel');
})();
</script>
