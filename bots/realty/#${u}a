  return {photo:()=>planSVG(fl),alt:`Планировка квартиры № ${fl.id}`,once:false,wide:true,
    html:`<b>${RN[fl.t]} · ${fa(fl.a)} м²</b><br>Дом ${fl.h}, ${fl.f} этаж из ${HOUSES[fl.h].fl} · <span class="tag${fl.v?' rv':''}">${fl.v?'🌊 вид на Каму':'окна во двор'}</span><div class="fx"><span class="pr">${rub(fl.p)}</span><span class="mo">в ипотеку от ${rub(fromPay(fl))}/мес</span></div><span class="cnt">Вариант ${S.ci+1} из ${n} · № ${fl.id}</span>`,
    kb:nav.concat([[{t:fav?'❤ В избранном':'♡ В избранное',cb:'fav',a:fl.id,on:fav},{t:'Подробнее',cb:'more',a:fl.id}],[{t:'📅 Записаться на просмотр',cb:'view',a:fl.id}]])}; }
