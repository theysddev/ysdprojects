function startTires(){ if(activeOrder()) return busy(); S.kind='tire'; S.plate=null; S.plateKnown=false; bot({photo:'tire',alt:'Комплект зимних шин',html:'🛞 <b>Сезонная замена шин</b> — снимем, перебортуем и отбалансируем 4 колеса. Перед зимой бесплатно проверим аккумулятор и антифриз.<br>Какой радиус дисков?',kb:TIRES.map((x,i)=>[{t:x[0]+' · '+rub(x[1]),cb:'tr',a:i,hl:i===1}])}); }
