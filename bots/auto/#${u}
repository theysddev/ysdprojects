/* ---------- text routing ---------- */
function route(raw){ const t=raw.trim(); const l=t.toLowerCase();
  const cmd={'/start':menu,'/to':startTO,'/status':askStatus,'/history':history,'/tires':startTires,'/contacts':contacts}[l.split(/\s|@/)[0]];
  if(cmd){ S.aw=null; hideRKB(); setPh(''); return cmd(); }
  if(/^(отмена|назад|меню|стоп)$/.test(l)){ S.aw=null; hideRKB(); setPh(''); return menu(); }
  if(S.aw==='km') return onKm(t);
  if(S.aw==='plate') return onPlate(t);
  if(S.aw==='splate') return onSPlate(t);
  if(S.aw==='make'){ if(/[a-zа-яё]{2,}/i.test(t)){ const name=t.replace(/\s+/g,' ').slice(0,28).replace(/(^|\s)(\S)/g,(m,a,b)=>a+b.toUpperCase()); if(S.kind!=='tire') S.kind='to'; return pickCar(name); } return bot({html:'Напишите марку и модель словами, например <b>Kia Rio</b>.'}); }
  const pl=parsePlate(t); if(pl) return lookupPlate(pl);
  if(/истор/.test(l)) return history();
  if(/(^|\s)то(-?\d)?($|\s)|техобслуж|обслуживан|масл|регламент/.test(l)) return startTO();
  if(/шин|резин|колёс|колес|переобу|шиномонтаж/.test(l)) return startTires();
  if(/статус|где машин|готова ли|как там/.test(l)) return askStatus();
  if(/адрес|где вы|контакт|добрат|проехать|телефон|часы|режим|работаете/.test(l)) return contacts();
  if(/цен|стоим|сколько/.test(l)) return bot({html:'Стоимость ТО считаю по марке и пробегу — работы и запчасти отдельными строками. Начнём?',kb:[[{t:'🔧 Посчитать ТО',cb:'to',hl:true}]]});
  if(/спасиб|благодар/.test(l)) return bot({html:'Пожалуйста! Обращайтесь 🙌'});
  if(/привет|здравств|добр(ый|ое)|салам/.test(l)) return menu();
  bot({html:'Я пока понимаю кнопки и простые запросы: «ТО», «шиномонтаж», «статус», «история», «адрес» или госномер. Выберите действие:',kb:mainKB(false),once:false});
}

