function showOwn(o){ const map={booked:-1,accepted:1,photos:1,approval:2,work2:3,ready:4,paid:4}; const st=map[o.stage];
  const txt={booked:`Записан на ${dayLong(o.visit).toLowerCase()}, ${hm(o.visit)}. Ждём вас на ул. Восстания, 74.`,accepted:'Машина на посту 2, идёт '+(o.kind==='to'?'ТО и осмотр.':'переобувка.'),photos:'Идёт осмотр, фотоотчёт уже отправлен.',approval:'Ждём ваше решение по передним колодкам — кнопки в сообщении выше.',work2:'Работы на посту 2 продолжаются.',ready:'Готово, ждёт на выдаче. К оплате '+rub(o.base+o.extra)+'.',paid:'Выдано и оплачено. Спасибо!'}[o.stage];
  bot({html:`<b>${esc(o.car)}</b>${o.plate?' · '+o.plate:''}<br><span class="mu">Заказ № ${o.id}</span>${st>=0?stepsHTML(st):'<br>'}${txt}`,wide:true}); }
CB.splate=(a,t)=>{ user(a); S.aw=null; setPh(''); lookupPlate(a); };
