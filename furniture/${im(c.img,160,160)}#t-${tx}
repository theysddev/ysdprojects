 topo(g.B).forEach(b=>{const f=faces(b);let cols,tex='';
  if(b.k==='l')cols=LC;else{const base=b.k==='p'?pc:b.k==='f'?mix(F.c,DK,.09):F.c;cols=[mix(base,'#ffffff',.14),base,mix(base,DK,.24)];tex=b.k==='p'?'lin':T==='vel'?'':T}
