 let o=`<g filter="url(#fblur)" opacity=".42">`+g.foot.map(r=>poly([[r[0]-1,r[1]-1,0],[r[2]+3,r[1]-1,0],[r[2]+3,r[3]+4,0],[r[0]-1,r[3]+4,0]],'#3a332b')).join('')+'</g>';
