function faces(b){const tx=b.tx||0,ty=b.ty||0,tp=b.tp||0;const ax0=b.x0+Math.max(0,-tx),ax1=b.x1-Math.max(0,tx),ay1=b.y1-ty;const bx0=b.x0+tp,bx1=b.x1-tp,by0=b.y0+tp,by1=b.y1-tp;const z0=b.z0,z1=b.z1;
 return{r:[[bx1,by0,z0],[bx1,by1,z0],[ax1,ay1,z1],[ax1,b.y0,z1]],t:[[ax0,b.y0,z1],[ax1,b.y0,z1],[ax1,ay1,z1],[ax0,ay1,z1]],f:[[bx0,by1,z0],[bx1,by1,z0],[ax1,ay1,z1],[ax0,ay1,z1]]}}
