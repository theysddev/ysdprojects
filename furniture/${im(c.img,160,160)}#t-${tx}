function topo(B){const n=B.length,bb=B.map(b=>{let r=[1e9,-1e9,1e9,-1e9];[b.x0,b.x1].forEach(X=>[b.y0,b.y1].forEach(Y=>[b.z0,b.z1].forEach(Z=>{const[s,t]=pj(X,Y,Z);r=[Math.min(r[0],s),Math.max(r[1],s),Math.min(r[2],t),Math.max(r[3],t)]})));return r});
 const ind=new Array(n).fill(0),adj=B.map(()=>[]);
 for(let i=0;i<n;i++)for(let j=i+1;j<n;j++){const A=bb[i],C=bb[j];if(A[0]<C[1]-.05&&C[0]<A[1]-.05&&A[2]<C[3]-.05&&C[2]<A[3]-.05){if(before(B[i],B[j])){adj[i].push(j);ind[j]++}else{adj[j].push(i);ind[i]++}}}
 const q=[],out=[],done=new Array(n).fill(false);for(let i=0;i<n;i++)if(!ind[i])q.push(i);
 while(q.length){const i=q.shift();done[i]=true;out.push(B[i]);adj[i].forEach(j=>{if(--ind[j]===0)q.push(j)})}
 B.forEach((b,i)=>{if(!done[i])out.push(b)});return out}
function sofaSVG(s,pxu){
